---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  ogImage?: string;
  ogType?: 'website' | 'article';
}
const { title, description, noindex, schema, ogImage, ogType } = Astro.props;
---

<Base
  title={title}
  description={description}
  noindex={noindex}
  schema={schema}
  ogImage={ogImage}
  ogType={ogType}
>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <MobileBar />
</Base>
