---
import Base from './Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex } = Astro.props;
---

<Base title={title} description={description} noindex={noindex}>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <MobileBar />
</Base>
