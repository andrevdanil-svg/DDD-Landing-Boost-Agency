---
// ПРОТОТИП: копия интерфейса кабинета на демонстрационных данных.
// В проде — реальные скриншоты / записанное демо кабинета.
const steps = [
  { id: 'overview', title: 'Обзор', text: 'Показы, клики, CTR, CPM, CPC и ROAS по каждой кампании\u00a0— на одном экране, по дням и часам.' },
  { id: 'audience', title: 'Аудитория', text: 'Разрез по устройствам, возрасту и полу: видно, кто на самом деле видит рекламу.' },
  { id: 'creatives', title: 'Креативы', text: 'Статистика по каждому креативу\u00a0— что работает, а что пора заменить.' },
  { id: 'export', title: 'Выгрузка', text: 'Любой срез\u00a0— в CSV или XLSX в один клик. Без запроса менеджеру.' },
];

const kpis = [
  { l: 'Показы', v: '4,58M', d: '+18,4%', up: true },
  { l: 'Клики', v: '61,2K', d: '+11,2%', up: true },
  { l: 'CTR', v: '1,34%', d: '−0,08 п.п.', up: false },
  { l: 'ROAS', v: '×3,1', d: '+0,82', up: true },
];

let s = 3;
const r = () => (s = (s * 16807) % 2147483647) / 2147483647;
const pts = Array.from({ length: 30 }, (_, i) => 40 + i * 1.5 + Math.sin(i / 2.1) * 8 + r() * 7);
const W = 600;
const H = 180;
const top = Math.max(...pts) * 1.12;
const xy = pts.map((p, i) => [(i / (pts.length - 1)) * W, H - (p / top) * H]);
const line = xy.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const area = `${line} L${W} ${H} L0 ${H} Z`;

const devices: [string, number][] = [['Смартфон', 71], ['Десктоп', 19], ['Smart TV', 7], ['Планшет', 3]];
const ages: [string, number, number][] = [['18–24', 14, 11], ['25–34', 31, 24], ['35–44', 22, 19], ['45–54', 12, 10], ['55+', 6, 5]];

const creatives = [
  { name: 'Весна · 300×250', ctr: '2,41%', tag: 'Лидер', tone: 'good', kind: 'square' },
  { name: 'Весна · 728×90', ctr: '0,92%', tag: 'В норме', tone: 'neutral', kind: 'wide' },
  { name: 'Видео · 15 сек', ctr: '0,37%', tag: 'Заменить', tone: 'bad', kind: 'video' },
];

const rows = [
  ['24.04', '162 418', '2 207', '1,36%', '$412'],
  ['25.04', '171 903', '2 318', '1,35%', '$436'],
  ['26.04', '158 220', '2 051', '1,30%', '$401'],
  ['27.04', '149 774', '2 093', '1,40%', '$388'],
  ['28.04', '176 512', '2 401', '1,36%', '$447'],
  ['29.04', '183 065', '2 512', '1,37%', '$461'],
];
---

<section class="pl" id="platform" aria-labelledby="pl-title">
  <div class="wrap pl__head">
    <span class="path">/platform</span>
    <h2 id="pl-title" class="h2">Кабинет, в&nbsp;котором видно каждый показ</h2>
    <p class="pl__sub">
      Каждая метрика, которую видим мы, доступна вам&nbsp;— в&nbsp;том&nbsp;же кабинете и&nbsp;в&nbsp;том&nbsp;же разрезе.
    </p>
  </div>

  <div class="pl__stage" data-stage>
    <div class="wrap pl__sticky">
      <div class="pl__nav">
        <div class="pl__steps" role="tablist" aria-label="Разделы кабинета">
          {
            steps.map((st, i) => (
              <button
                class="pl__step"
                type="button"
                role="tab"
                id={`tab-${st.id}`}
                aria-controls={`view-${st.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-step
              >
                <span class="pl__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="pl__title">{st.title}</span>
                <span class="pl__text">{st.text}</span>
                <span class="pl__bar" aria-hidden="true"><i /></span>
              </button>
            ))
          }
        </div>
        <p class="pl__mtext" aria-hidden="true" data-mtext>{steps[0].text}</p>
      </div>

      <div class="app">
        <div class="app__bar">
          <svg viewBox="0 0 16 16" width="12" height="12" fill="none" aria-hidden="true">
            <rect x="3" y="7" width="10" height="7" rx="1.5" stroke="currentColor" stroke-width="1.4"></rect>
            <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" stroke="currentColor" stroke-width="1.4"></path>
          </svg>
          <span class="app__url">platform.boostagency.uz/reporting</span>
          <span class="app__demo">демо-данные</span>
        </div>

        <div class="app__body">
          <aside class="app__side" aria-hidden="true">
            <img src="/brand/logo_boost_mark.svg" alt="" width="22" height="22" />
            <span><i></i>Кампании</span>
            <span class="is-on"><i></i>Отчёты</span>
            <span><i></i>Креативы</span>
            <span><i></i>A/B сравнение</span>
            <span><i></i>Алерты</span>
          </aside>

          <div class="app__main">
            <!-- Обзор -->
            <div class="view" id="view-overview" role="tabpanel" aria-labelledby="tab-overview" data-view data-active>
              <div class="v-head">
                <div><b>Весна-2026 · Ритейл</b><span>1–30 апреля</span></div>
                <span class="chip">Все каналы</span>
              </div>
              <div class="kpis">
                {
                  kpis.map((k) => (
                    <div class="kpi">
                      <span>{k.l}</span>
                      <b>{k.v}</b>
                      <em class:list={[k.up ? 'up' : 'down']}>{k.d}</em>
                    </div>
                  ))
                }
              </div>
              <div class="chart">
                <div class="chart__head"><span>Показы по дням</span><span class="chart__lg"><i></i>апрель</span></div>
                <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
                  <defs>
                    <linearGradient id="pl-fill" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0" stop-color="#655bfa" stop-opacity="0.32"></stop>
                      <stop offset="1" stop-color="#655bfa" stop-opacity="0"></stop>
                    </linearGradient>
                  </defs>
                  {[0.25, 0.5, 0.75].map((g) => <line x1="0" x2={W} y1={H * g} y2={H * g} class="grid" />)}
                  <path d={area} fill="url(#pl-fill)"></path>
                  <path d={line} class="stroke"></path>
                </svg>
              </div>
            </div>

            <!-- Аудитория -->
            <div class="view" id="view-audience" role="tabpanel" aria-labelledby="tab-audience" data-view>
              <div class="v-head">
                <div><b>Аудитория</b><span>Весна-2026 · 1–30 апреля</span></div>
                <span class="chip">Показы</span>
              </div>
              <div class="aud">
                <div class="panel">
                  <h3>Устройства</h3>
                  {
                    devices.map(([name, v]) => (
                      <div class="hbar">
                        <span>{name}</span>
                        <div class="hbar__track"><i style={`--v:${v}%`} /></div>
                        <b>{v}%</b>
                      </div>
                    ))
                  }
                </div>
                <div class="panel">
                  <h3>Возраст и пол</h3>
                  <div class="vbars">
                    {
                      ages.map(([a, m, f]) => (
                        <div class="vbar">
                          <div class="vbar__cols">
                            <i class="m" style={`--v:${m * 3}%`} />
                            <i class="f" style={`--v:${f * 3}%`} />
                          </div>
                          <span>{a}</span>
                        </div>
                      ))
                    }
                  </div>
                  <div class="legend"><span><i class="m"></i>Мужчины</span><span><i class="f"></i>Женщины</span></div>
                </div>
              </div>
            </div>

            <!-- Креативы -->
            <div class="view" id="view-creatives" role="tabpanel" aria-labelledby="tab-creatives" data-view>
              <div class="v-head">
                <div><b>Креативы</b><span>Весна-2026 · по CTR</span></div>
                <span class="chip">3 активных</span>
              </div>
              <div class="cr">
                {
                  creatives.map((c) => (
                    <div class="cr__card">
                      <div class:list={['cr__thumb', `cr__thumb--${c.kind}`]}>
                        <i />
                        <i />
                      </div>
                      <div class="cr__meta">
                        <b>{c.name}</b>
                        <span>CTR {c.ctr}</span>
                      </div>
                      <span class:list={['tag', `tag--${c.tone}`]}>{c.tag}</span>
                    </div>
                  ))
                }
              </div>
            </div>

            <!-- Выгрузка -->
            <div class="view" id="view-export" role="tabpanel" aria-labelledby="tab-export" data-view>
              <div class="v-head">
                <div><b>Отчёт по дням</b><span>Весна-2026 · все каналы</span></div>
                <span class="chip chip--accent">Выгрузить XLSX</span>
              </div>
              <table class="tbl">
                <thead><tr><th>Дата</th><th>Показы</th><th>Клики</th><th>CTR</th><th>Расход</th></tr></thead>
                <tbody>{rows.map((row) => <tr>{row.map((c) => <td>{c}</td>)}</tr>)}</tbody>
              </table>
              <div class="toast"><i>✓</i> report_apr.xlsx готов · 42 КБ</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pl {
    border-top: 1px solid var(--line);
    padding-top: clamp(96px, 16vh, 180px);
    padding-bottom: clamp(48px, 8vh, 96px);
  }

  .pl__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 24px;
    margin-bottom: clamp(40px, 8vh, 80px);
  }
  .pl__head .path { grid-column: 1 / -1; }
  .pl__head .h2 { grid-column: 1 / span 8; }
  .pl__sub { grid-column: 9 / -1; align-self: end; color: var(--text-2); max-width: 36ch; }

  /* ── шаги ── */
  .pl__steps { display: grid; gap: 2px; }
  .pl__step {
    position: relative;
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    padding: 18px 0 18px 22px;
    text-align: left;
    opacity: 0.42;
    transition: opacity 0.35s var(--ease);
  }
  .pl__step:hover, .pl__step[aria-selected='true'] { opacity: 1; }
  .pl__num { font: 500 12px/1.9 var(--f-mono); color: var(--text-3); }
  .pl__title { font: 600 22px/1.25 var(--f-display); letter-spacing: -0.015em; }
  .pl__text {
    grid-column: 2;
    max-height: 0;
    overflow: hidden;
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.5;
    transition: max-height 0.45s var(--ease), margin 0.45s var(--ease);
  }
  .pl__step[aria-selected='true'] .pl__text { max-height: 7em; margin-top: 8px; }
  .pl__bar {
    position: absolute;
    left: 0; top: 18px; bottom: 18px;
    width: 2px;
    background: var(--line-strong);
  }
  .pl__bar i {
    display: block;
    width: 100%;
    height: calc(var(--p, 0) * 100%);
    background: var(--accent);
  }
  .pl__step[data-done] .pl__bar i { --p: 1; }
  .pl__step[aria-selected='true'] .pl__bar i { --p: var(--step-progress, 1); }
  .pl__mtext { display: none; }

  /* ── окно кабинета ── */
  .app {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 600px;
    border: 1px solid var(--line-strong);
    border-radius: 16px;
    background: var(--bg-app);
    overflow: hidden;
    box-shadow: 0 40px 120px -48px rgb(0 0 0 / 0.9);
    font-size: 13px;
    line-height: 1.4;
  }
  .app__bar {
    flex: none;
    height: 40px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    border-bottom: 1px solid var(--line);
    font: 400 12px/1 var(--f-mono);
    color: var(--text-3);
  }
  .app__url { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .app__demo {
    flex: none;
    white-space: nowrap;
    margin-left: auto;
    padding: 4px 8px;
    border: 1px dashed var(--line-strong);
    border-radius: 6px;
  }
  .app__body { flex: 1; min-height: 0; display: grid; grid-template-columns: 184px minmax(0, 1fr); }
  .app__side {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 10px;
    border-right: 1px solid var(--line);
    color: var(--text-2);
  }
  .app__side img { margin: 2px 8px 18px; }
  .app__side span { display: flex; align-items: center; gap: 10px; padding: 8px 10px; border-radius: 8px; }
  .app__side i { width: 6px; height: 6px; border-radius: 2px; background: currentColor; opacity: 0.5; }
  .app__side .is-on { background: rgb(255 255 255 / 0.05); color: var(--text); }
  .app__side .is-on i { background: var(--accent); opacity: 1; }

  .app__main { position: relative; min-height: 0; }
  .view {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 20px 22px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease), visibility 0s linear 0.45s;
  }
  .view[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .v-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .v-head div { display: grid; gap: 2px; }
  .v-head b { font: 600 15px/1.2 var(--f-display); }
  .v-head div span { color: var(--text-3); font-size: 12px; }
  .chip {
    flex: none;
    padding: 7px 11px;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    color: var(--text-2);
    font-size: 12px;
  }
  .chip--accent { background: var(--accent); border-color: var(--accent); color: #fff; }

  .kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .kpi { display: grid; gap: 6px; padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; }
  .kpi span { color: var(--text-3); font-size: 12px; }
  .kpi b { font: 700 22px/1 var(--f-display); letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .kpi em { font: 500 11.5px/1 var(--f-mono); font-style: normal; }
  .up { color: var(--green); }
  .down { color: var(--coral); }

  .chart {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .chart__head { display: flex; justify-content: space-between; color: var(--text-3); font-size: 12px; }
  .chart__lg { display: inline-flex; align-items: center; gap: 6px; }
  .chart__lg i { width: 10px; height: 2px; background: var(--accent); }
  .chart svg { flex: 1; width: 100%; min-height: 110px; }
  .chart .grid { stroke: var(--line); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .chart .stroke { fill: none; stroke: var(--accent); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; }

  .aud { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .panel { display: flex; flex-direction: column; gap: 14px; padding: 14px; border: 1px solid var(--line); border-radius: 10px; min-height: 0; }
  .panel h3 { font: 600 13px/1.2 var(--f-text); color: var(--text-2); }
  .hbar { display: grid; grid-template-columns: 76px minmax(0, 1fr) 36px; align-items: center; gap: 10px; }
  .hbar span { color: var(--text-2); }
  .hbar b { text-align: right; font: 500 12px/1 var(--f-mono); }
  .hbar__track { height: 8px; border-radius: 4px; background: rgb(255 255 255 / 0.05); }
  .hbar__track i { display: block; height: 100%; width: var(--v); border-radius: 4px; background: var(--accent); }
  .vbars { flex: 1; min-height: 90px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .vbar { display: flex; flex-direction: column; gap: 8px; min-height: 0; }
  .vbar__cols { flex: 1; display: flex; align-items: flex-end; justify-content: center; gap: 3px; }
  .vbar__cols i { width: 10px; height: var(--v); border-radius: 3px 3px 0 0; }
  .vbar span { text-align: center; color: var(--text-3); font: 400 11px/1 var(--f-mono); }
  .m { background: var(--accent); }
  .f { background: var(--coral); }
  .legend { display: flex; gap: 14px; color: var(--text-3); font-size: 12px; }
  .legend span { display: inline-flex; align-items: center; gap: 6px; }
  .legend i { width: 8px; height: 8px; border-radius: 2px; }

  .cr { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; align-content: start; }
  .cr__card { display: grid; gap: 10px; padding: 10px; border: 1px solid var(--line); border-radius: 10px; }
  .cr__thumb { position: relative; aspect-ratio: 4 / 3; border-radius: 6px; overflow: hidden; background: #191924; }
  .cr__thumb i { position: absolute; display: block; }
  .cr__thumb--square { background: var(--accent); }
  .cr__thumb--square i:first-child { left: 12%; top: 16%; width: 54%; height: 14%; background: #fff; border-radius: 3px; }
  .cr__thumb--square i:last-child { left: 12%; bottom: 14%; width: 34%; height: 16%; background: #0a0a10; border-radius: 4px; }
  .cr__thumb--wide i:first-child { left: 0; right: 0; top: 38%; height: 24%; background: #24243a; }
  .cr__thumb--wide i:last-child { right: 8%; top: 43%; width: 18%; height: 14%; background: var(--coral); border-radius: 3px; }
  .cr__thumb--video { background: linear-gradient(160deg, #23233a, #121219); }
  .cr__thumb--video i:first-child { left: 50%; top: 50%; translate: -40% -50%; border-left: 16px solid rgb(255 255 255 / 0.85); border-block: 10px solid transparent; }
  .cr__thumb--video i:last-child { left: 8%; right: 8%; bottom: 10%; height: 3px; background: linear-gradient(90deg, #fff 30%, rgb(255 255 255 / 0.2) 30%); }
  .cr__meta { display: grid; gap: 2px; }
  .cr__meta b { font-weight: 500; }
  .cr__meta span { color: var(--text-3); font: 400 12px/1.3 var(--f-mono); }
  .tag { justify-self: start; padding: 4px 8px; border-radius: 6px; font: 500 11px/1 var(--f-mono); }
  .tag--good { color: var(--green); background: rgb(62 207 142 / 0.12); }
  .tag--neutral { color: var(--text-2); background: rgb(255 255 255 / 0.06); }
  .tag--bad { color: var(--coral); background: rgb(255 138 91 / 0.12); }

  .tbl { width: 100%; border-collapse: collapse; font: 400 12.5px/1 var(--f-mono); font-variant-numeric: tabular-nums; }
  .tbl th { padding: 0 8px 10px; text-align: right; color: var(--text-3); font-weight: 400; border-bottom: 1px solid var(--line); }
  .tbl td { padding: 11px 8px; text-align: right; border-bottom: 1px solid var(--line); }
  .tbl th:first-child, .tbl td:first-child { text-align: left; padding-left: 0; }
  .toast {
    align-self: flex-end;
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--bg-raised);
    font-size: 12.5px;
  }
  .toast i { color: var(--green); font-style: normal; }

  /* ── десктоп: прокрутка листает разделы ── */
  @media (min-width: 1001px) {
    .pl__stage { height: 300vh; }
    .pl__sticky {
      position: sticky;
      top: calc(var(--header-h) + 24px);
      height: calc(100svh - var(--header-h) - 48px);
      display: grid;
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 56px;
      align-items: center;
    }
    .app { height: min(620px, 100%); }
  }

  /* ── планшет и телефон: обычные вкладки ── */
  @media (max-width: 1000px) {
    .pl__head .h2, .pl__sub { grid-column: 1 / -1; }
    .pl__nav { margin-bottom: 16px; }
    .pl__steps {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--pad) * -1);
      padding-inline: var(--pad);
    }
    .pl__steps::-webkit-scrollbar { display: none; }
    .pl__step {
      flex: none;
      display: block;
      padding: 10px 16px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      opacity: 1;
    }
    .pl__step[aria-selected='true'] { background: var(--text); color: var(--bg); border-color: var(--text); }
    .pl__num, .pl__text, .pl__bar { display: none; }
    .pl__title { font-size: 15px; }
    /* высота под самую длинную подпись (3 строки), чтобы кабинет не прыгал при смене вкладки */
    .pl__mtext { display: block; margin-top: 14px; color: var(--text-2); font-size: 16px; line-height: 1.55; min-height: 4.65em; }
  }

  @media (max-width: 640px) {
    .app { height: 500px; }
    .app__body { grid-template-columns: minmax(0, 1fr); }
    .app__side { display: none; }
    .view { padding: 14px; }
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .aud { grid-template-columns: minmax(0, 1fr); }
    .cr { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cr__card:nth-child(3) { display: none; }
    .tbl th:nth-child(4), .tbl td:nth-child(4) { display: none; }
  }
</style>

<script>
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const steps = [...document.querySelectorAll<HTMLButtonElement>('[data-step]')];
  const views = [...document.querySelectorAll<HTMLElement>('[data-view]')];
  const mtext = document.querySelector<HTMLElement>('[data-mtext]');
  const desktop = window.matchMedia('(min-width: 1001px)');
  let active = -1;

  const setActive = (i: number) => {
    if (i === active) return;
    active = i;
    steps.forEach((s, k) => {
      s.setAttribute('aria-selected', String(k === i));
      s.toggleAttribute('data-done', k < i);
      s.tabIndex = k === i ? 0 : -1;
    });
    views.forEach((v, k) => v.toggleAttribute('data-active', k === i));
    if (mtext) mtext.textContent = steps[i].querySelector('.pl__text')?.textContent ?? '';
  };

  const onScroll = () => {
    if (!stage || !desktop.matches) return;
    const rect = stage.getBoundingClientRect();
    const total = rect.height - window.innerHeight;
    const p = Math.min(0.9999, Math.max(0, -rect.top / total));
    const i = Math.floor(p * steps.length);
    stage.style.setProperty('--step-progress', String(p * steps.length - i));
    setActive(i);
  };

  steps.forEach((step, k) => {
    step.addEventListener('click', () => {
      if (stage && desktop.matches) {
        const rect = stage.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const y = window.scrollY + rect.top + (total * (k + 0.02)) / steps.length;
        window.scrollTo({ top: y, behavior: 'smooth' });
      } else {
        setActive(k);
      }
    });
    step.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = (k + (e.key === 'ArrowRight' ? 1 : -1) + steps.length) % steps.length;
      steps[next].focus();
      steps[next].click();
    });
  });

  setActive(0);
  window.addEventListener('scroll', onScroll, { passive: true });
  desktop.addEventListener('change', onScroll);
  onScroll();
</script>
