---
// ПРОТОТИП: копия интерфейса кабинета на демонстрационных данных.
// В проде — реальные скриншоты / записанное демо кабинета.
const steps = [
  { id: 'overview', title: 'Обзор', text: 'Показы, клики, CTR, CPM, CPC и ROAS по каждой кампании — на одном экране, по дням и часам.' },
  { id: 'audience', title: 'Аудитория', text: 'Разрез по устройствам, возрасту и полу: видно, кто на самом деле видит рекламу.' },
  { id: 'creatives', title: 'Креативы', text: 'Статистика по каждому креативу — что работает, а что пора заменить.' },
  { id: 'export', title: 'Выгрузка', text: 'Любой срез — в CSV или XLSX в один клик. Без запроса менеджеру.' },
];

const kpis = [
  { l: 'Показы', v: '4,58M', d: '+18,4%', up: true },
  { l: 'Клики', v: '61,2K', d: '+11,2%', up: true },
  { l: 'CTR', v: '1,34%', d: '−0,08 п.п.', up: false },
  { l: 'ROAS', v: '×3,1', d: '+0,82', up: true },
];

let s = 3;
const r = () => (s = (s * 16807) % 2147483647) / 2147483647;
const pts = Array.from({ length: 30 }, (_, i) => 40 + i * 1.5 + Math.sin(i / 2.1) * 8 + r() * 7);
const W = 600;
const H = 180;
const top = Math.max(...pts) * 1.12;
const xy = pts.map((p, i) => [(i / (pts.length - 1)) * W, H - (p / top) * H]);
const line = xy.map(([x, y], i) => `${i ? 'L' : 'M'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const area = `${line} L${W} ${H} L0 ${H} Z`;

const devices: [string, number][] = [['Смартфон', 71], ['Десктоп', 19], ['Smart TV', 7], ['Планшет', 3]];
const ages: [string, number, number][] = [['18–24', 14, 11], ['25–34', 31, 24], ['35–44', 22, 19], ['45–54', 12, 10], ['55+', 6, 5]];

const creatives = [
  { name: 'Весна, 300×250', ctr: '2,41%', tag: 'Лидер', tone: 'good', kind: 'square' },
  { name: 'Весна, 728×90', ctr: '0,92%', tag: 'В норме', tone: 'neutral', kind: 'wide' },
  { name: 'Видео, 15 сек', ctr: '0,37%', tag: 'Заменить', tone: 'bad', kind: 'video' },
];

const rows = [
  ['24 апр', '162 418', '2 207', '1,36%', '$412'],
  ['25 апр', '171 903', '2 318', '1,35%', '$436'],
  ['26 апр', '158 220', '2 051', '1,30%', '$401'],
  ['27 апр', '149 774', '2 093', '1,40%', '$388'],
  ['28 апр', '176 512', '2 401', '1,36%', '$447'],
  ['29 апр', '183 065', '2 512', '1,37%', '$461'],
];

const nav = ['Кампании', 'Отчёты', 'Креативы', 'A/B сравнение', 'Алерты'];
---

<section class="pl" id="platform" aria-labelledby="pl-title" data-pl>
  <div class="wrap">
    <h2 id="pl-title" class="h2 pl__h">Кабинет, в&nbsp;котором видно каждый показ</h2>

    <!-- вкладки переключаются сами, пока блок на экране; клик — ручной режим -->
    <div class="pl__body">
      <div class="pl__nav">
        <p class="pl__sub">
          Каждая метрика, которую видим мы, доступна вам&nbsp;— в&nbsp;том&nbsp;же кабинете и&nbsp;в&nbsp;том&nbsp;же
          разрезе.
        </p>
        <div class="pl__steps" role="tablist" aria-label="Разделы кабинета">
          {
            steps.map((st, i) => (
              <button
                class="pl__step"
                type="button"
                role="tab"
                id={`tab-${st.id}`}
                aria-controls={`view-${st.id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                data-step
              >
                <span class="pl__title">{st.title}</span>
                <span class="pl__text">{st.text}</span>
                <span class="pl__bar" aria-hidden="true"><i /></span>
              </button>
            ))
          }
        </div>
        <p class="pl__mtext" aria-hidden="true" data-mtext>{steps[0].text}</p>
      </div>

      <div class="app">
        <nav class="app__side" aria-hidden="true">
          {nav.map((n) => <span class:list={[{ 'is-on': n === 'Отчёты' }]}>{n}</span>)}
        </nav>

        <div class="app__main">
          <!-- Обзор -->
          <div class="view" id="view-overview" role="tabpanel" aria-labelledby="tab-overview" data-view data-active>
            <div class="v-head">
              <div><b>Весна-2026, ритейл</b><span>1–30 апреля</span></div>
              <span class="v-filter">Все каналы <i></i></span>
            </div>
            <div class="kpis">
              {
                kpis.map((k) => (
                  <div class="kpi">
                    <span>{k.l}</span>
                    <b>{k.v}</b>
                    <em class:list={[k.up ? 'up' : 'down']}>{k.d}</em>
                  </div>
                ))
              }
            </div>
            <div class="chart">
              <div class="chart__head"><span>Показы по дням</span></div>
              <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="pl-fill" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#655bfa" stop-opacity="0.3"></stop>
                    <stop offset="1" stop-color="#655bfa" stop-opacity="0"></stop>
                  </linearGradient>
                </defs>
                {[0.25, 0.5, 0.75].map((g) => <line x1="0" x2={W} y1={H * g} y2={H * g} class="grid" />)}
                <path d={area} fill="url(#pl-fill)"></path>
                <path d={line} class="stroke"></path>
              </svg>
            </div>
          </div>

          <!-- Аудитория -->
          <div class="view" id="view-audience" role="tabpanel" aria-labelledby="tab-audience" data-view>
            <div class="v-head">
              <div><b>Аудитория</b><span>Весна-2026, 1–30 апреля</span></div>
              <span class="v-filter">По показам <i></i></span>
            </div>
            <div class="aud">
              <div class="aud__col">
                <h3>Устройства</h3>
                {
                  devices.map(([name, v]) => (
                    <div class="hbar">
                      <span>{name}</span>
                      <div class="hbar__track"><i style={`--v:${v}%`} /></div>
                      <b>{v}%</b>
                    </div>
                  ))
                }
              </div>
              <div class="aud__col">
                <h3>Возраст и пол</h3>
                <div class="vbars">
                  {
                    ages.map(([a, m, f]) => (
                      <div class="vbar">
                        <div class="vbar__cols">
                          <i class="m" style={`--v:${m * 3}%`} />
                          <i class="f" style={`--v:${f * 3}%`} />
                        </div>
                        <span>{a}</span>
                      </div>
                    ))
                  }
                </div>
                <div class="legend"><span><i class="m"></i>Мужчины</span><span><i class="f"></i>Женщины</span></div>
              </div>
            </div>
          </div>

          <!-- Креативы -->
          <div class="view" id="view-creatives" role="tabpanel" aria-labelledby="tab-creatives" data-view>
            <div class="v-head">
              <div><b>Креативы</b><span>Весна-2026, по CTR</span></div>
              <span class="v-filter">Активные <i></i></span>
            </div>
            <div class="cr">
              {
                creatives.map((c) => (
                  <div class="cr__item">
                    <div class:list={['cr__thumb', `cr__thumb--${c.kind}`]}>
                      <i />
                      <i />
                    </div>
                    <b>{c.name}</b>
                    <span class="cr__ctr">CTR {c.ctr}</span>
                    <span class:list={['cr__status', `cr__status--${c.tone}`]}>{c.tag}</span>
                  </div>
                ))
              }
            </div>
          </div>

          <!-- Выгрузка -->
          <div class="view" id="view-export" role="tabpanel" aria-labelledby="tab-export" data-view>
            <div class="v-head">
              <div><b>Отчёт по дням</b><span>Весна-2026, все каналы</span></div>
              <span class="v-btn">Выгрузить XLSX</span>
            </div>
            <table class="tbl">
              <thead><tr><th>Дата</th><th>Показы</th><th>Клики</th><th>CTR</th><th>Расход</th></tr></thead>
              <tbody>{rows.map((row) => <tr>{row.map((c) => <td>{c}</td>)}</tr>)}</tbody>
            </table>
            <p class="done"><i>✓</i> Файл report_april.xlsx скачан</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .pl { border-top: 1px solid var(--line); padding-block: var(--sec-y); }
  /* заголовок в одну строку, чтобы кабинету хватило высоты экрана */
  .pl__h { font-size: clamp(30px, min(3.6vw, 6.4vh), 60px); margin-bottom: var(--head-gap); }
  .pl__body {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: clamp(32px, 4vw, 56px);
    align-items: center;
  }
  .pl__sub { color: var(--text-2); max-width: 36ch; margin-bottom: clamp(12px, 3vh, 28px); }

  /* ── шаги ── */
  .pl__steps { display: grid; gap: 2px; }
  .pl__step {
    position: relative;
    display: grid;
    padding: clamp(10px, 1.8vh, 18px) 0 clamp(10px, 1.8vh, 18px) 22px;
    text-align: left;
    opacity: 0.42;
    transition: opacity 0.35s var(--ease);
  }
  .pl__step:hover, .pl__step[aria-selected='true'] { opacity: 1; }
  .pl__title { font: 600 22px/1.25 var(--f-display); letter-spacing: -0.015em; }
  .pl__text {
    max-height: 0;
    overflow: hidden;
    color: var(--text-2);
    font-size: 16px;
    line-height: 1.5;
    transition: max-height 0.45s var(--ease), margin 0.45s var(--ease);
  }
  .pl__step[aria-selected='true'] .pl__text { max-height: 7em; margin-top: 8px; }
  .pl__bar {
    position: absolute;
    left: 0; top: 14px; bottom: 14px;
    width: 2px;
    background: var(--line-strong);
  }
  .pl__bar i {
    display: block;
    width: 100%;
    height: 0;
    background: var(--accent);
  }
  .pl__step[data-done] .pl__bar i, .pl__step[aria-selected='true'] .pl__bar i { height: 100%; }
  /* автопереключение: полоска заполняется за время показа вкладки */
  .pl[data-auto] .pl__step[aria-selected='true'] .pl__bar i { animation: pl-fill var(--pl-dur, 6s) linear both; }
  @keyframes pl-fill { from { height: 0; } }
  .pl__mtext { display: none; }

  /* ── кабинет: та же типографика, что у сайта — без рамок-карточек и служебных плашек ── */
  .app {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    min-width: 0;
    /* высота экрана минус шапка, отступы блока и заголовок */
    height: clamp(380px, calc(100svh - var(--header-h) - 2 * var(--sec-y) - var(--head-gap) - 7vh), 620px);
    border: 1px solid var(--line-strong);
    border-radius: 20px;
    background: var(--bg-app);
    overflow: hidden;
    box-shadow: 0 40px 120px -48px rgb(0 0 0 / 0.9);
    font-size: 15px;
    line-height: 1.4;
  }

  .app__side {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 28px 14px;
    border-right: 1px solid var(--line);
    color: var(--text-2);
  }
  .app__side span { padding: 10px 14px; border-radius: 10px; }
  .app__side .is-on { background: rgb(255 255 255 / 0.06); color: var(--text); }

  .app__main { position: relative; min-height: 0; }
  .view {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 28px 32px;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: opacity 0.45s var(--ease), transform 0.45s var(--ease), visibility 0s linear 0.45s;
  }
  .view[data-active] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .v-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .v-head div { display: grid; gap: 4px; }
  .v-head b { font: 600 20px/1.2 var(--f-display); letter-spacing: -0.015em; }
  .v-head div span { color: var(--text-2); font-size: 15px; }
  .v-filter { display: inline-flex; align-items: center; gap: 8px; color: var(--text-2); white-space: nowrap; }
  .v-filter i {
    width: 7px; height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
  }
  .v-btn {
    flex: none;
    padding: 9px 14px;
    border-radius: 10px;
    background: var(--accent);
    color: #fff;
    font: 600 14px/1.2 var(--f-display);
  }

  /* метрики — колонками через тонкие линии, без карточек */
  .kpis {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }
  .kpi { display: grid; gap: 4px; padding: 18px 20px; }
  .kpi:first-child { padding-left: 0; }
  .kpi + .kpi { border-left: 1px solid var(--line); }
  .kpi span { color: var(--text-2); font-size: 15px; }
  .kpi b { font: 700 30px/1.1 var(--f-display); letter-spacing: -0.025em; font-variant-numeric: tabular-nums; }
  .kpi em { font-style: normal; font-size: 14px; font-variant-numeric: tabular-nums; }
  .up { color: var(--green); }
  .down { color: var(--coral); }

  .chart { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 12px; }
  .chart__head { color: var(--text-2); }
  .chart svg { flex: 1; width: 100%; min-height: 110px; }
  .chart .grid { stroke: var(--line); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .chart .stroke { fill: none; stroke: var(--accent); stroke-width: 2.5; vector-effect: non-scaling-stroke; stroke-linejoin: round; }

  .aud { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 40px; }
  .aud__col { display: flex; flex-direction: column; gap: 18px; min-height: 0; }
  .aud__col h3 { font: 600 17px/1.2 var(--f-display); }
  .hbar { display: grid; grid-template-columns: 92px minmax(0, 1fr) 42px; align-items: center; gap: 12px; }
  .hbar span { color: var(--text-2); }
  .hbar b { text-align: right; font-weight: 500; font-variant-numeric: tabular-nums; }
  .hbar__track { height: 8px; border-radius: 4px; background: rgb(255 255 255 / 0.06); }
  .hbar__track i { display: block; height: 100%; width: var(--v); border-radius: 4px; background: var(--accent); }
  .vbars { flex: 1; min-height: 100px; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
  .vbar { display: flex; flex-direction: column; gap: 10px; min-height: 0; }
  .vbar__cols { flex: 1; display: flex; align-items: flex-end; justify-content: center; gap: 4px; }
  .vbar__cols i { width: 12px; height: var(--v); border-radius: 3px 3px 0 0; }
  .vbar span { text-align: center; color: var(--text-2); font-size: 13px; }
  .m { background: var(--accent); }
  .f { background: var(--coral); }
  .legend { display: flex; gap: 18px; color: var(--text-2); font-size: 14px; }
  .legend span { display: inline-flex; align-items: center; gap: 8px; }
  .legend i { width: 10px; height: 10px; border-radius: 3px; }

  .cr { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .cr__item { display: grid; gap: 4px; }
  .cr__item b { margin-top: 10px; font-weight: 500; }
  .cr__ctr { color: var(--text-2); font-variant-numeric: tabular-nums; }
  .cr__thumb { position: relative; aspect-ratio: 4 / 3; border-radius: 10px; overflow: hidden; background: #191924; }
  .cr__thumb i { position: absolute; display: block; }
  .cr__thumb--square { background: var(--accent); }
  .cr__thumb--square i:first-child { left: 12%; top: 16%; width: 54%; height: 14%; background: #fff; border-radius: 3px; }
  .cr__thumb--square i:last-child { left: 12%; bottom: 14%; width: 34%; height: 16%; background: #0a0a10; border-radius: 4px; }
  .cr__thumb--wide i:first-child { left: 0; right: 0; top: 38%; height: 24%; background: #24243a; }
  .cr__thumb--wide i:last-child { right: 8%; top: 43%; width: 18%; height: 14%; background: var(--coral); border-radius: 3px; }
  .cr__thumb--video { background: linear-gradient(160deg, #23233a, #121219); }
  .cr__thumb--video i:first-child { left: 50%; top: 50%; translate: -40% -50%; border-left: 18px solid rgb(255 255 255 / 0.85); border-block: 11px solid transparent; }
  .cr__thumb--video i:last-child { left: 8%; right: 8%; bottom: 10%; height: 3px; background: linear-gradient(90deg, #fff 30%, rgb(255 255 255 / 0.2) 30%); }
  /* статус — цветной текст с точкой, без плашки */
  .cr__status { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; }
  .cr__status::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
  .cr__status--good { color: var(--green); }
  .cr__status--neutral { color: var(--text-2); }
  .cr__status--bad { color: var(--coral); }

  .tbl { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  .tbl th { padding: 0 10px 12px; text-align: right; color: var(--text-2); font-weight: 400; border-bottom: 1px solid var(--line); }
  .tbl td { padding: 12px 10px; text-align: right; border-bottom: 1px solid var(--line); }
  .tbl th:first-child, .tbl td:first-child { text-align: left; padding-left: 0; }
  .tbl th:last-child, .tbl td:last-child { padding-right: 0; }
  .done { margin-top: auto; display: flex; align-items: center; gap: 10px; color: var(--text-2); }
  .done i { color: var(--green); font-style: normal; }

  /* ── планшет и телефон: вкладки-кнопки над кабинетом ── */
  @media (max-width: 1000px) {
    .pl__body { display: block; }
    .pl__nav { margin-bottom: 16px; }
    .pl__steps {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: calc(var(--pad) * -1);
      padding-inline: var(--pad);
    }
    .pl__steps::-webkit-scrollbar { display: none; }
    .pl__step {
      flex: none;
      display: block;
      padding: 10px 16px;
      border: 1px solid var(--line-strong);
      border-radius: 999px;
      opacity: 1;
    }
    .pl__step[aria-selected='true'] { background: var(--text); color: var(--bg); border-color: var(--text); }
    .pl__text, .pl__bar { display: none; }
    .pl__title { font-size: 15px; }
    /* высота под самую длинную подпись (3 строки), чтобы кабинет не прыгал при смене вкладки */
    .pl__mtext { display: block; margin-top: 14px; color: var(--text-2); font-size: 16px; line-height: 1.55; min-height: 4.65em; }
  }

  /* телефон: блок в один экран — кабинет ужат по высоте, второстепенное скрыто */
  @media (max-width: 640px) {
    .pl__sub { display: none; }
    .pl__nav { margin-bottom: 12px; }
    .pl__mtext { margin-top: 10px; font-size: 15px; line-height: 1.45; min-height: 2.9em; }
    /* все четыре вкладки — в ширину экрана, без прокрутки вбок */
    .pl__steps { gap: 6px; overflow: visible; margin-inline: 0; padding-inline: 0; }
    .pl__step { flex: 1 1 auto; padding: 9px 6px; text-align: center; }
    .pl__title { font-size: clamp(12px, 3.5vw, 15px); white-space: nowrap; }
    .app {
      grid-template-columns: minmax(0, 1fr);
      height: clamp(270px, calc(100svh - var(--header-h) - 2 * var(--sec-y) - 222px), 520px);
      border-radius: 16px;
    }
    .app__side { display: none; }
    .view { padding: 16px; gap: 14px; }
    .v-head b { font-size: 17px; }
    .v-head div span { font-size: 14px; }
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kpi { padding: 10px 0 10px 14px; }
    .kpi:nth-child(odd) { padding-left: 0; }
    .kpi + .kpi { border-left: 0; }
    .kpi:nth-child(even) { border-left: 1px solid var(--line); }
    .kpi:nth-child(n + 3) { display: none; }
    .kpi b { font-size: 24px; }
    .chart svg { min-height: 60px; }
    .aud { grid-template-columns: minmax(0, 1fr); }
    .aud__col:nth-child(2) { display: none; }
    .cr { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .cr__item:nth-child(3) { display: none; }
    .tbl th:nth-child(4), .tbl td:nth-child(4) { display: none; }
    .tbl td { padding-block: 9px; }
    .tbl tbody tr:nth-child(n + 5) { display: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-pl]');
  const steps = [...document.querySelectorAll<HTMLButtonElement>('[data-step]')];
  const views = [...document.querySelectorAll<HTMLElement>('[data-view]')];
  const mtext = document.querySelector<HTMLElement>('[data-mtext]');
  const DUR = 6000;
  let active = -1;
  let timer = 0;
  let visible = false;
  // автопереключение до первого клика; при «уменьшить движение» — сразу ручной режим
  let auto = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const setActive = (i: number) => {
    if (i === active) return;
    active = i;
    steps.forEach((s, k) => {
      s.setAttribute('aria-selected', String(k === i));
      s.toggleAttribute('data-done', k < i);
      s.tabIndex = k === i ? 0 : -1;
    });
    views.forEach((v, k) => v.toggleAttribute('data-active', k === i));
    if (mtext) mtext.textContent = steps[i].querySelector('.pl__text')?.textContent ?? '';
  };

  // таймер идёт, только пока блок на экране; полоска вкладки перезапускается вместе с ним
  const sync = () => {
    window.clearInterval(timer);
    const on = auto && visible;
    root?.toggleAttribute('data-auto', on);
    if (on) timer = window.setInterval(() => setActive((active + 1) % steps.length), DUR);
  };

  steps.forEach((step, k) => {
    step.addEventListener('click', () => {
      auto = false;
      setActive(k);
      sync();
    });
    step.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const next = (k + (e.key === 'ArrowRight' ? 1 : -1) + steps.length) % steps.length;
      steps[next].focus();
      steps[next].click();
    });
  });

  setActive(0);
  root?.style.setProperty('--pl-dur', `${DUR}ms`);
  if (root) {
    new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        sync();
      },
      { threshold: 0.5 },
    ).observe(root);
  }
</script>
