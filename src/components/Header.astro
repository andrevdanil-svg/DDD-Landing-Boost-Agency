---
import { publishedPosts, rubricUrl, rubricsWithPosts } from '../lib/blog';

const nav = [
  { href: '/services/', label: 'Услуги' },
  { href: '/platforms/', label: 'Площадки' },
  { href: '/cases/', label: 'Кейсы' },
  { href: '/blog/', label: 'Блог' },
  { href: '/glossary/', label: 'Глоссарий' },
  { href: '/process/', label: 'Как работаем' },
];

// Разделы блога в меню — только рубрики, где уже есть посты (сайт пересобирается
// при каждой публикации, так что меню обновляется само).
const blogPosts = await publishedPosts();
const blogSections = rubricsWithPosts(blogPosts);

// на главной — якорь к форме, на остальных страницах — отдельная страница контактов
const contactHref = Astro.url.pathname === '/' ? '#contact' : '/contact/';
---

<header class="hdr" data-hdr>
  <div class="wrap hdr__in">
    <a href="/" class="hdr__logo" aria-label="Boost! Agency — на главную">
      <img src="/brand/logo_boost_light.svg" alt="" width="116" height="24" />
    </a>
    <nav class="hdr__nav" aria-label="Основная навигация">
      {
        nav.map((n) =>
          n.href === '/blog/' && blogSections.length > 0 ? (
            <div class="dd" data-dd>
              <a href={n.href} class="dd__link">{n.label}</a>
              <button class="dd__toggle" type="button" aria-expanded="false" aria-controls="dd-blog" aria-label="Разделы блога" data-dd-toggle>
                <svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </button>
              <div class="dd__panel" id="dd-blog">
                <ul class="dd__list">
                  <li><a href="/blog/" class="dd__item dd__item--all">Все статьи <span>{blogPosts.length}</span></a></li>
                  {blogSections.map(({ rubric, count }) => (
                    <li><a href={rubricUrl(rubric)} class="dd__item">{rubric.name} <span>{count}</span></a></li>
                  ))}
                </ul>
              </div>
            </div>
          ) : (
            <a href={n.href}>{n.label}</a>
          ),
        )
      }
    </nav>
    <div class="hdr__end">
      <a class="btn btn--primary btn--sm hdr__cta" href={contactHref}>Обсудить задачу</a>
      <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Открыть меню" data-burger>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <div class="menu" id="menu" hidden data-menu>
    <nav class="wrap menu__nav" aria-label="Мобильное меню">
      {
        nav.map((n) => (
          <>
            <a href={n.href}>{n.label}</a>
            {n.href === '/blog/' && blogSections.length > 0 && (
              <div class="menu__sub">
                {blogSections.map(({ rubric }) => <a href={rubricUrl(rubric)}>{rubric.name}</a>)}
              </div>
            )}
          </>
        ))
      }
      <a href={contactHref}>Контакты</a>
    </nav>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease);
  }
  .hdr.is-scrolled { border-bottom-color: var(--line); }

  .hdr__in {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .hdr__logo img { height: 24px; width: auto; }

  .hdr__nav {
    display: flex;
    gap: 28px;
    margin-left: 16px;
    font-size: 15px;
    color: var(--text-2);
  }
  .hdr__nav a { transition: color 0.2s; white-space: nowrap; }
  .hdr__cta { white-space: nowrap; }
  .hdr__nav a:hover { color: var(--text); }

  /* Выпадающее меню «Блог»: по наведению и фокусу (мышь, клавиатура), по кнопке-стрелке —
     для тач-экранов, где наведения нет. */
  .dd { position: relative; display: flex; align-items: center; gap: 2px; }
  .dd__toggle {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 6px;
    color: var(--text-3);
    transition: color 0.2s, transform 0.25s var(--ease);
  }
  .dd:hover .dd__toggle, .dd.is-open .dd__toggle { color: var(--text); }
  .dd.is-open .dd__toggle { transform: rotate(180deg); }
  .dd__panel {
    position: absolute;
    top: 100%;
    left: -16px;
    padding-top: 14px; /* мостик: курсор не теряет меню по пути от пункта к списку */
    visibility: hidden;
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0s linear 0.18s;
  }
  .dd:hover .dd__panel, .dd:focus-within .dd__panel, .dd.is-open .dd__panel {
    visibility: visible;
    opacity: 1;
    transform: none;
    transition-delay: 0s;
  }
  .dd__list {
    list-style: none;
    margin: 0;
    min-width: 240px;
    padding: 8px;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.45);
  }
  .dd__item {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 12px;
    border-radius: 8px;
    color: var(--text-2);
    white-space: nowrap;
  }
  .dd__item span { color: var(--text-3); font-size: 13px; font-variant-numeric: tabular-nums; }
  .dd__item:hover, .dd__item:focus-visible { background: rgb(255 255 255 / 0.05); color: var(--text); }
  .dd__item--all { color: var(--text); font-weight: 500; }

  .hdr__end { margin-left: auto; display: flex; align-items: center; gap: 16px; }

  .hdr__burger { display: none; width: 44px; height: 44px; position: relative; }
  .hdr__burger span {
    position: absolute;
    left: 12px; right: 12px;
    height: 1.5px;
    background: var(--text);
    transition: transform 0.3s var(--ease);
  }
  .hdr__burger span:first-child { top: 18px; }
  .hdr__burger span:last-child { top: 25px; }
  .hdr__burger[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--bg);
    border-top: 1px solid var(--line);
    overflow-y: auto;
  }
  .menu__nav { display: flex; flex-direction: column; padding-block: 8px 40px; }
  .menu__nav > a {
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
    font: 600 28px/1.1 var(--f-display);
    letter-spacing: -0.02em;
  }
  .menu__sub {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 14px 0 18px;
    border-bottom: 1px solid var(--line);
  }
  .menu__sub a {
    padding: 9px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font-size: 15px;
    color: var(--text-2);
  }

  /* шесть пунктов меню и кнопка на средней ширине помещаются только плотнее */
  @media (max-width: 1180px) {
    .hdr__in { gap: 20px; }
    .hdr__nav { gap: 18px; margin-left: 4px; }
  }

  @media (max-width: 960px) {
    .hdr__nav, .hdr__cta { display: none; }
    .hdr__burger { display: block; }
    .hdr__end { gap: 4px; }
  }
</style>

<script>
  const hdr = document.querySelector<HTMLElement>('[data-hdr]');
  const burger = document.querySelector<HTMLButtonElement>('[data-burger]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  const onScroll = () => hdr?.classList.toggle('is-scrolled', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  const setMenu = (open: boolean) => {
    if (!burger || !menu) return;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Закрыть меню' : 'Открыть меню');
    menu.hidden = !open;
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  burger?.addEventListener('click', () => setMenu(burger.getAttribute('aria-expanded') !== 'true'));
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setMenu(false);
  });

  // Выпадающее меню «Блог»: кнопка-стрелка для тач-экранов, закрытие по клику мимо и Esc.
  const dd = document.querySelector<HTMLElement>('[data-dd]');
  const ddToggle = dd?.querySelector<HTMLButtonElement>('[data-dd-toggle]');
  const setDd = (open: boolean) => {
    dd?.classList.toggle('is-open', open);
    ddToggle?.setAttribute('aria-expanded', String(open));
  };
  ddToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    setDd(!dd?.classList.contains('is-open'));
  });
  document.addEventListener('click', (e) => {
    if (dd && !dd.contains(e.target as Node)) setDd(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape' || !dd) return;
    setDd(false);
    if (dd.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
  });
</script>
