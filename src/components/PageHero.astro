---
import Arrow from './Arrow.astro';
import { TELEGRAM } from '../data/contacts';
import { typo } from '../lib/typo';
import { linkify } from '../lib/linkify';
import type { PageData } from '../data/pages';

interface Props {
  hero: PageData['hero'];
}
const { hero } = Astro.props;
---

<section class:list={['ph', { 'ph--compact': hero.compact }]}>
  <div class="wrap">
    {hero.back && <a class="ph__back" href={hero.back.href}><Arrow /> {hero.back.label}</a>}
    <h1 class="ph__title">{typo(hero.title)}</h1>
    <p class="ph__lead" set:html={linkify(typo(hero.lead))} />
    {hero.meta && <p class="ph__meta">{hero.meta}</p>}
    {
      hero.cta && (
        <div class="ph__cta">
          <a class="btn btn--primary" href={TELEGRAM}>
            {hero.ctaLabel ?? 'Обсудить задачу в Telegram'} <Arrow />
          </a>
          <a class="btn btn--ghost" href="/contact/">Оставить заявку</a>
        </div>
      )
    }
  </div>
</section>

<style>
  .ph { padding-block: clamp(48px, 10vh, 120px) clamp(56px, 10vh, 120px); }
  .ph__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(24px, 4vh, 48px);
    color: var(--text-2);
    transition: color 0.2s;
  }
  .ph__back :global(svg) { width: 16px; height: 16px; transform: rotate(180deg); }
  .ph__back:hover { color: var(--text); }
  .ph__title {
    max-width: 15em;
    font: 700 clamp(40px, 6.4vw, 96px)/0.98 var(--f-display);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .ph__lead { max-width: 46ch; margin-top: 28px; color: var(--text-2); font-size: clamp(17px, 1.4vw, 20px); }
  .ph__lead :global(a) { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }
  .ph__meta { margin-top: 16px; color: var(--text-3); }
  .ph__cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  .ph--compact { padding-bottom: clamp(32px, 6vh, 64px); }
  .ph--compact .ph__title { font-size: clamp(34px, 4.6vw, 64px); }
  .ph--compact .ph__lead { font-size: 17px; margin-top: 16px; }

  @media (max-width: 640px) {
    .ph__cta { flex-direction: column; }
    .ph__cta .btn { width: 100%; }
  }
</style>
