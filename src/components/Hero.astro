---
import Arrow from './Arrow.astro';
import { TELEGRAM } from '../data/contacts';

// ПРОТОТИП: число демонстрационное. В проде берём сумму показов из платформы.
const TOTAL_IMPRESSIONS = 2418337905;
const total = new Intl.NumberFormat('ru-RU').format(TOTAL_IMPRESSIONS);

// Показы по месяцам за последний год, % от максимума (демо) — столбцы встают ровно по колонкам сетки
const months = [26, 31, 29, 38, 44, 41, 53, 58, 55, 69, 81, 96];
---

<section class="hero">
  <div class="hero__cols" aria-hidden="true">
    {Array.from({ length: 12 }, () => <span />)}
  </div>

  <div class="wrap hero__body">
    <div class="hero__chart" aria-hidden="true">
      {months.map((h, i) => <i style={`--h:${h}%;--i:${i}`} />)}
    </div>

    <p class="hero__count" data-in style="--d:0">
      <span class="sr-only">Более 2,4 миллиарда</span>
      <span aria-hidden="true" data-counter={TOTAL_IMPRESSIONS}>{total}</span>
    </p>
    <p class="hero__lead" data-in style="--d:1">
      показов рекламы купили для&nbsp;клиентов&nbsp;— и&nbsp;каждый можно проверить <u>в&nbsp;кабинете</u>.
    </p>

    <div class="hero__aside" data-in style="--d:2">
      <div>
        <h1 class="hero__h1">Boost&nbsp;— рекламное агентство в&nbsp;Ташкенте.</h1>{' '}
        <p>
          Реклама в&nbsp;интернете, на&nbsp;ТВ, радио и&nbsp;улицах, сайты под&nbsp;трафик и&nbsp;пополнение рекламных
          кабинетов. Результаты digital-кампаний&nbsp;— в&nbsp;личном кабинете, без менеджера-посредника.
        </p>
      </div>
      <div class="hero__cta">
        <a class="btn btn--primary" href={TELEGRAM}>Обсудить задачу в&nbsp;Telegram <Arrow /></a>
        <a class="btn btn--ghost" href="#contact">Медиаплан за&nbsp;48&nbsp;часов</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
    overflow: clip;
  }

  .hero__cols {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-inline: var(--pad);
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    pointer-events: none;
  }
  .hero__cols span { border-inline: 1px solid var(--line); opacity: 0.5; }

  .hero__body {
    position: relative;
    flex: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: minmax(0, 1fr) auto auto auto;
    column-gap: var(--gap);
    padding-block: clamp(24px, 5vh, 64px) clamp(48px, 9vh, 104px);
    container-type: inline-size;
  }

  /* График роста: заполняет верх экрана и «стекает» в счётчик под ним */
  .hero__chart {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: end;
    min-height: clamp(96px, 18vh, 420px);
    margin-bottom: clamp(16px, 3vh, 32px);
  }
  .hero__chart i {
    height: var(--h);
    border-top: 2px solid rgb(101 91 250 / 0.65);
    background: linear-gradient(to bottom, rgb(101 91 250 / 0.2), rgb(101 91 250 / 0));
    transform-origin: bottom;
  }
  .hero__chart i:last-child {
    border-top-color: var(--accent);
    background: linear-gradient(to bottom, rgb(101 91 250 / 0.42), rgb(101 91 250 / 0));
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__chart i {
      animation: bar-grow 1.4s var(--ease) both;
      animation-delay: calc(var(--i) * 55ms + 150ms);
    }
    @keyframes bar-grow { from { transform: scaleY(0); } }
  }

  .hero__count {
    grid-column: 1 / -1;
    margin-left: -0.05em;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(34px, 12.6cqi, 200px);
    line-height: 0.86;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .hero__lead {
    grid-column: 1 / span 7;
    margin-top: clamp(18px, 3vh, 36px);
    font: 600 clamp(22px, 2.8vw, 42px)/1.12 var(--f-display);
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .hero__lead u {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.16em;
  }

  .hero__aside {
    grid-column: 9 / -1;
    align-self: end;
    display: grid;
    gap: 24px;
  }
  .hero__aside div { max-width: 42ch; }
  .hero__h1 { display: inline; font: 600 17px/1.55 var(--f-text); color: var(--text); }
  .hero__aside p { display: inline; color: var(--text-2); }
  .hero__cta { display: flex; flex-wrap: wrap; gap: 12px; }

  /* появление первого экрана */
  @media (prefers-reduced-motion: no-preference) {
    [data-in] { animation: rise 1s var(--ease) both; animation-delay: calc(var(--d) * 90ms + 80ms); }
    @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  }

  @media (max-width: 1000px) {
    .hero__lead { grid-column: 1 / -1; }
    .hero__aside { grid-column: 1 / -1; margin-top: 32px; }
  }

  @media (max-width: 640px) {
    /* на телефоне — последние 6 месяцев, линии сетки совпадают со столбцами */
    .hero__cols { grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: 16px; }
    .hero__cols span:nth-child(n + 7) { display: none; }
    .hero__body { column-gap: 16px; }
    .hero__chart { grid-template-columns: repeat(6, minmax(0, 1fr)); column-gap: 16px; }
    .hero__chart i:nth-child(-n + 6) { display: none; }
    .hero__cta { flex-direction: column; }
    .hero__cta .btn { width: 100%; }
  }
</style>

<script>
  const el = document.querySelector<HTMLElement>('[data-counter]');
  if (el) {
    const target = Number(el.dataset.counter);
    const fmt = new Intl.NumberFormat('ru-RU');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let value = reduce ? target : target - 240000;
    const render = () => { el.textContent = fmt.format(Math.round(value)); };
    render();

    if (!reduce) {
      const from = value;
      const t0 = performance.now();
      const intro = (t: number) => {
        const k = Math.min(1, (t - t0) / 1800);
        value = from + (target - from) * (1 - Math.pow(1 - k, 4));
        render();
        if (k < 1) requestAnimationFrame(intro);
        else window.setInterval(() => { value += 40 + Math.random() * 140; render(); }, 320);
      };
      requestAnimationFrame(intro);
    }
  }
</script>
