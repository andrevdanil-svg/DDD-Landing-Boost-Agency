---
import Arrow from './Arrow.astro';
import { TELEGRAM } from '../data/contacts';

const budgets = ['до $5 000', '$5 000 – $20 000', '$20 000 – $50 000', 'от $50 000'];

interface Props {
  heading?: 'h1' | 'h2';
}
const { heading: Heading = 'h2' } = Astro.props;
---

<section class="ct" id="contact" aria-labelledby="ct-title" data-contact>
  <div class="wrap">
    <div class="ct__ways">
      <div class="ct__tg">
        <Heading id="ct-title" class="h2 ct__title">Пришлите задачу&nbsp;— вернём медиаплан за&nbsp;48&nbsp;часов</Heading>
        <p class="ct__muted">
          Быстрее всего&nbsp;— в&nbsp;Telegram. Ответим в&nbsp;течение рабочего дня, можно сразу с&nbsp;брифом или
          ссылкой на&nbsp;сайт.
        </p>
        <a class="btn btn--primary" href={TELEGRAM}>Написать в&nbsp;Telegram <Arrow /></a>
      </div>

      <form class="ct__form" novalidate data-form aria-labelledby="ct-form-title">
        <h3 class="ct__sub" id="ct-form-title">Или оставьте контакт</h3>
        <div class="ct__pair">
          <label class="field">
            <span>Имя</span>
            <input name="name" autocomplete="name" required />
          </label>
          <label class="field">
            <span>Телефон или Telegram</span>
            <input name="contact" autocomplete="tel" inputmode="tel" placeholder="+998… или @username" required />
          </label>
        </div>
        <label class="field">
          <span>Бюджет в месяц <em>— необязательно</em></span>
          <select name="budget">
            <option value="">Пока не знаю</option>
            {budgets.map((b) => <option>{b}</option>)}
          </select>
        </label>
        <!-- ловушка для ботов: человек это поле не видит и не заполняет -->
        <input class="ct__hp" name="website_url" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <button class="btn btn--ghost" type="submit">Получить медиаплан</button>
        <p class="ct__legal">
          Нажимая кнопку, вы соглашаетесь с&nbsp;<a href="/privacy/">политикой конфиденциальности</a>.
        </p>
        <p class="ct__ok" role="status" hidden data-ok>Спасибо! Напишем в&nbsp;течение рабочего дня.</p>
        <p class="ct__err" role="alert" hidden data-err>
          Не&nbsp;получилось отправить. Попробуйте ещё раз или напишите в&nbsp;<a href={TELEGRAM}>Telegram</a>.
        </p>
      </form>
    </div>
  </div>
</section>

<style>
  .ct { border-top: 1px solid var(--line); padding-block: var(--sec-y); }

  /* слева — заголовок и Telegram, справа — форма: блок в один экран */
  .ct__ways {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .ct__tg, .ct__form { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .ct__tg { padding-right: clamp(24px, 4vw, 64px); }
  .ct__title { font-size: clamp(32px, min(4.2vw, 7.4vh), 68px); text-wrap: balance; margin-bottom: 8px; }
  .ct__form { padding-left: clamp(24px, 4vw, 64px); border-left: 1px solid var(--line); align-items: stretch; justify-content: flex-end; }

  .ct__sub { font: 600 clamp(20px, 1.8vw, 26px)/1.2 var(--f-display); letter-spacing: -0.02em; }
  .ct__muted { color: var(--text-2); max-width: 40ch; margin-bottom: 8px; }
  .ct__pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }

  .field { display: grid; gap: 8px; }
  .field span { font-size: 14px; color: var(--text-2); }
  .field em { font-style: normal; color: var(--text-3); }
  .field input, .field select {
    height: clamp(46px, 7vh, 52px);
    width: 100%;
    padding: 0 16px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: var(--bg-raised);
    color: var(--text);
    font: 400 16px/1 var(--f-text);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field input::placeholder { color: var(--text-3); }
  .field select {
    appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' fill='none'><path d='M1 1.5 6 6.5l5-5' stroke='%23a8a8b4' stroke-width='1.5' stroke-linecap='round'/></svg>");
    background-repeat: no-repeat;
    background-position: right 16px center;
  }
  .field input:focus, .field select:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgb(101 91 250 / 0.3);
  }
  .field input[aria-invalid='true'] { border-color: var(--coral); }
  /* автозаполнение Chrome/Safari не должно красить поле в белый/жёлтый */
  .field input:-webkit-autofill,
  .field input:-webkit-autofill:hover,
  .field input:-webkit-autofill:focus {
    -webkit-box-shadow: 0 0 0 100px var(--bg-raised) inset;
    -webkit-text-fill-color: var(--text);
    caret-color: var(--text);
    transition: background-color 9999s;
  }

  .ct__form .btn { margin-top: 8px; }
  .ct__legal { font-size: 13px; color: var(--text-3); }
  .ct__legal a { text-decoration: underline; text-underline-offset: 3px; }
  .ct__ok { color: var(--green); }
  .ct__err { color: var(--coral); }
  .ct__err a { text-decoration: underline; text-underline-offset: 3px; }
  .ct__hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  @media (max-width: 860px) {
    .ct__ways { grid-template-columns: minmax(0, 1fr); }
    .ct__tg { padding: 0 0 24px; }
    .ct__form { padding: 24px 0 0; border-top: 1px solid var(--line); border-left: 0; }
    .ct__tg .btn { width: 100%; }
  }
  @media (max-width: 640px) {
    .ct__title { font-size: 30px; margin-bottom: 0; }
    .ct__muted { display: none; }
    .ct__form { gap: 12px; }
    /* подзаголовок формы остаётся для скринридера, визуально форму отделяет линия */
    .ct__sub { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .ct__pair { gap: 10px; }
    .ct__pair input::placeholder { color: transparent; }
    .field { gap: 6px; }
    .field span { font-size: 13px; }
    .field input, .field select { height: 46px; }
    .ct__form .btn { margin-top: 4px; }
    .ct__legal { font-size: 12px; }
  }
</style>

<script>
  const LEADS_API = 'https://platform.boostagency.uz/api/leads';

  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const renderedAt = Date.now();
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const okEl = form.querySelector<HTMLElement>('[data-ok]')!;
    const errEl = form.querySelector<HTMLElement>('[data-err]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    errEl.hidden = true;

    let ok = true;
    form.querySelectorAll<HTMLInputElement>('input[required]').forEach((input) => {
      const bad = input.value.trim().length < 2;
      input.setAttribute('aria-invalid', String(bad));
      if (bad && ok) input.focus();
      if (bad) ok = false;
    });
    if (!ok) return;

    const done = () => {
      okEl.hidden = false;
      btn.disabled = true;
    };
    const fd = new FormData(form);
    // боты заполняют скрытое поле или отправляют форму быстрее человека — молча «принимаем»
    if (String(fd.get('website_url') || '').trim() || Date.now() - renderedAt < 3000) return done();

    const label = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Отправляем…';
    try {
      const res = await fetch(LEADS_API, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          first_name: String(fd.get('name')).trim(),
          phone: String(fd.get('contact')).trim(),
          budget: String(fd.get('budget') || ''),
          source: 'landing · ' + location.pathname + location.search,
        }),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      btn.textContent = label;
      done();
    } catch (err) {
      console.error('Lead submit failed:', err);
      btn.textContent = label;
      btn.disabled = false;
      errEl.hidden = false;
    }
  });
</script>
