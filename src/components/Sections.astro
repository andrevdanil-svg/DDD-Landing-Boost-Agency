---
import Arrow from './Arrow.astro';
import { typo } from '../lib/typo';
import { linkify } from '../lib/linkify';
import type { Section } from '../data/pages';

interface Props {
  sections: Section[];
}
const { sections } = Astro.props;
// колонок столько, чтобы блок был не выше экрана: до 4 — в ряд, 5/6/9 — по 3, остальное — по 4
const cols = (n: number) => (n <= 4 ? n : [5, 6, 9].includes(n) ? 3 : 4);
---

{
  sections.map((s, si) => {
    if (s.type === 'prose') {
      return (
        <section class="sx sx--prose">
          <div class="wrap">
            <div class="prose">
              {s.blocks.map((b) =>
                'h2' in b ? (
                  <h2>{b.h2}</h2>
                ) : 'p' in b ? (
                  <p set:html={linkify(b.p)} />
                ) : (
                  <ul>
                    {b.ul.map((li) => (
                      <li set:html={linkify(li)} />
                    ))}
                  </ul>
                ),
              )}
            </div>
          </div>
        </section>
      );
    }

    if (s.type === 'stats') {
      return (
        <section class="sx sx--stats" id={s.id}>
          <div class="wrap">
            <h2 class="sx__title">{typo(s.title)}</h2>
            <ul class="stats" style={`--n:${Math.min(s.items.length, 4)};--len:${Math.max(...s.items.map((it) => it.value.length))}`}>
              {s.items.map((it) => (
                <li>
                  <b>{it.value}</b>
                  <span>{typo(it.label)}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    }

    // у блока из двух колонок общего заголовка нет — заголовки у колонок
    const head = 'title' in s && (
      <div class="sx__head">
        <h2 class="sx__title">{typo(s.title)}</h2>
        {'intro' in s && s.intro && <p class="sx__intro">{typo(s.intro)}</p>}
      </div>
    );

    if (s.type === 'text') {
      return (
        <section class="sx" id={s.id}>
          <div class="wrap text">
            <h2 class="sx__title">{typo(s.title)}</h2>
            <p>{typo(s.text)}</p>
          </div>
        </section>
      );
    }

    if (s.type === 'list') {
      return (
        <section class="sx" id={s.id}>
          <div class="wrap">
            {head}
            <ul class="rows" data-cols={cols(s.items.length)} data-many={s.items.length > 4 ? '' : undefined}>
              {s.items.map((it) => (
                <li>
                  <a href={it.href}>
                    <span class="rows__name">{typo(it.title)}</span>
                    <span class="rows__go" aria-hidden="true">
                      <Arrow />
                    </span>
                    <span class="rows__text">{typo(it.text)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    }

    if (s.type === 'grid') {
      return (
        <section class="sx" id={s.id}>
          <div class="wrap">
            {head}
            <ul class="grid" data-cols={cols(s.items.length)} data-many={s.items.length > 3 ? '' : undefined}>
              {s.items.map((it) => (
                <li>
                  <h3>{typo(it.title)}</h3>
                  <p>{typo(it.text)}</p>
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    }

    if (s.type === 'formats') {
      // форматы — вкладки, справа пример выбранного; на телефоне — карточки с примером, листаются вбок
      const first = Math.max(0, s.items.findIndex((it) => it.shot));
      return (
        <section class="sx" id={s.id}>
          <div class="wrap">
            {head}
            <ol class="fm" role="tablist" aria-label={s.title} style={`--n:${s.items.length}`} data-fm>
              {s.items.map((it, i) => (
                <li role="presentation" data-active={i === first ? '' : undefined}>
                  <button
                    class="fm__tab"
                    type="button"
                    role="tab"
                    id={`fm${si}-t${i}`}
                    aria-controls={`fm${si}-p${i}`}
                    aria-selected={i === first ? 'true' : 'false'}
                    tabindex={i === first ? 0 : -1}
                  >
                    <span class="fm__title">{typo(it.title)}</span>
                    <span class="fm__text">{typo(it.text)}</span>
                  </button>
                  <figure
                    class:list={['fm__shot', { 'fm__shot--none': !it.shot }]}
                    role="tabpanel"
                    id={`fm${si}-p${i}`}
                    aria-labelledby={`fm${si}-t${i}`}
                    style={it.shot && `--bg:${it.shot.bg}`}
                  >
                    {it.shot ? (
                      <img src={it.shot.src} width={it.shot.w} height={it.shot.h} alt={`Пример формата «${it.title}»`} loading="lazy" decoding="async" />
                    ) : (
                      <figcaption>Пример этого формата пришлём вместе с&nbsp;медиакитом</figcaption>
                    )}
                  </figure>
                </li>
              ))}
            </ol>
            <div class="fm__dots" aria-hidden="true" data-fm-dots>
              {s.items.map((_, i) => <span data-on={i === 0 ? '' : undefined} />)}
            </div>
          </div>
        </section>
      );
    }

    if (s.type === 'steps') {
      return (
        <section class="sx" id={s.id}>
          <div class="wrap">
            {head}
            <ol class="steps">
              {s.items.map((it, i) => (
                <li>
                  <span class="steps__n" aria-hidden="true">
                    {i + 1}
                  </span>
                  <h3>{typo(it.title)}</h3>
                  <p>{typo(it.text)}</p>
                </li>
              ))}
            </ol>
          </div>
        </section>
      );
    }

    if (s.type === 'checks') {
      return (
        <section class="sx" id={s.id}>
          <div class="wrap split">
            {head}
            <ul class="checks">
              {s.items.map((it) => (
                <li>
                  <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  <span>{typo(it)}</span>
                </li>
              ))}
            </ul>
          </div>
        </section>
      );
    }

    if (s.type === 'duo') {
      return (
        <section class="sx" id={s.id}>
          <div class:list={['wrap', 'duo', { 'duo--single': s.columns.length === 1 }]}>
            {s.columns.map((col) => (
              <div>
                <h2 class="duo__title">{typo(col.title)}</h2>
                {col.text?.map((t) => (
                  <p class="duo__p">{typo(t)}</p>
                ))}
                {col.items && (
                  <ul class="checks" data-many={col.items.length > 5 ? '' : undefined}>
                    {col.items.map((it) => (
                      <li>
                        <svg viewBox="0 0 16 16" fill="none" aria-hidden="true">
                          <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                        <span>{typo(it)}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </section>
      );
    }

    if (s.type === 'faq') {
      return (
        <section class="sx" id={s.id}>
          <div class="wrap split">
            <div class="sx__head">
              <h2 class="sx__title">{typo(s.title)}</h2>
            </div>
            <div class="faq">
              {s.items.map((it) => (
                <details>
                  <summary>
                    <span>{typo(it.q)}</span>
                    <i aria-hidden="true" />
                  </summary>
                  <p>{typo(it.a)}</p>
                </details>
              ))}
            </div>
          </div>
        </section>
      );
    }
  })
}

<script>
  // вкладки форматов: клик или стрелки переключают пример
  document.querySelectorAll<HTMLElement>('[data-fm]').forEach((fm) => {
    const items = [...fm.children] as HTMLElement[];
    const tabs = items.map((li) => li.querySelector<HTMLButtonElement>('[role="tab"]')!);
    const select = (i: number) =>
      items.forEach((li, k) => {
        li.toggleAttribute('data-active', k === i);
        tabs[k].setAttribute('aria-selected', String(k === i));
        tabs[k].tabIndex = k === i ? 0 : -1;
      });
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i));
      tab.addEventListener('keydown', (e) => {
        const d = ['ArrowDown', 'ArrowRight'].includes(e.key) ? 1 : ['ArrowUp', 'ArrowLeft'].includes(e.key) ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const n = (i + d + tabs.length) % tabs.length;
        tabs[n].focus();
        select(n);
      });
    });

    // телефон: точки под каруселью показывают, какая карточка на экране
    const dots = [...(fm.parentElement?.querySelectorAll<HTMLElement>('[data-fm-dots] span') ?? [])];
    fm.addEventListener(
      'scroll',
      () => {
        const step = items.length > 1 ? items[1].offsetLeft - items[0].offsetLeft : fm.clientWidth;
        const on = Math.round(fm.scrollLeft / step);
        dots.forEach((d, k) => d.toggleAttribute('data-on', k === on));
      },
      { passive: true },
    );
  });
</script>

<style>
  .sx { border-top: 1px solid var(--line); padding-block: var(--sec-y); }

  .sx__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 16px;
    margin-bottom: var(--head-gap);
  }
  .sx__title {
    grid-column: 1 / span 7;
    font: 700 clamp(28px, min(3.6vw, 6.4vh), 56px)/1.02 var(--f-display);
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .sx__intro { grid-column: 8 / -1; align-self: end; color: var(--text-2); max-width: 46ch; }

  /* ссылки сеткой, как «Что делаем» на главной: разделители — только линии сверху */
  .rows {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--c, 3), minmax(0, 1fr));
    column-gap: var(--gap);
  }
  .rows[data-cols='1'] { --c: 1; }
  .rows[data-cols='2'] { --c: 2; }
  .rows[data-cols='4'] { --c: 4; }
  .rows a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    column-gap: 16px;
    row-gap: 8px;
    height: 100%;
    padding-block: clamp(14px, 2.4vh, 24px) clamp(18px, 3.4vh, 34px);
    border-top: 1px solid var(--line);
    transition: border-color 0.3s var(--ease);
  }
  .rows__name {
    font: 600 clamp(20px, min(1.7vw, 3.2vh), 26px)/1.15 var(--f-display);
    letter-spacing: -0.02em;
    text-wrap: balance;
    transition: color 0.3s;
  }
  .rows__text { grid-column: 1 / -1; color: var(--text-2); font-size: 16px; max-width: 44ch; }
  .rows__go {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .rows__go :global(svg) { width: 15px; height: 15px; }
  .rows a:hover { border-top-color: var(--accent); }
  .rows a:hover .rows__go { background: var(--accent); border-color: var(--accent); }

  /* сетка через тонкие линии */
  .grid {
    list-style: none;
    padding: 0;
    display: grid;
    border-top: 1px solid var(--line);
  }
  .grid[data-cols='2'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .grid[data-cols='3'] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .grid[data-cols='4'] { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .grid li { padding: clamp(16px, 3vh, 32px) clamp(16px, 2vw, 32px); border-bottom: 1px solid var(--line); }
  /* первая колонка без отступа слева, между колонками — тонкая линия */
  .grid[data-cols='2'] li:nth-child(2n + 1), .grid[data-cols='3'] li:nth-child(3n + 1), .grid[data-cols='4'] li:nth-child(4n + 1) { padding-left: 0; }
  .grid[data-cols='2'] li:nth-child(2n), .grid[data-cols='3'] li:not(:nth-child(3n + 1)), .grid[data-cols='4'] li:not(:nth-child(4n + 1)) { border-left: 1px solid var(--line); }
  .grid h3 { font: 600 clamp(19px, 1.6vw, 23px)/1.25 var(--f-display); letter-spacing: -0.015em; }
  .grid p { margin-top: 10px; color: var(--text-2); font-size: 16px; }

  /* форматы: слева вкладки, справа пример выбранного (все примеры — в одной ячейке сетки) */
  .fm {
    --fm-h: clamp(320px, calc(100svh - var(--header-h) - 2 * var(--sec-y) - var(--head-gap) - 12vh), 600px);
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: repeat(var(--n), auto) 1fr;
    column-gap: clamp(32px, 5vw, 80px);
  }
  .fm > li { display: contents; }
  .fm__tab {
    grid-column: 1;
    position: relative;
    display: grid;
    padding: clamp(8px, 1.3vh, 14px) 0 clamp(8px, 1.3vh, 14px) 20px;
    text-align: left;
    opacity: 0.5;
    transition: opacity 0.3s var(--ease);
  }
  .fm__tab::before {
    content: '';
    position: absolute;
    left: 0; top: 12px; bottom: 12px;
    width: 2px;
    background: var(--line-strong);
    transition: background-color 0.3s var(--ease);
  }
  .fm__tab:hover, .fm > li[data-active] .fm__tab { opacity: 1; }
  .fm > li[data-active] .fm__tab::before { background: var(--accent); }
  .fm__title { font: 600 clamp(17px, 1.4vw, 20px)/1.3 var(--f-display); letter-spacing: -0.015em; }
  .fm__text {
    max-height: 0;
    overflow: hidden;
    color: var(--text-2);
    font-size: 15.5px;
    line-height: 1.5;
    transition: max-height 0.4s var(--ease), margin 0.4s var(--ease);
  }
  .fm > li[data-active] .fm__text { max-height: 9em; margin-top: 6px; }
  .fm__shot {
    grid-column: 2;
    grid-row: 1 / -1;
    align-self: start;
    height: var(--fm-h);
    margin: 0;
    overflow: hidden;
    border-radius: 18px;
    background: var(--bg, var(--bg-raised));
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s var(--ease), visibility 0s linear 0.35s;
  }
  .fm > li[data-active] .fm__shot { opacity: 1; visibility: visible; transition-delay: 0s; }
  .fm__shot img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .fm__shot--none { display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); }
  .fm__shot figcaption { max-width: 26ch; padding: 24px; color: var(--text-2); text-align: center; }
  .fm__dots { display: none; }

  /* шаги */
  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .steps li { padding-top: 24px; border-top: 1px solid var(--line-strong); }
  .steps__n { display: block; font: 700 clamp(32px, 3vw, 44px)/1 var(--f-display); color: var(--accent); letter-spacing: -0.03em; }
  .steps h3 { margin-top: 20px; font: 600 21px/1.25 var(--f-display); letter-spacing: -0.015em; }
  .steps p { margin-top: 10px; color: var(--text-2); }

  /* заголовок слева, список справа */
  .split { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); }
  .split .sx__head { display: block; margin-bottom: 0; }
  .split .sx__intro { margin-top: 20px; }
  .checks { list-style: none; padding: 0; border-bottom: 1px solid var(--line); }
  .checks li {
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding-block: clamp(10px, 1.7vh, 18px);
    border-top: 1px solid var(--line);
    font-size: 17px;
  }
  .checks svg { width: 20px; height: 20px; margin-top: 2px; color: var(--accent); }

  /* две колонки: текст и/или список */
  .duo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(40px, 6vw, 96px); }
  .duo--single { grid-template-columns: minmax(0, 1fr); max-width: 760px; }
  .duo__title { margin-bottom: clamp(14px, 2.6vh, 24px); font: 700 clamp(24px, min(2.6vw, 4.6vh), 40px)/1.05 var(--f-display); letter-spacing: -0.03em; }
  .duo__p { color: var(--text-2); font-size: 17px; line-height: 1.55; }
  .duo__p + .duo__p { margin-top: 12px; }
  /* длинный список в половине экрана — в две колонки */
  .duo .checks[data-many] { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--gap); border-bottom: 0; }
  .duo .checks[data-many] li { font-size: 16px; }

  /* вопросы-ответы на нативных <details> — работают без JS */
  .faq { border-bottom: 1px solid var(--line); }
  .faq details { border-top: 1px solid var(--line); }
  .faq summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-block: 22px;
    cursor: pointer;
    list-style: none;
    font: 600 clamp(18px, 1.5vw, 21px)/1.3 var(--f-display);
    letter-spacing: -0.01em;
  }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary i { position: relative; flex: none; width: 16px; height: 16px; }
  .faq summary i::before, .faq summary i::after {
    content: '';
    position: absolute;
    left: 0; right: 0; top: 7px;
    height: 2px;
    border-radius: 1px;
    background: var(--text-2);
    transition: transform 0.3s var(--ease);
  }
  .faq summary i::after { transform: rotate(90deg); }
  .faq details[open] summary i::after { transform: rotate(0deg); }
  .faq details p { padding-bottom: 24px; color: var(--text-2); max-width: 60ch; }

  /* большой текстовый блок */
  .text { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(32px, 5vw, 80px); }
  .text .sx__title { grid-column: auto; }
  .text p { font: 500 clamp(20px, 2vw, 28px)/1.4 var(--f-display); letter-spacing: -0.015em; color: var(--text-2); }

  /* цифры на фиолетовом */
  .sx--stats { background: var(--accent); color: #fff; border-top: 0; }
  .sx--stats .sx__title { margin-bottom: clamp(28px, 5vh, 56px); }
  .stats { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr)); border-top: 1px solid rgb(255 255 255 / 0.3); }
  .stats li { display: grid; gap: 8px; align-content: start; padding: 28px clamp(16px, 2vw, 28px) 0; }
  .stats li:first-child { padding-left: 0; }
  .stats li + li { border-left: 1px solid rgb(255 255 255 / 0.3); }
  /* размер цифры — от ширины колонки и длины самого длинного значения (с запасом на широкие буквы «млн»: 0,8 em) */
  .stats b {
    font: 800 clamp(30px, calc((min(100vw, var(--max)) - 96px) / var(--n, 4) / (var(--len, 6) * 0.8)), 88px)/1 var(--f-display);
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .stats span { color: rgb(255 255 255 / 0.85); overflow-wrap: break-word; -webkit-hyphens: auto; hyphens: auto; }

  /* юридический текст */
  .sx--prose { border-top: 0; padding-top: 0; }
  .prose { max-width: 760px; }
  .prose h2 { margin-top: 48px; font: 600 clamp(21px, 1.8vw, 26px)/1.3 var(--f-display); letter-spacing: -0.015em; }
  .prose h2:first-child { margin-top: 0; }
  .prose p, .prose li { color: var(--text-2); font-size: 17px; line-height: 1.7; }
  .prose p { margin-top: 14px; }
  .prose ul { margin-top: 14px; padding-left: 22px; display: grid; gap: 8px; }
  .prose li::marker { color: var(--accent); }
  .prose :global(a) { color: var(--text); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 3px; }

  @media (max-width: 1000px) {
    .sx__title, .sx__intro { grid-column: 1 / -1; }
    .rows[data-cols] { --c: 2; }
    .grid[data-cols='4'] { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .grid[data-cols='4'] li:nth-child(2n + 1) { padding-left: 0; border-left: 0; }
    .steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
    .split, .text, .duo { grid-template-columns: minmax(0, 1fr); }
    /* колонки друг под другом — отдельные блоки через линию */
    .duo { gap: 0; }
    .duo > div + div { margin-top: var(--sec-y); padding-top: var(--sec-y); border-top: 1px solid var(--line); }
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stats li:nth-child(3) { padding-left: 0; border-left: 0; }
    .stats li:nth-child(n + 3) { border-top: 1px solid rgb(255 255 255 / 0.3); margin-top: 28px; }
  }
  @media (max-width: 860px) {
    .grid[data-cols] { grid-template-columns: minmax(0, 1fr); }
    .grid[data-cols] li, .grid[data-cols] li:nth-child(n) { padding: 18px 0; border-left: 0; }
  }
