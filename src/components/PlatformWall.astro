---
import Arrow from './Arrow.astro';
import { platforms, categories, categoryOrder } from '../data/platforms';

const ordered = categoryOrder.flatMap((c) => platforms.filter((p) => p.category === c));
---

<section class="pw" id="platforms" aria-labelledby="pw-title">
  <div class="wrap">
    <div class="pw__head">
      <h2 id="pw-title" class="h2">Рекламные площадки</h2>
      <p>
        Маркетплейсы, приложения, стриминг, рекламные сети и отраслевые аудитории. Разместим рекламу на&nbsp;нескольких
        площадках и&nbsp;соберём всё в&nbsp;одном медиаплане.
      </p>
    </div>
    <ul class="pw__grid">
      {
        ordered.map((p) => (
          <li>
            <a href={`/platforms/${p.slug}/`}>
              <span class="pw__name">{p.name}</span>
              <span class="pw__cat">{categories[p.category].title}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="pw__all" href="/platforms/">Все площадки <Arrow /></a>
  </div>
</section>

<style>
  .pw { border-top: 1px solid var(--line); padding-block: clamp(96px, 16vh, 180px); }
  .pw__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 20px;
    margin-bottom: clamp(40px, 7vh, 72px);
  }
  .pw__head .h2 { grid-column: 1 / span 7; }
  .pw__head p { grid-column: 8 / -1; align-self: end; color: var(--text-2); max-width: 44ch; }

  .pw__grid {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }
  .pw__grid li { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .pw__grid a {
    display: grid;
    align-content: space-between;
    gap: 28px;
    height: 100%;
    min-height: 132px;
    padding: 24px;
    transition: background-color 0.3s var(--ease);
  }
  .pw__name { font: 600 clamp(20px, 1.8vw, 26px)/1.15 var(--f-display); letter-spacing: -0.02em; transition: color 0.3s; }
  .pw__cat { color: var(--text-3); font-size: 14px; }
  .pw__grid a:hover { background: rgb(255 255 255 / 0.03); }
  .pw__grid a:hover .pw__name { color: var(--accent-hover); }

  .pw__all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 32px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--accent);
    font: 600 17px/1 var(--f-display);
  }
  .pw__all :global(svg) { width: 16px; height: 16px; transition: transform 0.3s var(--ease); }
  .pw__all:hover :global(svg) { transform: translateX(3px); }

  @media (max-width: 1000px) {
    .pw__head .h2, .pw__head p { grid-column: 1 / -1; }
    .pw__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .pw__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pw__grid a { min-height: 104px; padding: 16px; gap: 16px; }
  }
</style>
