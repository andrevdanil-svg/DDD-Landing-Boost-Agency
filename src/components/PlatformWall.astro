---
import Arrow from './Arrow.astro';
import { platforms, categories, categoryOrder } from '../data/platforms';

const groups = categoryOrder
  .map((c) => ({ ...categories[c], items: platforms.filter((p) => p.category === c) }))
  .filter((g) => g.items.length);
---

<section class="pw" id="platforms" aria-labelledby="pw-title">
  <div class="wrap">
    <div class="pw__head">
      <h2 id="pw-title" class="h2">Рекламные площадки</h2>
      <div class="pw__aside">
        <p>
          Маркетплейсы, приложения, стриминг, рекламные сети и&nbsp;отраслевые аудитории&nbsp;— в&nbsp;одном медиаплане.
        </p>
        <a class="pw__all" href="/platforms/">Все площадки <Arrow /></a>
      </div>
    </div>

    <!-- строка = категория; на телефоне названия листаются вбок -->
    <ul class="pw__rows">
      {
        groups.map((g) => (
          <li>
            <span class="pw__cat">
              <span class="pw__full">{g.title}</span>
              <span class="pw__short" aria-hidden="true">{g.short}</span>
            </span>
            <ul class="pw__names">
              {g.items.map((p) => (
                <li>
                  <a href={`/platforms/${p.slug}/`}>{p.name}</a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .pw { border-top: 1px solid var(--line); padding-block: var(--sec-y); }
  .pw__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 16px;
    margin-bottom: var(--head-gap);
  }
  .pw__head .h2 { grid-column: 1 / span 8; align-self: end; }
  .pw__aside { grid-column: 9 / -1; align-self: end; display: grid; gap: 16px; justify-items: start; }
  .pw__aside p { color: var(--text-2); max-width: 44ch; }

  .pw__rows { list-style: none; padding: 0; border-bottom: 1px solid var(--line); }
  .pw__rows > li {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    align-items: baseline;
    padding-block: clamp(10px, 2vh, 18px);
    border-top: 1px solid var(--line);
  }
  .pw__cat { grid-column: 1 / span 3; color: var(--text-3); font-size: 15px; }
  .pw__short { display: none; }
  .pw__names {
    grid-column: 4 / -1;
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px clamp(18px, 2vw, 32px);
  }
  .pw__names a {
    display: inline-block;
    font: 600 clamp(18px, min(1.6vw, 2.8vh), 24px)/1.25 var(--f-display);
    letter-spacing: -0.02em;
    transition: color 0.3s;
  }
  .pw__names a:hover { color: var(--accent-hover); }

  .pw__all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--accent);
    font: 600 17px/1 var(--f-display);
  }
  .pw__all :global(svg) { width: 16px; height: 16px; transition: transform 0.3s var(--ease); }
  .pw__all:hover :global(svg) { transform: translateX(3px); }

  @media (max-width: 1000px) {
    .pw__head .h2, .pw__aside { grid-column: 1 / -1; }
    .pw__cat { grid-column: 1 / span 4; }
    .pw__names { grid-column: 5 / -1; }
  }

  /* телефон: короткая подпись слева, названия листаются вбок */
  @media (max-width: 640px) {
    .pw__aside p { display: none; }
    .pw__rows > li { grid-template-columns: 84px minmax(0, 1fr); column-gap: 12px; padding-block: 8px; }
    .pw__cat { grid-column: 1; font-size: 13px; }
    .pw__full { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .pw__short { display: inline; }
    .pw__names {
      grid-column: 2;
      flex-wrap: nowrap;
      gap: 22px;
      overflow-x: auto;
      margin-inline: calc(var(--pad) * -1);
      padding-inline: var(--pad);
      scrollbar-width: none;
    }
    .pw__names::-webkit-scrollbar { display: none; }
    .pw__names li { flex: none; }
    .pw__names a { font-size: 18px; padding-block: 4px; }
  }
</style>
