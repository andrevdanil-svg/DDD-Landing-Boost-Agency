---
import { typo } from '../lib/typo';

// Кто мы — крупной фразой, подробности — обычным текстом в колонке удобной ширины:
// длинный абзац крупным шрифтом на весь экран читать тяжело. Цифры — на первом экране.
const statement = 'Boost! Agency — рекламное агентство в Ташкенте.';
const text =
  'Запускаем рекламу в интернете, на ТВ, радио и наружно по Узбекистану, разрабатываем сайты под трафик и считаем каждый вложенный доллар: по каждому каналу — отчёт, по digital — личный кабинет с данными в реальном времени.';
---

<section class="mf" id="about" aria-labelledby="mf-title">
  <div class="wrap mf__in">
    <h2 id="mf-title" class="mf__statement">{typo(statement)}</h2>
    <p class="mf__text">{typo(text)}</p>
  </div>
</section>

<style>
  .mf {
    border-top: 1px solid var(--line);
    padding-block: var(--sec-y);
  }
  .mf__in {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 24px;
    align-items: start;
  }
  .mf__statement {
    grid-column: 1 / span 6;
    font: 700 clamp(28px, 3.4vw, 48px)/1.08 var(--f-display);
    letter-spacing: -0.03em;
    text-wrap: balance;
    -webkit-hyphens: manual;
    hyphens: manual;
  }
  .mf__text {
    grid-column: 8 / -1;
    max-width: 60ch;
    padding-top: 0.35em;
    color: var(--text-2);
    font-size: clamp(18px, 1.4vw, 20px);
    line-height: 1.6;
  }

  @media (max-width: 860px) {
    .mf__statement, .mf__text { grid-column: 1 / -1; }
    .mf__text { padding-top: 0; }
  }
  @media (max-width: 640px) {
    .mf__text { font-size: 17px; }
  }
</style>
