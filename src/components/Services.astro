---
import Arrow from './Arrow.astro';

import { typo } from '../lib/typo';

// Группы услуг; полный список — на /services/
const services = [
  { title: 'Реклама в интернете', text: 'Медийная и контекстная реклама, соцсети, блогеры, Telegram-каналы и сайты .uz.', href: '/services/#online' },
  { title: 'ТВ, радио и наружная реклама', text: '50+ телеканалов, все радиостанции и наружная реклама по Узбекистану и СНГ.', href: '/services/#offline' },
  { title: 'Медиастратегия и аудит', text: 'Медиамикс под цель бизнеса: онлайн и офлайн в одном плане.', href: '/media-strategy/' },
  { title: 'Сайты и лендинги', text: 'Под рекламный трафик: дизайн, разработка, формы заявок и связка с CRM и аналитикой.', href: '/sites/' },
  { title: 'Пополнение кабинетов', text: 'Meta, Google, Яндекс Директ и DV360 по одному договору, зачисление в течение рабочего дня.', href: '/topup/' },
  { title: 'Самостоятельный запуск', text: 'Свой рекламный кабинет: кампания запускается за пять минут.', href: '/self-launch/' },
];
---

<section class="sv" id="services" aria-labelledby="sv-title">
  <div class="wrap">
    <div class="sv__head">
      <h2 id="sv-title" class="h2">Что делаем</h2>
      <a class="sv__all" href="/services/">Все услуги <Arrow /></a>
    </div>
    <ul class="sv__list">
      {
        services.map((s) => (
          <li>
            <a href={s.href}>
              <span class="sv__name">{typo(s.title)}</span>
              <span class="sv__text">{typo(s.text)}</span>
              <span class="sv__go" aria-hidden="true">
                <Arrow />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .sv { border-top: 1px solid var(--line); padding-block: var(--sec-y); }
  .sv__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: var(--head-gap);
  }

  /* 3×2: у каждой услуги своя колонка, разделители — только линии сверху */
  .sv__list {
    list-style: none;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--gap);
  }
  .sv__list a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto 1fr;
    column-gap: 16px;
    row-gap: 10px;
    height: 100%;
    padding-block: clamp(18px, 3vh, 28px) clamp(22px, 4vh, 40px);
    border-top: 1px solid var(--line);
    transition: border-color 0.3s var(--ease);
  }
  .sv__name {
    font: 600 clamp(21px, min(2vw, 3.6vh), 30px)/1.1 var(--f-display);
    letter-spacing: -0.025em;
    text-wrap: balance;
    transition: color 0.3s;
  }
  .sv__text { grid-column: 1; color: var(--text-2); font-size: 16px; max-width: 34ch; }
  .sv__go {
    grid-column: 2;
    grid-row: 1;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease), color 0.3s;
  }
  .sv__go :global(svg) { width: 16px; height: 16px; }

  .sv__list a:hover { border-top-color: var(--accent); }
  .sv__list a:hover .sv__go { background: var(--accent); border-color: var(--accent); color: #fff; }

  .sv__all {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex: none;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--accent);
    font: 600 17px/1 var(--f-display);
  }
  .sv__all :global(svg) { width: 16px; height: 16px; transition: transform 0.3s var(--ease); }
  .sv__all:hover :global(svg) { transform: translateX(3px); }

  @media (max-width: 1000px) {
    .sv__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* телефон: только названия — блок целиком в один экран, описание есть на странице услуги */
  @media (max-width: 640px) {
    .sv__list { grid-template-columns: minmax(0, 1fr); border-bottom: 1px solid var(--line); }
    .sv__list a { grid-template-rows: auto; align-items: center; padding-block: 14px; }
    .sv__name { font-size: 19px; }
    .sv__text { display: none; }
    .sv__go { width: 36px; height: 36px; }
    .sv__all { font-size: 15px; }
  }
</style>
