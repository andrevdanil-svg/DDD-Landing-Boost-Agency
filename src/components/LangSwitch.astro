---
interface Props {
  current?: 'ru' | 'uz' | 'en';
}
const { current = 'ru' } = Astro.props;

// Названия — так, как язык называют его носители; порядок — по аудитории
const langs = [
  { code: 'ru', label: 'Русский', href: '/', aria: 'русский' },
  { code: 'uz', label: 'Oʻzbekcha', href: '/uz/', aria: 'узбекский' },
  { code: 'en', label: 'English', href: '/en/', aria: 'английский' },
] as const;
const active = langs.find((l) => l.code === current) ?? langs[0];
---

<div class="lang" data-lang>
  <button
    class="lang__btn"
    type="button"
    aria-expanded="false"
    aria-controls="lang-list"
    aria-label={`Язык сайта: ${active.aria}. Сменить язык`}
    data-lang-btn
  >
    <svg class="lang__globe" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.3"></circle>
      <ellipse cx="8" cy="8" rx="2.6" ry="6.25" stroke="currentColor" stroke-width="1.3"></ellipse>
      <path d="M1.9 6h12.2M1.9 10h12.2" stroke="currentColor" stroke-width="1.3"></path>
    </svg>
    <span class="lang__code">{active.code.toUpperCase()}</span>
    <svg class="lang__chev" viewBox="0 0 10 6" fill="none" aria-hidden="true">
      <path d="m1 1 4 4 4-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>

  <ul class="lang__list" id="lang-list" data-lang-list>
    {
      langs.map((l) => (
        <li>
          <a href={l.href} lang={l.code} hreflang={l.code} aria-current={l.code === active.code ? 'page' : undefined}>
            <span>{l.label}</span>
            {l.code === active.code ? (
              <svg class="lang__check" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                <path d="m3.5 8.5 3 3 6-7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            ) : (
              <span class="lang__k" aria-hidden="true">{l.code.toUpperCase()}</span>
            )}
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .lang { position: relative; }

  .lang__btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 10px 0 9px;
    border-radius: 10px;
    color: var(--text-2);
    font: 500 14px/1 var(--f-text);
    letter-spacing: 0.02em;
    transition: background-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .lang__btn:hover,
  .lang[data-open] .lang__btn { background: rgb(255 255 255 / 0.06); color: var(--text); }
  .lang__globe { width: 16px; height: 16px; }
  .lang__chev { width: 10px; height: 6px; opacity: 0.7; transition: transform 0.25s var(--ease); }
  .lang[data-open] .lang__chev { transform: rotate(180deg); }

  .lang__list {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    z-index: 60;
    min-width: 200px;
    margin: 0;
    padding: 6px;
    list-style: none;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.85);
    transform-origin: top right;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px) scale(0.97);
    transition: opacity 0.18s var(--ease), transform 0.18s var(--ease), visibility 0s linear 0.18s;
  }
  .lang[data-open] .lang__list {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .lang__list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 11px 12px;
    border-radius: 9px;
    color: var(--text-2);
    font: 400 15px/1.2 var(--f-text);
    transition: background-color 0.15s, color 0.15s;
  }
  .lang__list a:hover,
  .lang__list a:focus-visible { background: rgb(255 255 255 / 0.06); color: var(--text); outline: none; }
  .lang__list a[aria-current] { color: var(--text); }
  .lang__check { width: 16px; height: 16px; color: var(--accent); flex: none; }
  .lang__k { font: 500 11px/1 var(--f-mono); color: var(--text-3); letter-spacing: 0.04em; }

  @media (max-width: 900px) {
    .lang__btn { height: 44px; padding-inline: 10px; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-lang]');
  const btn = root?.querySelector<HTMLButtonElement>('[data-lang-btn]');
  const links = root ? [...root.querySelectorAll<HTMLAnchorElement>('.lang__list a')] : [];

  const setOpen = (open: boolean, focusTarget?: HTMLElement | null) => {
    if (!root || !btn) return;
    root.toggleAttribute('data-open', open);
    btn.setAttribute('aria-expanded', String(open));
    focusTarget?.focus();
  };

  btn?.addEventListener('click', () => setOpen(!root!.hasAttribute('data-open')));

  btn?.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown') return;
    e.preventDefault();
    setOpen(true, links.find((a) => a.hasAttribute('aria-current')) ?? links[0]);
  });

  root?.addEventListener('keydown', (e) => {
    const i = links.indexOf(e.target as HTMLAnchorElement);
    if (e.key === 'Escape') setOpen(false, btn);
    else if (i >= 0 && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) {
      e.preventDefault();
      links[(i + (e.key === 'ArrowDown' ? 1 : -1) + links.length) % links.length].focus();
    }
  });

  document.addEventListener('click', (e) => {
    if (root && !root.contains(e.target as Node)) setOpen(false);
  });
  root?.addEventListener('focusout', (e) => {
    if (!root.contains(e.relatedTarget as Node)) setOpen(false);
  });
</script>
