---
import { getCollection, render } from 'astro:content';
import Page from '../../layouts/Page.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import { article, breadcrumbs, webPage } from '../../lib/schema';
import { typo } from '../../lib/typo';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const url = `/blog/${post.id.replace(/\.md$/, '')}/`;

const seoTitle = post.data.seoTitle || `${post.data.title} — блог Boost! Agency`;
const seoDescription = post.data.seoDescription || post.data.description;
const coverImage = post.data.cover?.url || '/brand/og-image.png';

const schema = [
  webPage({ title: seoTitle, description: seoDescription, url }),
  breadcrumbs([
    { name: 'Главная', url: '/' },
    { name: 'Блог', url: '/blog/' },
    { name: post.data.title, url },
  ]),
  article({
    headline: post.data.title,
    description: post.data.description,
    url,
    image: coverImage,
    datePublished: post.data.publishedAt.toISOString(),
    ...(post.data.updatedAt ? { dateModified: post.data.updatedAt.toISOString() } : {}),
    authorName: post.data.author,
  }),
];

const fmt = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<Page
  title={seoTitle}
  description={seoDescription}
  schema={schema}
  ogType="article"
  ogImage={coverImage}
>
  <article class="pt">
    <header class="pt__head wrap">
      <a class="pt__back" href="/blog/"><Arrow /> Все посты</a>
      {post.data.rubric && <span class="pt__rubric">{post.data.rubric}</span>}
      <h1 class="pt__title">{typo(post.data.title)}</h1>
      <p class="pt__lead">{typo(post.data.description)}</p>
      <p class="pt__meta">
        <time datetime={post.data.publishedAt.toISOString()}>{fmt.format(post.data.publishedAt)}</time>
        <span> · {post.data.author}</span>
      </p>
      {
        post.data.keyFigure && (
          <div class="pt__figure">
            <b>{post.data.keyFigure.value}</b>
            <span>{typo(post.data.keyFigure.caption)}</span>
          </div>
        )
      }
    </header>

    {
      post.data.cover && (
        <figure class="pt__cover wrap">
          <img src={post.data.cover.url} alt={post.data.cover.alt} loading="eager" />
        </figure>
      )
    }

    {
      post.data.highlights && post.data.highlights.length > 0 && (
        <section class="pt__hl">
          <div class="wrap">
            <h2>Главное</h2>
            <ul>{post.data.highlights.map((h) => <li>{typo(h)}</li>)}</ul>
          </div>
        </section>
      )
    }

    <section class="pt__body">
      <div class="wrap">
        <div class="prose">
          <Content />
        </div>
      </div>
    </section>

    {
      post.data.businessNote && (
        <section class="pt__note">
          <div class="wrap">
            <h2>Что это значит для рекламодателя</h2>
            <p>{typo(post.data.businessNote)}</p>
          </div>
        </section>
      )
    }
  </article>

  <CtaBand
    title="Нужна помощь с рекламой в Узбекистане? Обсудим задачу"
    secondary={{ href: '/contact/', label: 'Медиаплан за 48 часов' }}
  />
</Page>

<style>
  .pt { padding-block: clamp(32px, 6vh, 64px) 0; }
  .pt__head { display: grid; gap: 20px; max-width: 820px; }
  .pt__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-2);
    transition: color 0.2s;
    justify-self: start;
  }
  .pt__back :global(svg) { width: 16px; height: 16px; transform: rotate(180deg); }
  .pt__back:hover { color: var(--text); }
  .pt__rubric {
    justify-self: start;
    padding: 6px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    font: 600 13px/1 var(--f-display);
    letter-spacing: 0.01em;
    color: var(--text-2);
    text-transform: uppercase;
  }
  .pt__title {
    font: 700 clamp(32px, min(4.4vw, 7vh), 64px)/1.05 var(--f-display);
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .pt__lead { color: var(--text-2); font-size: clamp(17px, 1.4vw, 20px); max-width: 60ch; }
  .pt__meta { color: var(--text-3); font-size: 15px; }

  .pt__figure {
    display: inline-grid;
    gap: 6px;
    padding: 20px 24px;
    border: 1px solid var(--line);
    border-radius: 16px;
    margin-top: 12px;
    justify-self: start;
  }
  .pt__cover { margin: 24px auto 0; max-width: 1100px; }
  .pt__cover img {
    width: 100%; height: auto; max-height: 540px; object-fit: cover;
    border-radius: 20px; border: 1px solid var(--line);
    aspect-ratio: 1200 / 630; background: var(--bg-2);
  }
  .pt__figure b {
    font: 800 clamp(32px, 4vw, 56px)/1 var(--f-display);
    letter-spacing: -0.04em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .pt__figure span { color: var(--text-2); max-width: 32ch; }

  .pt__hl {
    margin-top: clamp(32px, 5vh, 64px);
    padding-block: clamp(28px, 4vh, 48px);
    border-block: 1px solid var(--line);
  }
  .pt__hl h2 { font: 600 15px/1 var(--f-display); color: var(--text-3); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 20px; }
  .pt__hl ul { list-style: none; padding: 0; display: grid; gap: 14px; max-width: 820px; }
  .pt__hl li { padding-left: 22px; position: relative; font-size: 17px; }
  .pt__hl li::before { content: ''; position: absolute; left: 0; top: 10px; width: 10px; height: 2px; background: var(--accent); }

  .pt__body { padding-block: clamp(40px, 7vh, 72px); }
  .pt__body .prose {
    max-width: 720px;
    font-size: 17px;
    line-height: 1.65;
    color: var(--text);
  }
  .pt__body .prose :global(h2) {
    margin-top: 2em;
    margin-bottom: 0.6em;
    font: 700 clamp(22px, 2.4vw, 32px)/1.2 var(--f-display);
    letter-spacing: -0.02em;
  }
  .pt__body .prose :global(h3) {
    margin-top: 1.6em;
    margin-bottom: 0.5em;
    font: 600 clamp(18px, 1.8vw, 22px)/1.3 var(--f-display);
  }
  .pt__body .prose :global(p) { margin-top: 1em; color: var(--text-2); }
  .pt__body .prose :global(p):first-child { margin-top: 0; }
  .pt__body .prose :global(ul),
  .pt__body .prose :global(ol) { margin-top: 1em; padding-left: 1.4em; color: var(--text-2); }
  .pt__body .prose :global(li) { margin-top: 0.4em; }
  .pt__body .prose :global(strong) { color: var(--text); font-weight: 600; }
  .pt__body .prose :global(a) {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 3px;
  }
  .pt__body .prose :global(blockquote) {
    margin: 1.6em 0;
    padding-left: 20px;
    border-left: 3px solid var(--accent);
    color: var(--text-2);
    font-style: italic;
  }
  .pt__body .prose :global(code) {
    font-family: var(--f-mono, 'JetBrains Mono', monospace);
    font-size: 0.92em;
    background: rgb(255 255 255 / 0.06);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .pt__note {
    padding-block: clamp(32px, 5vh, 56px);
    background: rgb(101 91 250 / 0.06);
    border-block: 1px solid var(--line);
  }
  .pt__note h2 { font: 600 15px/1 var(--f-display); color: var(--text-3); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 16px; }
  .pt__note p { max-width: 720px; font-size: 17px; line-height: 1.6; color: var(--text); }
</style>
