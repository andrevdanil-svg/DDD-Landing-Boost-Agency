---
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import BlogFilters from '../../components/BlogFilters.astro';
import BlogList from '../../components/BlogList.astro';
import { breadcrumbs, webPage } from '../../lib/schema';
import { postUrl, publishedPosts, rubricsWithPosts } from '../../lib/blog';

const posts = await publishedPosts();
const rubrics = rubricsWithPosts(posts);

const title = 'Блог Boost! Agency — реклама в Узбекистане, разборы и кейсы';
const description =
  'Блог рекламного агентства Boost! в Ташкенте: разборы изменений в Meta, Google, TikTok, Яндексе и узбекских площадках, бенчмарки по стоимости рекламы, кейсы с цифрами, инструкции для маркетологов Узбекистана.';

const schema = [
  webPage({ title, description, url: '/blog/' }),
  breadcrumbs([
    { name: 'Главная', url: '/' },
    { name: 'Блог', url: '/blog/' },
  ]),
  {
    '@type': 'Blog',
    name: 'Блог Boost! Agency',
    description,
    url: 'https://boostagency.uz/blog/',
    inLanguage: 'ru-UZ',
    blogPost: posts.map((p) => ({
      '@type': 'BlogPosting',
      headline: p.data.title,
      description: p.data.description,
      datePublished: p.data.publishedAt.toISOString(),
      url: new URL(postUrl(p), 'https://boostagency.uz').href,
    })),
  },
];
---

<Page title={title} description={description} schema={schema}>
  <PageHero
    hero={{
      title: 'Блог',
      lead: 'Что меняется в рекламе Узбекистана: платформы, инструменты, бенчмарки, кейсы, законы. Пишем о том, с чем работаем каждый день.',
    }}
  />
  <section class="bl">
    <div class="wrap">
      <BlogFilters rubrics={rubrics} total={posts.length} />
      <BlogList posts={posts} />
    </div>
  </section>
  <CtaBand
    title="Хотите получать новые посты в Telegram?"
    text="Подпишитесь на @boostagencyuz — публикуем новые разборы и бенчмарки раз в неделю."
    secondary={{ href: '/contact/', label: 'Обсудить задачу' }}
  />
</Page>

<style>
  .bl { padding-block: clamp(24px, 4vh, 48px) var(--sec-y); }
</style>
