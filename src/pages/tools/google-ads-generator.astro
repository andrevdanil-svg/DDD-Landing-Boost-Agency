<script>
  import writeXlsxFile from 'write-excel-file/browser';

  // ── автопереключение шагов демо; клик по вкладке — ручной режим и отмена автопрогресса ──
  (() => {
    const demo = document.querySelector<HTMLElement>('[data-demo]');
    if (!demo) return;
    const tabs = [...demo.querySelectorAll<HTMLButtonElement>('.demo__tab')];
    const panes = [...demo.querySelectorAll<HTMLElement>('.demo__pane')];
    const DUR = 6000;
    let active = 0;
    let auto = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let timer = 0;
    let visible = false;

    const setActive = (i: number) => {
      active = i;
      tabs.forEach((t, k) => t.setAttribute('aria-selected', String(k === i)));
      panes.forEach((p, k) => p.toggleAttribute('data-active', k === i));
    };
    const tick = () => setActive((active + 1) % panes.length);
    const sync = () => {
      window.clearInterval(timer);
      if (auto && visible) timer = window.setInterval(tick, DUR);
    };
    tabs.forEach((t, k) => t.addEventListener('click', () => { auto = false; setActive(k); sync(); }));
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: 0.3 }).observe(demo);
  })();

  type MatchType = 'broad' | 'phrase' | 'exact';
  type ParsedKey = { keyword: string; url: string; headline?: string; raw: string };

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const previewBox = document.querySelector<HTMLElement>('[data-preview-box]')!;
  const previewBody = document.querySelector<HTMLTableSectionElement>('[data-preview-body]')!;
  const previewCount = document.querySelector<HTMLElement>('[data-preview-count]')!;

  // Счётчики символов на полях заголовков/описаний.
  const bindCounters = () => {
    document.querySelectorAll<HTMLInputElement>('.ad__row input').forEach((input) => {
      const count = input.parentElement?.querySelector<HTMLElement>('.ad__count');
      if (!count) return;
      const max = Number(input.getAttribute('maxlength')) || 0;
      const upd = () => {
        count.textContent = `${input.value.length} / ${max}`;
        count.classList.toggle('is-over', input.value.length > max);
      };
      input.removeEventListener('input', upd);
      input.addEventListener('input', upd);
      upd();
    });
  };
  bindCounters();

  const addRow = (list: HTMLElement, maxlen: number, placeholder: string) => {
    const row = document.createElement('div');
    row.className = 'ad__row';
    row.innerHTML = `<input placeholder="${placeholder}" maxlength="${maxlen}" /><span class="ad__count">0 / ${maxlen}</span>`;
    list.appendChild(row);
    bindCounters();
  };

  document.querySelector('[data-add-head]')?.addEventListener('click', () => {
    const list = document.querySelector<HTMLElement>('[data-headlines]')!;
    if (list.children.length >= 15) {
      setStatus('Максимум 15 заголовков в адаптивном объявлении.', true);
      return;
    }
    addRow(list, 30, 'Ещё заголовок');
  });
  document.querySelector('[data-add-desc]')?.addEventListener('click', () => {
    const list = document.querySelector<HTMLElement>('[data-descriptions]')!;
    if (list.children.length >= 4) {
      setStatus('Максимум 4 описания в адаптивном объявлении.', true);
      return;
    }
    addRow(list, 90, 'Ещё описание');
  });

  const setStatus = (text: string, error = false) => {
    status.textContent = text;
    status.classList.toggle('is-error', error);
  };

  // Парсинг строк ключей: ключ|url|заголовок (url и заголовок опциональны).
  const parseKeywords = (raw: string): ParsedKey[] =>
    raw.split('\n')
      .map((l) => l.trim())
      .filter(Boolean)
      .map((line) => {
        const parts = line.split('|').map((p) => p.trim());
        return {
          keyword: parts[0] || '',
          url: parts[1] || '',
          headline: parts[2] || undefined,
          raw: line,
        };
      })
      .filter((p) => p.keyword);

  const getMatches = (): MatchType[] =>
    [...form.querySelectorAll<HTMLInputElement>('input[name=match]:checked')].map((i) => i.value as MatchType);

  const matchFormat = (keyword: string, type: MatchType): string => {
    if (type === 'phrase') return `"${keyword}"`;
    if (type === 'exact') return `[${keyword}]`;
    return keyword;
  };

  const matchLabel: Record<MatchType, string> = { broad: 'Broad', phrase: 'Phrase', exact: 'Exact' };

  // Макросы: [KeyWord], [Keyword], [keyword], [word1]..[word5] + их регистровые варианты.
  const applyMacros = (template: string, keyword: string): string => {
    const words = keyword.split(/\s+/).filter(Boolean);
    const capFirst = (s: string) => s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();
    const titleCase = (s: string) => s.split(/\s+/).map(capFirst).join(' ');
    return template
      .replace(/\[KeyWord\]/g, titleCase(keyword))
      .replace(/\[Keyword\]/g, capFirst(keyword))
      .replace(/\[KEYWORD\]/g, keyword.toUpperCase())
      .replace(/\[keyword\]/g, keyword.toLowerCase())
      .replace(/\[Word(\d)\]/g, (_, i) => capFirst(words[Number(i) - 1] || ''))
      .replace(/\[WORD(\d)\]/g, (_, i) => (words[Number(i) - 1] || '').toUpperCase())
      .replace(/\[word(\d)\]/g, (_, i) => (words[Number(i) - 1] || '').toLowerCase());
  };

  type AdGroupItem = {
    group: string;
    keyword: string;
    matchKeyword: string;
    match: MatchType;
    url: string;
    headlines: string[];
    descriptions: string[];
  };

  const build = (): { items: AdGroupItem[]; campaign: string; error?: string } => {
    const campaign = (form.querySelector<HTMLInputElement>('[name=campaign]')!.value).trim();
    if (!campaign) return { items: [], campaign: '', error: 'Заполните название кампании.' };

    const defaultUrl = (form.querySelector<HTMLInputElement>('[name=defaultUrl]')!.value).trim();
    const keywords = parseKeywords(form.querySelector<HTMLTextAreaElement>('[name=keywords]')!.value);
    if (!keywords.length) return { items: [], campaign, error: 'Добавьте хотя бы один ключ.' };

    const matches = getMatches();
    if (!matches.length) return { items: [], campaign, error: 'Выберите хотя бы один тип соответствия.' };

    const headlineTemplates = [...document.querySelectorAll<HTMLInputElement>('[data-headlines] input')]
      .map((i) => i.value.trim()).filter(Boolean);
    const descTemplates = [...document.querySelectorAll<HTMLInputElement>('[data-descriptions] input')]
      .map((i) => i.value.trim()).filter(Boolean);

    if (headlineTemplates.length < 3) return { items: [], campaign, error: 'Google Ads требует минимум 3 заголовка в адаптивном объявлении.' };
    if (descTemplates.length < 2) return { items: [], campaign, error: 'Нужно минимум 2 описания в адаптивном объявлении.' };

    const items: AdGroupItem[] = [];
    for (const k of keywords) {
      const url = k.url || defaultUrl;
      if (!url) return { items: [], campaign, error: `У ключа «${k.keyword}» нет URL. Укажите URL по умолчанию или в строке ключа.` };
      // Если в строке ключа задан заголовок — используем его как первый, остальные берём из шаблонов.
      const headlineRaw = k.headline ? [k.headline, ...headlineTemplates] : headlineTemplates;
      const headlines = headlineRaw.slice(0, 15).map((t) => applyMacros(t, k.keyword));
      const descriptions = descTemplates.slice(0, 4).map((t) => applyMacros(t, k.keyword));
      for (const m of matches) {
        items.push({
          group: k.keyword,
          keyword: k.keyword,
          matchKeyword: matchFormat(k.keyword, m),
          match: m,
          url,
          headlines,
          descriptions,
        });
      }
    }
    return { items, campaign };
  };

  document.querySelector<HTMLButtonElement>('[data-preview]')?.addEventListener('click', () => {
    const { items, error } = build();
    if (error) { setStatus(error, true); previewBox.hidden = true; return; }
    previewBox.hidden = false;
    previewCount.textContent = `(${items.length} ${items.length === 1 ? 'строка' : items.length < 5 ? 'строки' : 'строк'})`;
    previewBody.innerHTML = items.map((i) => `
      <tr>
        <td>${esc(i.group)}</td>
        <td>${esc(i.matchKeyword)}</td>
        <td>${matchLabel[i.match]}</td>
        <td>${i.headlines.map(esc).join('<br>')}</td>
        <td>${i.descriptions.map(esc).join('<br>')}</td>
        <td>${esc(i.url)}</td>
      </tr>`).join('');
    setStatus(`Готово к выгрузке: ${items.length} записей по ${new Set(items.map((i) => i.group)).size} группам.`);
  });

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!
  ));

  document.querySelector<HTMLButtonElement>('[data-generate]')?.addEventListener('click', async () => {
    const { items, campaign, error } = build();
    if (error) { setStatus(error, true); return; }

    // Структура XLSX, которая открывается Google Ads Editor через Import From File.
    const bold = { fontWeight: 'bold' as const };
    const campaigns: object[][] = [
      [{ value: 'Campaign', ...bold }, { value: 'Budget', ...bold }, { value: 'Budget type', ...bold }, { value: 'Networks', ...bold }, { value: 'Languages', ...bold }, { value: 'Status', ...bold }],
      [{ value: campaign }, { value: 100 }, { value: 'Daily' }, { value: 'Google Search' }, { value: 'Russian' }, { value: 'Paused' }],
    ];
    const groupSet = new Set(items.map((i) => i.group));
    const groups: object[][] = [
      [{ value: 'Campaign', ...bold }, { value: 'Ad group', ...bold }, { value: 'Max CPC', ...bold }, { value: 'Status', ...bold }],
      ...[...groupSet].map((g) => [{ value: campaign }, { value: g }, { value: 1 }, { value: 'Paused' }] as object[]),
    ];
    const kwRows: object[][] = [
      [{ value: 'Campaign', ...bold }, { value: 'Ad group', ...bold }, { value: 'Keyword', ...bold }, { value: 'Match type', ...bold }, { value: 'Status', ...bold }],
      ...items.map((i) => [
        { value: campaign },
        { value: i.group },
        { value: i.keyword },
        { value: matchLabel[i.match] },
        { value: 'Paused' },
      ] as object[]),
    ];
    const adRows: object[][] = [
      [
        { value: 'Campaign', ...bold }, { value: 'Ad group', ...bold }, { value: 'Ad type', ...bold },
        ...Array.from({ length: 15 }, (_, k) => ({ value: `Headline ${k + 1}`, ...bold })),
        ...Array.from({ length: 4 }, (_, k) => ({ value: `Description ${k + 1}`, ...bold })),
        { value: 'Final URL', ...bold }, { value: 'Status', ...bold },
      ],
      ...[...groupSet].map((g) => {
        const sample = items.find((i) => i.group === g)!;
        const row: object[] = [{ value: campaign }, { value: g }, { value: 'Responsive search ad' }];
        for (let k = 0; k < 15; k++) row.push({ value: sample.headlines[k] || '' });
        for (let k = 0; k < 4; k++) row.push({ value: sample.descriptions[k] || '' });
        row.push({ value: sample.url });
        row.push({ value: 'Paused' });
        return row;
      }),
    ];

    const date = new Date().toISOString().slice(0, 10);
    const safeName = campaign.replace(/[^\w\-а-яА-ЯёЁ]+/gu, '_').slice(0, 40) || 'campaign';
    await writeXlsxFile([
      { sheet: 'Campaigns', data: campaigns },
      { sheet: 'Ad groups', data: groups },
      { sheet: 'Keywords', data: kwRows },
      { sheet: 'Ads', data: adRows },
    ]).toFile(`google_ads_${safeName}_${date}.xlsx`);
    setStatus(`Готово: ${items.length} ключей по ${groupSet.size} группам. Проверьте XLSX и импортируйте в Google Ads Editor.`);
  });
</script>
