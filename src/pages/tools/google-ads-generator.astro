---
import Page from '../../layouts/Page.astro';
import { toolBySlug, toolUrl } from '../../data/tools';
import { breadcrumbs, webPage, webApplication } from '../../lib/schema';
import { typo } from '../../lib/typo';

const tool = toolBySlug('google-ads-generator')!;
const url = toolUrl(tool.slug);

const schema = [
  webPage({ title: tool.name, description: tool.description, url }),
  breadcrumbs([
    { name: 'Главная', url: '/' },
    { name: 'Инструменты', url: '/tools/' },
    { name: tool.short, url },
  ]),
  webApplication({
    name: tool.name,
    description: tool.description,
    url,
    applicationCategory: 'BusinessApplication',
    featureList: [
      'Один ключ — одна группа объявлений',
      'Широкое, фразовое, точное соответствие',
      'Макросы [KeyWord], [Keyword], [keyword] и [word1]..[word5]',
      'До 15 заголовков и 4 описаний на объявление',
      'Экспорт XLSX с листами Campaigns, Ad groups, Keywords, Ads',
    ],
  }),
];

const defaultKeywords = `купить ламинат|https://example.uz/laminat|Купить ламинат в Ташкенте
доставка ламината||
ламинат на кухню`;
---

<Page title={tool.name} description={tool.description} schema={schema}>
  <section class="tool-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/tools/">Инструменты</a>
        <span aria-hidden="true">·</span>
        <span>{tool.short}</span>
      </nav>
      <h1>{typo(tool.name)}</h1>
      <p class="tool-head__lead">{typo(tool.lead)}</p>
    </div>
  </section>

  <section class="tool-body" aria-labelledby="gads-form-title">
    <div class="wrap">
      <h2 id="gads-form-title" class="sr-only">Форма генератора</h2>

      <form class="gads" novalidate data-form>
        <div class="field">
          <label for="g-campaign">Название кампании <sup>*</sup></label>
          <input id="g-campaign" name="campaign" required placeholder="Ламинат | Поиск | Ташкент" autocomplete="off" />
          <p class="field__hint">Если импортируете в существующую кампанию — скопируйте её точное название сюда.</p>
        </div>

        <div class="field">
          <label for="g-url">Конечный URL (по умолчанию)</label>
          <input id="g-url" name="defaultUrl" type="url" placeholder="https://example.uz/" autocomplete="off" />
          <p class="field__hint">Будет использован для всех ключей, где URL не указан в строке через <code>|</code>.</p>
        </div>

        <div class="field">
          <label for="g-keywords">Ключевые слова <sup>*</sup></label>
          <textarea id="g-keywords" name="keywords" rows="6" required
            placeholder="По одному ключу на строку. Формат: ключ|url|заголовок1 (url и заголовок — опционально)">{defaultKeywords}</textarea>
          <p class="field__hint">
            <strong>Пример:</strong> <code>ламинат|https://example.uz/laminat|Купить ламинат в Ташкенте</code>.
            Если URL не нужен, оставьте пусто: <code>ключ||заголовок</code>. Для только URL: <code>ключ|url</code>.
          </p>
        </div>

        <fieldset class="matchset">
          <legend>Типы соответствия</legend>
          <label><input type="checkbox" name="match" value="broad" /> Широкое <code>keyword</code></label>
          <label><input type="checkbox" name="match" value="phrase" checked /> Фразовое <code>"keyword"</code></label>
          <label><input type="checkbox" name="match" value="exact" checked /> Точное <code>[keyword]</code></label>
          <p class="matchset__hint">Если отмечено несколько — для каждого ключа создадутся несколько записей.</p>
        </fieldset>

        <div class="ad">
          <h3>Адаптивное объявление</h3>
          <p class="ad__hint">
            До 15 заголовков (30 знаков) и 4 описаний (90 знаков). Макросы:
            <code>[KeyWord]</code>, <code>[Keyword]</code>, <code>[keyword]</code> подставляют сам ключ в выбранном регистре,
            <code>[word1]</code>…<code>[word5]</code> — N-е слово ключа.
          </p>
          <h4>Заголовки</h4>
          <div class="ad__list" data-headlines>
            <div class="ad__row"><input placeholder="[KeyWord] в Ташкенте — скидка 20%" maxlength="30" /><span class="ad__count">0 / 30</span></div>
            <div class="ad__row"><input placeholder="Купить [keyword] с доставкой" maxlength="30" /><span class="ad__count">0 / 30</span></div>
            <div class="ad__row"><input placeholder="[Word1] у официального дилера" maxlength="30" /><span class="ad__count">0 / 30</span></div>
          </div>
          <button type="button" class="btn btn--ghost btn--sm" data-add-head>+ Заголовок</button>

          <h4>Описания</h4>
          <div class="ad__list" data-descriptions>
            <div class="ad__row"><input placeholder="Низкие цены на [keyword]. Доставка по Узбекистану. Гарантия." maxlength="90" /><span class="ad__count">0 / 90</span></div>
            <div class="ad__row"><input placeholder="Шоурум в Ташкенте. Запишитесь на бесплатный замер." maxlength="90" /><span class="ad__count">0 / 90</span></div>
          </div>
          <button type="button" class="btn btn--ghost btn--sm" data-add-desc>+ Описание</button>
        </div>

        <div class="actions">
          <button type="button" class="btn btn--primary" data-generate>Сгенерировать и скачать XLSX</button>
          <button type="button" class="btn btn--ghost" data-preview>Показать превью</button>
        </div>
        <p class="actions__hint" aria-live="polite" data-status></p>

        <div class="preview" hidden data-preview-box>
          <h3>Превью <span data-preview-count></span></h3>
          <div class="preview__wrap">
            <table class="preview__table">
              <thead>
                <tr><th>Группа</th><th>Ключ</th><th>Тип</th><th>Заголовки</th><th>Описания</th><th>URL</th></tr>
              </thead>
              <tbody data-preview-body></tbody>
            </table>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section class="tool-about">
    <div class="wrap tool-about__in">
      <h2>Что делает инструмент</h2>
      <p>{typo(tool.about)}</p>
      <h3>Макросы заголовков</h3>
      <dl class="defs">
        <dt>[KeyWord]</dt><dd>подставляет ключ как есть, но первая буква каждого слова — с заглавной.</dd>
        <dt>[Keyword]</dt><dd>только первая буква ключа — с заглавной, остальные — как в исходнике.</dd>
        <dt>[keyword]</dt><dd>ключ в нижнем регистре.</dd>
        <dt>[word1]..[word5]</dt><dd>N-е слово ключа. Варианты <code>[Word1]</code> и <code>[WORD1]</code> — с капитализацией.</dd>
      </dl>
      <h3>Как импортировать в Google Ads Editor</h3>
      <ol class="steps">
        <li>Откройте Google Ads Editor и выберите нужный аккаунт.</li>
        <li>«Аккаунт» → «Импорт» → «Из файла» → выбрать скачанный XLSX.</li>
        <li>Редактор покажет диалог с правилами маппинга полей — подтвердите.</li>
        <li>Проверьте предпросмотр и опубликуйте изменения.</li>
      </ol>
    </div>
  </section>
</Page>

<style>
  .tool-head { padding-block: clamp(40px, 7vh, 80px) clamp(28px, 5vh, 48px); }
  .crumbs { display: flex; gap: 10px; align-items: center; color: var(--text-3); font-size: 14px; margin-bottom: 20px; }
  .crumbs a { color: var(--text-2); transition: color 0.2s; }
  .crumbs a:hover { color: var(--text); }
  .tool-head h1 { font: 700 clamp(32px, 4.4vw, 56px)/1.05 var(--f-display); letter-spacing: -0.03em; text-wrap: balance; max-width: 20ch; }
  .tool-head__lead { max-width: 60ch; margin-top: 20px; color: var(--text-2); font-size: clamp(16px, 1.3vw, 19px); }

  .tool-body { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 72px); }

  .gads { display: grid; gap: 24px; }
  .field { display: grid; gap: 8px; min-width: 0; }
  .field label { font: 500 15px/1.3 var(--f-display); color: var(--text); }
  .field label sup { color: var(--accent); font-size: 14px; vertical-align: top; }
  .field input, .field textarea {
    width: 100%;
    padding: 10px 14px;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    color: var(--text);
    font: inherit;
    transition: border-color 0.2s;
  }
  .field input { min-height: 44px; }
  .field textarea { font-family: ui-monospace, Menlo, monospace; font-size: 14px; line-height: 1.5; min-height: 140px; resize: vertical; }
  .field input:focus, .field textarea:focus { outline: none; border-color: var(--accent); }
  .field__hint { color: var(--text-3); font-size: 13px; line-height: 1.5; }
  .field__hint code { background: var(--bg-raised); padding: 2px 6px; border-radius: 4px; font-size: 12.5px; color: var(--text-2); }

  .matchset { display: grid; gap: 10px; border: 0; padding: 0; margin: 0; }
  .matchset legend { padding: 0; font: 500 15px/1.3 var(--f-display); color: var(--text); margin-bottom: 2px; }
  .matchset label { display: inline-flex; gap: 10px; align-items: center; color: var(--text); font-size: 15px; }
  .matchset label code { background: var(--bg-raised); padding: 2px 6px; border-radius: 4px; font-size: 12.5px; color: var(--text-2); }
  .matchset input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--accent); }
  .matchset__hint { color: var(--text-3); font-size: 13px; }

  .ad { display: grid; gap: 14px; padding: 20px; border: 1px solid var(--line); border-radius: 14px; }
  .ad h3 { font: 600 17px/1.2 var(--f-display); }
  .ad h4 { font: 500 14px/1.2 var(--f-display); color: var(--text-2); margin-top: 6px; }
  .ad__hint { color: var(--text-3); font-size: 13px; line-height: 1.6; }
  .ad__hint code { background: var(--bg-raised); padding: 1px 6px; border-radius: 4px; font-size: 12.5px; color: var(--text-2); }
  .ad__list { display: grid; gap: 8px; }
  .ad__row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: center; }
  .ad__row input {
    width: 100%; min-height: 40px; padding: 8px 12px;
    background: var(--bg-raised); border: 1px solid var(--line-strong); border-radius: 8px;
    color: var(--text); font: inherit; font-size: 14px;
  }
  .ad__row input:focus { outline: none; border-color: var(--accent); }
  .ad__count { color: var(--text-3); font-size: 12.5px; font-variant-numeric: tabular-nums; min-width: 56px; text-align: right; }
  .ad__count.is-over { color: var(--coral); }
  .ad > .btn { justify-self: start; }

  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .actions__hint { color: var(--green); font-size: 14px; min-height: 1em; }
  .actions__hint.is-error { color: var(--coral); }

  .preview { padding-top: 24px; border-top: 1px solid var(--line); }
  .preview h3 { font: 600 18px/1.2 var(--f-display); margin-bottom: 12px; }
  .preview h3 span { color: var(--text-3); font-weight: 400; font-size: 14px; margin-left: 10px; }
  .preview__wrap { overflow-x: auto; }
  .preview__table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .preview__table th, .preview__table td { padding: 8px 10px; text-align: left; border-bottom: 1px solid var(--line); vertical-align: top; }
  .preview__table th { color: var(--text-3); font-weight: 400; font-size: 12.5px; }
  .preview__table td { color: var(--text-2); max-width: 240px; }
  .preview__table td:nth-child(2) { color: var(--text); }

  .tool-about { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 80px); }
  .tool-about__in { max-width: 72ch; display: grid; gap: 20px; }
  .tool-about h2 { font: 600 clamp(22px, 2.4vw, 32px)/1.15 var(--f-display); letter-spacing: -0.02em; }
  .tool-about h3 { font: 600 18px/1.2 var(--f-display); margin-top: 20px; }
  .tool-about p { color: var(--text-2); line-height: 1.6; }
  .defs { display: grid; grid-template-columns: 140px 1fr; gap: 10px 20px; color: var(--text-2); }
  .defs dt { font-family: ui-monospace, Menlo, monospace; color: var(--text); font-size: 14px; }
  .defs code { background: var(--bg-raised); padding: 1px 6px; border-radius: 4px; font-size: 12.5px; color: var(--text-2); }
  .steps { padding-left: 20px; color: var(--text-2); line-height: 1.6; display: grid; gap: 4px; }

  @media (max-width: 640px) {
    .defs { grid-template-columns: 1fr; gap: 2px 0; }
    .defs dt { margin-top: 10px; }
  }
</style>

<script>
  import writeXlsxFile from 'write-excel-file/browser';

  type MatchType = 'broad' | 'phrase' | 'exact';
  type ParsedKey = { keyword: string; url: string; headline?: string; raw: string };

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const previewBox = document.querySelector<HTMLElement>('[data-preview-box]')!;
  const previewBody = document.querySelector<HTMLTableSectionElement>('[data-preview-body]')!;
  const previewCount = document.querySelector<HTMLElement>('[data-preview-count]')!;

  // Счётчики символов на полях заголовков/описаний.
  const bindCounters = () => {
    document.querySelectorAll<HTMLInputElement>('.ad__row input').forEach((input) => {
      const count = input.parentElement?.querySelector<HTMLElement>('.ad__count');
      if (!count) return;
      const max = Number(input.getAttribute('maxlength')) || 0;
      const upd = () => {
        count.textContent = `${input.value.length} / ${max}`;
        count.classList.toggle('is-over', input.value.length > max);
      };
      input.removeEventListener('input', upd);
      input.addEventListener('input', upd);
      upd();
    });
  };
  bindCounters();

  const addRow = (list: HTMLElement, maxlen: number, placeholder: string) => {
    const row = document.createElement('div');
    row.className = 'ad__row';
    row.innerHTML = `<input placeholder="${placeholder}" maxlength="${maxlen}" /><span class="ad__count">0 / ${maxlen}</span>`;
    list.appendChild(row);
    bindCounters();
  };

  document.querySelector('[data-add-head]')?.addEventListener('click', () => {
    const list = document.querySelector<HTMLElement>('[data-headlines]')!;
    if (list.children.length >= 15) {
      setStatus('Максимум 15 заголовков в адаптивном объявлении.', true);
      return;
    }
    addRow(list, 30, 'Ещё заголовок');
  });
  document.querySelector('[data-add-desc]')?.addEventListener('click', () => {
    const list = document.querySelector<HTMLElement>('[data-descriptions]')!;
    if (list.children.length >= 4) {
      setStatus('Максимум 4 описания в адаптивном объявлении.', true);
      return;
    }
    addRow(list, 90, 'Ещё описание');
  });

  const setStatus = (text: string, error = false) => {
    status.textContent = text;
    status.classList.toggle('is-error', error);
  };

  // Парсинг строк ключей: ключ|url|заголовок (url и заголовок опциональны).
  const parseKeywords = (raw: string): ParsedKey[] =>
    raw.split('\n')
      .map((l) => l.trim())
      .filter(Boolean)
      .map((line) => {
        const parts = line.split('|').map((p) => p.trim());
        return {
          keyword: parts[0] || '',
          url: parts[1] || '',
          headline: parts[2] || undefined,
          raw: line,
        };
      })
      .filter((p) => p.keyword);

  const getMatches = (): MatchType[] =>
    [...form.querySelectorAll<HTMLInputElement>('input[name=match]:checked')].map((i) => i.value as MatchType);

  const matchFormat = (keyword: string, type: MatchType): string => {
    if (type === 'phrase') return `"${keyword}"`;
    if (type === 'exact') return `[${keyword}]`;
    return keyword;
  };

  const matchLabel: Record<MatchType, string> = { broad: 'Broad', phrase: 'Phrase', exact: 'Exact' };

  // Макросы: [KeyWord], [Keyword], [keyword], [word1]..[word5] + их регистровые варианты.
  const applyMacros = (template: string, keyword: string): string => {
    const words = keyword.split(/\s+/).filter(Boolean);
    const capFirst = (s: string) => s.charAt(0).toUpperCase() + s.slice(1).toLowerCase();
    const titleCase = (s: string) => s.split(/\s+/).map(capFirst).join(' ');
    return template
      .replace(/\[KeyWord\]/g, titleCase(keyword))
      .replace(/\[Keyword\]/g, capFirst(keyword))
      .replace(/\[KEYWORD\]/g, keyword.toUpperCase())
      .replace(/\[keyword\]/g, keyword.toLowerCase())
      .replace(/\[Word(\d)\]/g, (_, i) => capFirst(words[Number(i) - 1] || ''))
      .replace(/\[WORD(\d)\]/g, (_, i) => (words[Number(i) - 1] || '').toUpperCase())
      .replace(/\[word(\d)\]/g, (_, i) => (words[Number(i) - 1] || '').toLowerCase());
  };

  type AdGroupItem = {
    group: string;
    keyword: string;
    matchKeyword: string;
    match: MatchType;
    url: string;
    headlines: string[];
    descriptions: string[];
  };

  const build = (): { items: AdGroupItem[]; campaign: string; error?: string } => {
    const campaign = (form.querySelector<HTMLInputElement>('[name=campaign]')!.value).trim();
    if (!campaign) return { items: [], campaign: '', error: 'Заполните название кампании.' };

    const defaultUrl = (form.querySelector<HTMLInputElement>('[name=defaultUrl]')!.value).trim();
    const keywords = parseKeywords(form.querySelector<HTMLTextAreaElement>('[name=keywords]')!.value);
    if (!keywords.length) return { items: [], campaign, error: 'Добавьте хотя бы один ключ.' };

    const matches = getMatches();
    if (!matches.length) return { items: [], campaign, error: 'Выберите хотя бы один тип соответствия.' };

    const headlineTemplates = [...document.querySelectorAll<HTMLInputElement>('[data-headlines] input')]
      .map((i) => i.value.trim()).filter(Boolean);
    const descTemplates = [...document.querySelectorAll<HTMLInputElement>('[data-descriptions] input')]
      .map((i) => i.value.trim()).filter(Boolean);

    if (headlineTemplates.length < 3) return { items: [], campaign, error: 'Google Ads требует минимум 3 заголовка в адаптивном объявлении.' };
    if (descTemplates.length < 2) return { items: [], campaign, error: 'Нужно минимум 2 описания в адаптивном объявлении.' };

    const items: AdGroupItem[] = [];
    for (const k of keywords) {
      const url = k.url || defaultUrl;
      if (!url) return { items: [], campaign, error: `У ключа «${k.keyword}» нет URL. Укажите URL по умолчанию или в строке ключа.` };
      // Если в строке ключа задан заголовок — используем его как первый, остальные берём из шаблонов.
      const headlineRaw = k.headline ? [k.headline, ...headlineTemplates] : headlineTemplates;
      const headlines = headlineRaw.slice(0, 15).map((t) => applyMacros(t, k.keyword));
      const descriptions = descTemplates.slice(0, 4).map((t) => applyMacros(t, k.keyword));
      for (const m of matches) {
        items.push({
          group: k.keyword,
          keyword: k.keyword,
          matchKeyword: matchFormat(k.keyword, m),
          match: m,
          url,
          headlines,
          descriptions,
        });
      }
    }
    return { items, campaign };
  };

  document.querySelector<HTMLButtonElement>('[data-preview]')?.addEventListener('click', () => {
    const { items, error } = build();
    if (error) { setStatus(error, true); previewBox.hidden = true; return; }
    previewBox.hidden = false;
    previewCount.textContent = `(${items.length} ${items.length === 1 ? 'строка' : items.length < 5 ? 'строки' : 'строк'})`;
    previewBody.innerHTML = items.map((i) => `
      <tr>
        <td>${esc(i.group)}</td>
        <td>${esc(i.matchKeyword)}</td>
        <td>${matchLabel[i.match]}</td>
        <td>${i.headlines.map(esc).join('<br>')}</td>
        <td>${i.descriptions.map(esc).join('<br>')}</td>
        <td>${esc(i.url)}</td>
      </tr>`).join('');
    setStatus(`Готово к выгрузке: ${items.length} записей по ${new Set(items.map((i) => i.group)).size} группам.`);
  });

  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => (
    { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!
  ));

  document.querySelector<HTMLButtonElement>('[data-generate]')?.addEventListener('click', async () => {
    const { items, campaign, error } = build();
    if (error) { setStatus(error, true); return; }

    // Структура XLSX, которая открывается Google Ads Editor через Import From File.
    const bold = { fontWeight: 'bold' as const };
    const campaigns: object[][] = [
      [{ value: 'Campaign', ...bold }, { value: 'Budget', ...bold }, { value: 'Budget type', ...bold }, { value: 'Networks', ...bold }, { value: 'Languages', ...bold }, { value: 'Status', ...bold }],
      [{ value: campaign }, { value: 100 }, { value: 'Daily' }, { value: 'Google Search' }, { value: 'Russian' }, { value: 'Paused' }],
    ];
    const groupSet = new Set(items.map((i) => i.group));
    const groups: object[][] = [
      [{ value: 'Campaign', ...bold }, { value: 'Ad group', ...bold }, { value: 'Max CPC', ...bold }, { value: 'Status', ...bold }],
      ...[...groupSet].map((g) => [{ value: campaign }, { value: g }, { value: 1 }, { value: 'Paused' }] as object[]),
    ];
    const kwRows: object[][] = [
      [{ value: 'Campaign', ...bold }, { value: 'Ad group', ...bold }, { value: 'Keyword', ...bold }, { value: 'Match type', ...bold }, { value: 'Status', ...bold }],
      ...items.map((i) => [
        { value: campaign },
        { value: i.group },
        { value: i.keyword },
        { value: matchLabel[i.match] },
        { value: 'Paused' },
      ] as object[]),
    ];
    const adRows: object[][] = [
      [
        { value: 'Campaign', ...bold }, { value: 'Ad group', ...bold }, { value: 'Ad type', ...bold },
        ...Array.from({ length: 15 }, (_, k) => ({ value: `Headline ${k + 1}`, ...bold })),
        ...Array.from({ length: 4 }, (_, k) => ({ value: `Description ${k + 1}`, ...bold })),
        { value: 'Final URL', ...bold }, { value: 'Status', ...bold },
      ],
      ...[...groupSet].map((g) => {
        const sample = items.find((i) => i.group === g)!;
        const row: object[] = [{ value: campaign }, { value: g }, { value: 'Responsive search ad' }];
        for (let k = 0; k < 15; k++) row.push({ value: sample.headlines[k] || '' });
        for (let k = 0; k < 4; k++) row.push({ value: sample.descriptions[k] || '' });
        row.push({ value: sample.url });
        row.push({ value: 'Paused' });
        return row;
      }),
    ];

    const date = new Date().toISOString().slice(0, 10);
    const safeName = campaign.replace(/[^\w\-а-яА-ЯёЁ]+/gu, '_').slice(0, 40) || 'campaign';
    await writeXlsxFile([
      { sheet: 'Campaigns', data: campaigns },
      { sheet: 'Ad groups', data: groups },
      { sheet: 'Keywords', data: kwRows },
      { sheet: 'Ads', data: adRows },
    ]).toFile(`google_ads_${safeName}_${date}.xlsx`);
    setStatus(`Готово: ${items.length} ключей по ${groupSet.size} группам. Проверьте XLSX и импортируйте в Google Ads Editor.`);
  });
</script>
