---
import Page from '../../layouts/Page.astro';
import { toolBySlug, toolUrl } from '../../data/tools';
import { breadcrumbs, webPage, webApplication } from '../../lib/schema';
import { typo } from '../../lib/typo';

const tool = toolBySlug('stats-calc')!;
const url = toolUrl(tool.slug);

const schema = [
  webPage({ title: tool.name, description: tool.description, url }),
  breadcrumbs([
    { name: 'Главная', url: '/' },
    { name: 'Инструменты', url: '/tools/' },
    { name: tool.short, url },
  ]),
  webApplication({
    name: tool.name,
    description: tool.description,
    url,
    applicationCategory: 'BusinessApplication',
    featureList: [
      'Доверительные интервалы 70, 80, 90, 95, 99%',
      'Метод Wilson score interval',
      'A/B-сравнение двух вариантов',
      'Расчёт p-value для разницы конверсий',
    ],
  }),
];
---

<Page title={tool.name} description={tool.description} schema={schema}>
  <section class="tool-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/tools/">Инструменты</a>
        <span aria-hidden="true">·</span>
        <span>{tool.short}</span>
      </nav>
      <h1>{typo(tool.name)}</h1>
      <p class="tool-head__lead">{typo(tool.lead)}</p>
    </div>
  </section>

  <section class="how" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title">Что показывает калькулятор</h2>
      <p class="how__tldr">
        <b>Коротко:</b> ввели клики и конверсии — получили не только процент, а <b>диапазон, в котором
        настоящий процент конверсии живёт с нужной вероятностью</b>. Для А/Б — узнаете, можно ли уже
        делать выводы, или надо ещё данных.
      </p>

      <div class="scheme">
        <div class="scheme__wrap">
        <svg viewBox="0 0 700 240" preserveAspectRatio="xMidYMid meet" aria-hidden="true" class="scheme__svg">
          <rect x="0" y="0" width="700" height="240" rx="14" fill="var(--bg-app)" />
          <text x="24" y="34" fill="var(--text-2)" font-size="14" font-family="var(--f-display)">1 000 кликов, 50 конверсий — конверсия 5%</text>
          <text x="24" y="56" fill="var(--text-3)" font-size="12" font-family="var(--f-display)">настоящая конверсия с вероятностью 95% лежит где-то здесь:</text>
          <!-- Горизонтальная шкала 0..10% -->
          <line x1="40" y1="130" x2="660" y2="130" stroke="var(--line)" stroke-width="1" />
          <g font-size="11" fill="var(--text-3)" font-family="ui-monospace, Menlo, monospace">
            <text x="40" y="156" text-anchor="middle">0%</text>
            <text x="194" y="156" text-anchor="middle">2.5%</text>
            <text x="350" y="156" text-anchor="middle">5%</text>
            <text x="506" y="156" text-anchor="middle">7.5%</text>
            <text x="660" y="156" text-anchor="middle">10%</text>
          </g>
          <!-- Доверительный интервал 3.81..6.53 -->
          <rect x="275" y="100" width="170" height="60" rx="8" fill="var(--accent)" fill-opacity="0.25" />
          <line x1="350" y1="100" x2="350" y2="160" stroke="var(--text)" stroke-width="2" />
          <text x="350" y="94" text-anchor="middle" fill="var(--text)" font-size="13" font-family="var(--f-display)" font-weight="600">5.00%</text>
          <text x="275" y="186" text-anchor="middle" fill="var(--accent-hover)" font-size="12" font-family="ui-monospace, Menlo, monospace">3.81%</text>
          <text x="445" y="186" text-anchor="middle" fill="var(--accent-hover)" font-size="12" font-family="ui-monospace, Menlo, monospace">6.53%</text>
          <text x="350" y="214" text-anchor="middle" fill="var(--text-2)" font-size="12" font-family="var(--f-display)">диапазон доверительного интервала</text>
        </svg>
        </div>
        <p class="scheme__caption">
          Чем больше кликов — тем уже диапазон, тем ближе к «настоящей» конверсии. Калькулятор
          считает интервалы на 70, 80, 90, 95 и 99% по методу Wilson, который работает даже при
          малой выборке и крайних значениях процента (например, 0% или 100%).
        </p>
      </div>
    </div>
  </section>

  <section class="tool-body">
    <div class="wrap">
      <div class="modeset" role="tablist" aria-label="Режим расчёта">
        <button type="button" role="tab" aria-selected="true" data-mode="one">Один вариант</button>
        <button type="button" role="tab" aria-selected="false" data-mode="ab">A/B сравнение</button>
      </div>

      <form class="stats" novalidate data-form>
        <!-- Один вариант -->
        <div class="pane" data-pane="one" data-active>
          <div class="grid-2">
            <div class="field">
              <label for="s-clicks">Клики (или показы)</label>
              <input id="s-clicks" name="clicks" type="number" inputmode="numeric" min="1" step="1" placeholder="1000" />
              <p class="field__hint">Размер выборки. Для CTR вместо кликов — показы.</p>
            </div>
            <div class="field">
              <label for="s-conv">Конверсии (или клики)</label>
              <input id="s-conv" name="conversions" type="number" inputmode="numeric" min="0" step="1" placeholder="50" />
              <p class="field__hint">Положительные события. Для CTR — клики.</p>
            </div>
          </div>
          <p class="or">— или —</p>
          <div class="field">
            <label for="s-cr">Коэффициент конверсии, %</label>
            <input id="s-cr" name="cr" type="number" inputmode="decimal" min="0" max="100" step="0.01" placeholder="5" />
            <p class="field__hint">Если заполнили клики — поле считается само; можно задать и вручную при известном CR.</p>
          </div>
        </div>

        <!-- A/B -->
        <div class="pane" data-pane="ab">
          <div class="ab">
            <div class="ab__col">
              <h3>Вариант A</h3>
              <div class="field"><label>Клики</label><input name="aClicks" type="number" inputmode="numeric" min="1" step="1" placeholder="1000" /></div>
              <div class="field"><label>Конверсии</label><input name="aConv" type="number" inputmode="numeric" min="0" step="1" placeholder="40" /></div>
            </div>
            <div class="ab__col">
              <h3>Вариант B</h3>
              <div class="field"><label>Клики</label><input name="bClicks" type="number" inputmode="numeric" min="1" step="1" placeholder="1000" /></div>
              <div class="field"><label>Конверсии</label><input name="bConv" type="number" inputmode="numeric" min="0" step="1" placeholder="60" /></div>
            </div>
          </div>
          <p class="field__hint ab__hint">p-value считается двухвыборочным z-тестом разности пропорций. Разница считается значимой при p &lt; 0.05.</p>
        </div>
      </form>

      <section class="result" aria-live="polite" data-result>
        <h2 data-result-title>Введите данные для расчёта</h2>
        <div data-result-body></div>
      </section>
    </div>
  </section>

  <section class="tool-about">
    <div class="wrap tool-about__in">
      <h2>Подробная инструкция</h2>

      <details open class="guide">
        <summary><h3>Зачем вообще считать доверительный интервал</h3></summary>
        <p>
          Допустим, вы запустили кампанию, собрали 100 кликов и получили 5 конверсий. Конверсия — 5%.
          Но это за один раз. Если бы те же 100 кликов пришли в другой день, конверсий могло быть
          3, 7 или 10. Что из этого «настоящая» конверсия вашей связки?
        </p>
        <p>
          <b>Доверительный интервал</b> — это диапазон, в который попадает настоящий процент конверсии
          с заданной вероятностью. При 100 кликах с 5 конверсиями он широкий: от 2% до 11% на уровне 95%.
          При 10 000 кликов и той же конверсии — узкий: от 4.6% до 5.4%. Чем больше выборка — тем
          увереннее можно говорить о цифрах.
        </p>
      </details>

      <details class="guide">
        <summary><h3>Режим «Один вариант» — для оценки одной связки</h3></summary>
        <ol>
          <li><b>Клики</b> — размер выборки. Вместо кликов можно вводить <b>показы</b> — тогда калькулятор посчитает интервал для CTR.</li>
          <li><b>Конверсии</b> — положительные события. Для CTR — <b>клики</b>.</li>
          <li>Либо введите <b>коэффициент конверсии в процентах</b> напрямую — калькулятор посчитает число конверсий сам.</li>
          <li>Внизу — таблица с границами интервала на 5 уровнях уверенности. Чем выше процент — тем шире границы (мы требуем больше гарантий — приходится допускать больший диапазон).</li>
        </ol>
        <p><b>Пример:</b> 500 кликов, 25 конверсий — конверсия 5%. 95%-й интервал: 3.4%…7.3%. Значит реальная конверсия почти наверняка в этом диапазоне.</p>
      </details>

      <details class="guide">
        <summary><h3>Режим «A/B сравнение» — когда объявлять победителя</h3></summary>
        <p>
          Запустили два варианта креатива или две посадочных страницы. У A — 40 конверсий на 1000 кликов (4%),
          у B — 60 на 1000 (6%). B выглядит лучше, но вопрос: это <b>реальное</b> преимущество или просто
          случайность выборки?
        </p>
        <ol>
          <li>Вводим клики и конверсии для <b>A</b> и для <b>B</b>.</li>
          <li>Калькулятор считает <b>p-value</b> — вероятность получить такую разницу, если на самом деле варианты одинаковы.</li>
          <li>Если <b>p &lt; 0.05</b> — считаем разницу значимой. Говорим «B выиграл» и переносим бюджет на B.</li>
          <li>Если p больше — <b>нужны ещё данные</b>. Либо накатите ещё одной недели трафика, либо примите, что разница недостаточна для вывода.</li>
        </ol>
        <p><b>Внимание:</b> не останавливайте тест при первом же «p &lt; 0.05» — это классическая ошибка (peeking). Заложите количество данных заранее и ждите до конца.</p>
      </details>

      <details class="guide">
        <summary><h3>Какой уровень доверия выбрать</h3></summary>
        <dl class="defs">
          <dt>70%</dt><dd>грубая оценка — чуть надёжнее монетки. Для раннего мониторинга и быстрых решений.</dd>
          <dt>80%</dt><dd>подходит для бизнес-аналитики, когда цена ошибки невысока.</dd>
          <dt>90%</dt><dd>рабочий стандарт для внутренних A/B с ограниченной выборкой.</dd>
          <dt>95%</dt><dd>стандартный научный уровень. <code>p &lt; 0.05</code> — классическая граница «статистически значимо».</dd>
          <dt>99%</dt><dd>для критичных решений: ценообразование, безопасность, финансы.</dd>
        </dl>
      </details>

      <details class="guide">
        <summary><h3>Почему Wilson, а не классическая формула</h3></summary>
        <p>
          Классическая формула доверительного интервала для доли — <code>p ± z·√(p(1-p)/n)</code>.
          Проблема: при p близких к 0 или 100% границы вылезают за пределы 0..100 (отрицательная конверсия
          или больше 100%). При малой выборке даёт заниженные интервалы — то есть вы думаете, что цифры
          надёжнее, чем на самом деле.
        </p>
        <p>
          <b>Wilson score interval</b> — альтернатива, которая всегда остаётся внутри 0..100 и работает
          корректно даже при 10 кликах. Это стандарт в scipy, R, statsmodels. При больших выборках
          (от 1000+) разница с классической формулой минимальна — но на малых цифрах Wilson гораздо честнее.
        </p>
      </details>
    </div>
  </section>
</Page>

<style>
  .tool-head { padding-block: clamp(40px, 7vh, 80px) clamp(28px, 5vh, 48px); }
  .crumbs { display: flex; gap: 10px; align-items: center; color: var(--text-3); font-size: 14px; margin-bottom: 20px; }
  .crumbs a { color: var(--text-2); transition: color 0.2s; }
  .crumbs a:hover { color: var(--text); }
  .tool-head h1 { font: 700 clamp(32px, 4.4vw, 56px)/1.05 var(--f-display); letter-spacing: -0.03em; text-wrap: balance; max-width: 20ch; }
  .tool-head__lead { max-width: 60ch; margin-top: 20px; color: var(--text-2); font-size: clamp(16px, 1.3vw, 19px); }

  /* ── блок «Как пользоваться» — TL;DR + статичная схема ── */
  .how { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 72px); background: linear-gradient(180deg, rgba(101,91,250,0.04) 0%, transparent 100%); }
  .how > .wrap > * { max-width: 960px; margin-inline: auto; }
  .how h2 { font: 600 clamp(22px, 2.4vw, 32px)/1.15 var(--f-display); letter-spacing: -0.02em; margin-bottom: 14px; }
  .how__tldr {
    padding: 16px 20px;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    color: var(--text-2);
    font-size: 15px; line-height: 1.6;
    margin-bottom: 24px;
  }
  .how__tldr b { color: var(--text); }
  .how__tldr code { background: var(--bg-app); padding: 2px 6px; border-radius: 4px; font-size: 13px; color: var(--accent-hover); }

  .scheme { display: grid; gap: 14px; }
  .scheme__wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line);
    border-radius: 14px;
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  .scheme__svg { width: 100%; height: auto; display: block; }
  @media (max-width: 720px) {
    .scheme__svg { min-width: 560px; }
  }
  .scheme__caption { color: var(--text-2); font-size: 15px; line-height: 1.55; max-width: 68ch; }
  .scheme__caption code { background: var(--bg-raised); padding: 2px 6px; border-radius: 4px; font-size: 13px; color: var(--accent-hover); }

  /* ── подробная инструкция в <details> ── */
  .guide { border: 1px solid var(--line); border-radius: 12px; margin-bottom: 10px; transition: border-color 0.2s; }
  .guide[open] { border-color: var(--line-strong); }
  .guide > summary {
    list-style: none; cursor: pointer;
    padding: 16px 20px;
    display: flex; align-items: center; gap: 14px;
  }
  .guide > summary::-webkit-details-marker { display: none; }
  .guide > summary::after {
    content: ''; flex: none; margin-left: auto;
    width: 10px; height: 10px;
    border-right: 1.5px solid var(--text-2); border-bottom: 1.5px solid var(--text-2);
    transform: translateY(-2px) rotate(45deg);
    transition: transform 0.2s;
  }
  .guide[open] > summary::after { transform: translateY(2px) rotate(-135deg); }
  .guide > summary h3 { font: 600 17px/1.3 var(--f-display); margin: 0; letter-spacing: -0.01em; }
  .guide > p, .guide > ul, .guide > ol, .guide > dl {
    padding: 0 20px 16px;
    color: var(--text-2); line-height: 1.6; margin: 0;
  }
  .guide > p + p, .guide > p + ul, .guide > p + ol { padding-top: 10px; }
  .guide a { color: var(--accent-hover); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .guide code { background: var(--bg-raised); padding: 2px 6px; border-radius: 4px; font-size: 13px; color: var(--text); }
  .guide ul, .guide ol { padding-left: 40px; }
  .guide li { margin-bottom: 6px; }
  .guide b { color: var(--text); }

  .tool-body { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 72px); }
  .tool-body > .wrap > * { max-width: 960px; margin-inline: auto; }

  .modeset { display: flex; gap: 2px; margin-bottom: 28px; padding: 4px; background: var(--bg-raised); border: 1px solid var(--line-strong); border-radius: 999px; width: fit-content; }
  .modeset button {
    padding: 8px 18px;
    border-radius: 999px;
    color: var(--text-2);
    font: 500 14px/1 var(--f-display);
    transition: color 0.2s, background-color 0.2s;
  }
  .modeset button[aria-selected='true'] { background: var(--accent); color: #fff; }
  .modeset button:not([aria-selected='true']):hover { color: var(--text); }

  .stats { display: grid; gap: 24px; }
  .pane { display: none; }
  .pane[data-active] { display: grid; gap: 20px; }
  .grid-2 { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  @media (max-width: 640px) { .grid-2 { grid-template-columns: minmax(0, 1fr); } }

  .field { display: grid; gap: 8px; min-width: 0; }
  .field label { font: 500 15px/1.3 var(--f-display); color: var(--text); }
  .field input {
    width: 100%; min-height: 44px; padding: 10px 14px;
    background: var(--bg-raised); border: 1px solid var(--line-strong); border-radius: 10px;
    color: var(--text); font: inherit; font-variant-numeric: tabular-nums;
  }
  .field input:focus { outline: none; border-color: var(--accent); }
  .field__hint { color: var(--text-3); font-size: 13px; line-height: 1.5; }
  .field__hint code { background: var(--bg-raised); padding: 1px 6px; border-radius: 4px; font-size: 12.5px; color: var(--text-2); }

  .or { color: var(--text-3); font-size: 14px; text-align: center; letter-spacing: 0.05em; }

  .ab { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; }
  .ab__col { display: grid; gap: 14px; padding: 20px; border: 1px solid var(--line); border-radius: 14px; }
  .ab__col h3 { font: 600 17px/1.2 var(--f-display); }
  .ab__hint { margin-top: 10px; }
  @media (max-width: 640px) { .ab { grid-template-columns: minmax(0, 1fr); } }

  .result { margin-top: 36px; padding-top: 28px; border-top: 1px solid var(--line); }
  .result h2 { font: 600 clamp(22px, 2.4vw, 28px)/1.15 var(--f-display); letter-spacing: -0.02em; }
  .result h2 em { font-style: normal; color: var(--accent); }
  .result :global(.panel) {
    margin-top: 20px;
    padding: 24px;
    background: var(--bg-raised);
    border: 1px solid var(--line-strong);
    border-radius: 14px;
  }
  .result :global(.bar) {
    position: relative;
    height: 56px;
    margin: 16px 0 24px;
    background: var(--bg-app);
    border-radius: 8px;
    overflow: hidden;
  }
  .result :global(.bar__fill) {
    position: absolute; top: 0; bottom: 0;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-hover) 100%);
    opacity: 0.3;
  }
  .result :global(.bar__center) {
    position: absolute; top: 0; bottom: 0;
    width: 2px;
    background: var(--text);
  }
  .result :global(.bar__scale) {
    display: flex; justify-content: space-between;
    color: var(--text-3); font-size: 12.5px; font-variant-numeric: tabular-nums;
    margin-top: 4px;
  }
  .result :global(.levels) { display: grid; gap: 10px; }
  .result :global(.levels__row) { display: grid; grid-template-columns: 60px 1fr 1fr 1fr; gap: 12px; align-items: baseline; color: var(--text-2); font-size: 14px; font-variant-numeric: tabular-nums; }
  .result :global(.levels__row b) { color: var(--text); font-weight: 500; }
  .result :global(.levels__row span.lbl) { color: var(--text-3); }
  .result :global(.verdict) { margin-top: 20px; padding: 16px 18px; border-radius: 12px; font-size: 15px; line-height: 1.5; }
  .result :global(.verdict.ok) { background: rgb(62 207 142 / 0.1); color: var(--green); border: 1px solid rgb(62 207 142 / 0.3); }
  .result :global(.verdict.nope) { background: rgb(255 138 91 / 0.1); color: var(--coral); border: 1px solid rgb(255 138 91 / 0.3); }
  .result :global(.verdict b) { color: inherit; }
  .result :global(.kpis) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .result :global(.kpi) { display: grid; gap: 4px; }
  .result :global(.kpi span) { color: var(--text-3); font-size: 13px; }
  .result :global(.kpi b) { font: 600 clamp(22px, 2.4vw, 28px)/1.1 var(--f-display); color: var(--text); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) {
    .result :global(.kpis) { grid-template-columns: minmax(0, 1fr); }
    .result :global(.levels__row) { grid-template-columns: 60px 1fr 1fr; }
    .result :global(.levels__row > *:nth-child(4)) { display: none; }
  }

  .tool-about { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 80px); }
  .tool-about__in { max-width: 960px; margin-inline: auto; display: grid; gap: 20px; }
  .tool-about h2 { font: 600 clamp(22px, 2.4vw, 32px)/1.15 var(--f-display); letter-spacing: -0.02em; }
  .tool-about h3 { font: 600 18px/1.2 var(--f-display); margin-top: 20px; }
  .tool-about p { color: var(--text-2); line-height: 1.6; }
  .tool-about code { background: var(--bg-raised); padding: 1px 6px; border-radius: 4px; font-size: 13px; color: var(--text); }
  .defs { display: grid; grid-template-columns: 60px 1fr; gap: 10px 20px; color: var(--text-2); }
  .defs dt { color: var(--text); font-variant-numeric: tabular-nums; }
  @media (max-width: 640px) { .defs { grid-template-columns: 1fr; gap: 2px 0; } .defs dt { margin-top: 10px; } }
</style>

<script>
  // z-значения для двусторонних доверительных интервалов (нормальное распределение).
  // Получены как inverse-CDF стандартной нормали на 1 - alpha/2.
  const LEVELS: Array<{ level: number; z: number }> = [
    { level: 70, z: 1.0364 },
    { level: 80, z: 1.2816 },
    { level: 90, z: 1.6449 },
    { level: 95, z: 1.9600 },
    { level: 99, z: 2.5758 },
  ];

  // Wilson score interval для доли (x of n), по уровню доверия (z).
  const wilson = (x: number, n: number, z: number) => {
    const p = x / n;
    const denom = 1 + (z * z) / n;
    const center = (p + (z * z) / (2 * n)) / denom;
    const halfWidth = (z * Math.sqrt((p * (1 - p)) / n + (z * z) / (4 * n * n))) / denom;
    return { lo: Math.max(0, center - halfWidth), hi: Math.min(1, center + halfWidth), p };
  };

  const fmt = (v: number, digits = 2) => (v * 100).toFixed(digits) + '%';
  const fmtNum = (v: number, digits = 3) => v.toFixed(digits);

  // Аппроксимация 1 - Φ(z) через erfc (ошибочная функция). Точно для нужд p-value.
  const erf = (x: number) => {
    // Abramowitz & Stegun 7.1.26
    const sign = x < 0 ? -1 : 1;
    const a1 = 0.254829592, a2 = -0.284496736, a3 = 1.421413741, a4 = -1.453152027, a5 = 1.061405429, p = 0.3275911;
    const absX = Math.abs(x);
    const t = 1 / (1 + p * absX);
    const y = 1 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-absX * absX);
    return sign * y;
  };
  const pValueTwoSided = (z: number) => 1 - erf(Math.abs(z) / Math.SQRT2);

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const resultTitle = document.querySelector<HTMLElement>('[data-result-title]')!;
  const resultBody = document.querySelector<HTMLElement>('[data-result-body]')!;

  let mode: 'one' | 'ab' = 'one';
  document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((btn) => {
    btn.addEventListener('click', () => {
      mode = btn.dataset.mode as 'one' | 'ab';
      document.querySelectorAll<HTMLButtonElement>('[data-mode]').forEach((b) =>
        b.setAttribute('aria-selected', String(b === btn)));
      document.querySelectorAll<HTMLElement>('[data-pane]').forEach((p) => {
        if (p.dataset.pane === mode) p.setAttribute('data-active', '');
        else p.removeAttribute('data-active');
      });
      render();
    });
  });

  // Синхронизация clicks/conversions ↔ CR в режиме «один вариант».
  const clicksEl = form.querySelector<HTMLInputElement>('[name=clicks]')!;
  const convEl = form.querySelector<HTMLInputElement>('[name=conversions]')!;
  const crEl = form.querySelector<HTMLInputElement>('[name=cr]')!;
  let lastEdited: 'conv' | 'cr' = 'conv';

  clicksEl.addEventListener('input', () => render());
  convEl.addEventListener('input', () => { lastEdited = 'conv'; render(); });
  crEl.addEventListener('input', () => { lastEdited = 'cr'; render(); });

  form.querySelectorAll<HTMLInputElement>('[name^="a"], [name^="b"]').forEach((i) =>
    i.addEventListener('input', render));

  const resolveOne = (): { n: number; x: number; p: number } | null => {
    const n = Number(clicksEl.value);
    if (!Number.isFinite(n) || n < 1) return null;
    if (lastEdited === 'cr') {
      const cr = Number(crEl.value);
      if (!Number.isFinite(cr) || cr < 0 || cr > 100) return null;
      const x = Math.round((cr / 100) * n);
      return { n, x, p: cr / 100 };
    }
    const x = Number(convEl.value);
    if (!Number.isFinite(x) || x < 0 || x > n) return null;
    return { n, x, p: x / n };
  };

  // Поддерживаем производное поле: если пользователь редактирует «клики/конверсии» —
  // CR пересчитываем, и наоборот. Пустое поле не трогаем, чтобы не мешать вводу.
  const syncDerived = (one: { n: number; x: number; p: number }) => {
    if (lastEdited === 'conv' && document.activeElement !== crEl) {
      crEl.value = (one.p * 100).toFixed(2);
    } else if (lastEdited === 'cr' && document.activeElement !== convEl) {
      convEl.value = String(one.x);
    }
  };

  const renderOne = (one: { n: number; x: number; p: number }) => {
    const ciRows = LEVELS.map(({ level, z }) => {
      const { lo, hi } = wilson(one.x, one.n, z);
      return { level, lo, hi, half: (hi - lo) / 2 };
    });
    const ci95 = ciRows.find((r) => r.level === 95)!;
    resultTitle.innerHTML = `Конверсия <em>${fmt(one.p)}</em> — доверительный интервал 95%: <em>${fmt(ci95.lo)} … ${fmt(ci95.hi)}</em>`;
    resultBody.innerHTML = `
      <div class="panel">
        <div class="kpis">
          <div class="kpi"><span>Выборка</span><b>${one.n.toLocaleString('ru')}</b></div>
          <div class="kpi"><span>Положительных</span><b>${one.x.toLocaleString('ru')}</b></div>
          <div class="kpi"><span>Конверсия</span><b>${fmt(one.p)}</b></div>
        </div>
        ${renderBar(one.p, ci95.lo, ci95.hi)}
        <div class="levels">
          <div class="levels__row"><span class="lbl">Уровень</span><span class="lbl">Нижняя</span><span class="lbl">Верхняя</span><span class="lbl">±</span></div>
          ${ciRows.map((r) => `
            <div class="levels__row">
              <b>${r.level}%</b>
              <span>${fmt(r.lo)}</span>
              <span>${fmt(r.hi)}</span>
              <span>${fmt(r.half)}</span>
            </div>`).join('')}
        </div>
      </div>
    `;
  };

  const renderBar = (p: number, lo: number, hi: number) => {
    // Шкала расширяется, чтобы интервал занял ~60% ширины, но держим минимум 0..p*2.
    const span = Math.max(hi - lo, p * 0.5, 0.02);
    const left = Math.max(0, lo - span * 0.3);
    const right = Math.min(1, hi + span * 0.3);
    const w = right - left || 1;
    const barLo = ((lo - left) / w) * 100;
    const barHi = ((hi - left) / w) * 100;
    const barCenter = ((p - left) / w) * 100;
    return `
      <div class="bar" aria-label="Диапазон 95% доверительного интервала">
        <div class="bar__fill" style="left:${barLo}%;right:${100 - barHi}%"></div>
        <div class="bar__center" style="left:${barCenter}%"></div>
      </div>
      <div class="bar__scale"><span>${fmt(left)}</span><span>${fmt((left + right) / 2)}</span><span>${fmt(right)}</span></div>
    `;
  };

  const renderAb = () => {
    const a = {
      n: Number((form.querySelector<HTMLInputElement>('[name=aClicks]')!).value),
      x: Number((form.querySelector<HTMLInputElement>('[name=aConv]')!).value),
    };
    const b = {
      n: Number((form.querySelector<HTMLInputElement>('[name=bClicks]')!).value),
      x: Number((form.querySelector<HTMLInputElement>('[name=bConv]')!).value),
    };
    if (!Number.isFinite(a.n) || a.n < 1 || !Number.isFinite(a.x) || a.x < 0 || a.x > a.n ||
        !Number.isFinite(b.n) || b.n < 1 || !Number.isFinite(b.x) || b.x < 0 || b.x > b.n) {
      resultTitle.textContent = 'Заполните клики и конверсии для обоих вариантов';
      resultBody.innerHTML = '';
      return;
    }
    const pA = a.x / a.n, pB = b.x / b.n;
    const pPool = (a.x + b.x) / (a.n + b.n);
    const se = Math.sqrt(pPool * (1 - pPool) * (1 / a.n + 1 / b.n));
    const z = se === 0 ? 0 : (pB - pA) / se;
    const pVal = pValueTwoSided(z);
    const diff = pB - pA;
    const relative = pA === 0 ? Infinity : diff / pA;
    const ciA = wilson(a.x, a.n, 1.96);
    const ciB = wilson(b.x, b.n, 1.96);
    const significant = pVal < 0.05 && Math.abs(z) >= 1.96;

    resultTitle.innerHTML = significant
      ? `Разница <em>${diff >= 0 ? '+' : ''}${(diff * 100).toFixed(2)} п.п.</em> — значима на уровне 95%`
      : `Разница <em>${diff >= 0 ? '+' : ''}${(diff * 100).toFixed(2)} п.п.</em> — пока не значима`;

    resultBody.innerHTML = `
      <div class="panel">
        <div class="kpis">
          <div class="kpi"><span>Конверсия A</span><b>${fmt(pA)}</b></div>
          <div class="kpi"><span>Конверсия B</span><b>${fmt(pB)}</b></div>
          <div class="kpi"><span>Разница (отн.)</span><b>${relative === Infinity ? '∞' : ((relative) * 100).toFixed(1) + '%'}</b></div>
        </div>
        <div class="kpis" style="margin-top: 20px;">
          <div class="kpi"><span>z-статистика</span><b>${fmtNum(z, 3)}</b></div>
          <div class="kpi"><span>p-value</span><b>${pVal < 0.0001 ? '<0.0001' : pVal.toFixed(4)}</b></div>
          <div class="kpi"><span>95% CI A — B</span><b>${fmt(ciA.lo)}..${fmt(ciA.hi)} / ${fmt(ciB.lo)}..${fmt(ciB.hi)}</b></div>
        </div>
        <div class="verdict ${significant ? 'ok' : 'nope'}">
          ${significant
            ? `<b>p = ${pVal < 0.0001 ? '<0.0001' : pVal.toFixed(4)}</b> — разница статистически значима на уровне 0.05. Если бы варианты были одинаковы, такой разрыв между ними случайно получался бы реже чем в ${(pVal * 100).toFixed(2)}% повторов.`
            : `<b>p = ${pVal.toFixed(4)}</b> — пока недостаточно данных. Нужна либо большая выборка, либо реальный эффект больше. Доверительные интервалы A и B пересекаются.`}
        </div>
      </div>
    `;
  };

  function render() {
    if (mode === 'one') {
      const one = resolveOne();
      if (!one) {
        resultTitle.textContent = 'Введите клики и конверсии (или только % конверсии)';
        resultBody.innerHTML = '';
        return;
      }
      syncDerived(one);
      renderOne(one);
    } else {
      renderAb();
    }
  }

  render();
</script>
