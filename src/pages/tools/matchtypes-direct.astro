---
import Page from '../../layouts/Page.astro';
import { toolBySlug, toolUrl } from '../../data/tools';
import { breadcrumbs, webPage, webApplication } from '../../lib/schema';
import { typo } from '../../lib/typo';

const tool = toolBySlug('matchtypes-direct')!;
const url = toolUrl(tool.slug);

const schema = [
  webPage({ title: tool.name, description: tool.description, url }),
  breadcrumbs([
    { name: 'Главная', url: '/' },
    { name: 'Инструменты', url: '/tools/' },
    { name: tool.short, url },
  ]),
  webApplication({
    name: tool.name,
    description: tool.description,
    url,
    applicationCategory: 'BusinessApplication',
    featureList: [
      'Операторы: кавычки, восклицательный знак, квадратные скобки',
      'Все 7 комбинаций операторов',
      'Фиксация числа слов, словоформы, порядка слов',
    ],
  }),
];

// 7 режимов операторов Яндекс.Директ — порядок как у yaroshenko.tools, с описаниями.
const modes = [
  { id: 'raw', label: 'Без операторов', example: 'ключ слово' },
  { id: 'quotes', label: 'Кавычки — фиксируют число слов', example: '"ключ слово"' },
  { id: 'form', label: '!Словоформа каждого слова', example: '!ключ !слово' },
  { id: 'quotes-form', label: 'Кавычки + словоформа', example: '"!ключ !слово"' },
  { id: 'order', label: '[Порядок слов]', example: '[ключ слово]' },
  { id: 'quotes-order', label: 'Кавычки + порядок', example: '"[ключ слово]"' },
  { id: 'all', label: 'Все три оператора', example: '"[!ключ !слово]"' },
];
---

<Page title={tool.name} description={tool.description} schema={schema}>
  <section class="tool-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/tools/">Инструменты</a>
        <span aria-hidden="true">·</span>
        <span>{tool.short}</span>
      </nav>
      <h1>{typo(tool.name)}</h1>
      <p class="tool-head__lead">{typo(tool.lead)}</p>
    </div>
  </section>

  <section class="how" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title">Что фиксируют операторы Директа</h2>
      <p class="how__tldr">
        <b>Коротко:</b> у Директа три оператора — <code>"кавычки"</code> для числа слов,
        <code>!восклицательный знак</code> для словоформы, <code>[скобки]</code> для порядка слов.
        Инструмент добавляет их пачкой, можно комбинировать — всего 7 вариантов. Вставили ключи →
        отметили нужные варианты → скопировали в Директ.
      </p>

      <div class="scheme">
        <svg viewBox="0 0 700 320" preserveAspectRatio="xMidYMid meet" aria-hidden="true" class="scheme__svg">
          <rect x="0" y="0" width="700" height="320" rx="14" fill="var(--bg-app)" />

          <!-- Исходный ключ -->
          <text x="350" y="36" text-anchor="middle" fill="var(--text-3)" font-size="12" font-family="var(--f-display)">исходный ключ</text>
          <rect x="230" y="48" width="240" height="42" rx="8" fill="var(--bg-raised)" stroke="var(--line-strong)" />
          <text x="350" y="76" text-anchor="middle" fill="var(--text)" font-size="16" font-family="ui-monospace, Menlo, monospace">билет москва</text>

          <!-- Три оператора — вертикальные колонки -->
          <g>
            <!-- "кавычки" -->
            <rect x="30" y="120" width="200" height="170" rx="12" fill="var(--bg-raised)" stroke="var(--line)" />
            <text x="130" y="150" text-anchor="middle" fill="var(--accent-hover)" font-size="26" font-family="var(--f-display)" font-weight="600">" "</text>
            <text x="130" y="180" text-anchor="middle" fill="var(--text-2)" font-size="13" font-family="var(--f-display)">число слов</text>
            <text x="130" y="214" text-anchor="middle" fill="var(--text)" font-size="14" font-family="ui-monospace, Menlo, monospace">"билет москва"</text>
            <text x="130" y="248" text-anchor="middle" fill="var(--text-3)" font-size="11" font-family="var(--f-display)">только по запросам</text>
            <text x="130" y="264" text-anchor="middle" fill="var(--text-3)" font-size="11" font-family="var(--f-display)">из 2 слов</text>

            <!-- !словоформа -->
            <rect x="250" y="120" width="200" height="170" rx="12" fill="var(--bg-raised)" stroke="var(--line)" />
            <text x="350" y="150" text-anchor="middle" fill="var(--accent-hover)" font-size="26" font-family="var(--f-display)" font-weight="600">!</text>
            <text x="350" y="180" text-anchor="middle" fill="var(--text-2)" font-size="13" font-family="var(--f-display)">словоформа</text>
            <text x="350" y="214" text-anchor="middle" fill="var(--text)" font-size="14" font-family="ui-monospace, Menlo, monospace">!билет !москва</text>
            <text x="350" y="248" text-anchor="middle" fill="var(--text-3)" font-size="11" font-family="var(--f-display)">не покажет</text>
            <text x="350" y="264" text-anchor="middle" fill="var(--text-3)" font-size="11" font-family="var(--f-display)">по «билеты в москву»</text>

            <!-- [скобки] -->
            <rect x="470" y="120" width="200" height="170" rx="12" fill="var(--bg-raised)" stroke="var(--line)" />
            <text x="570" y="150" text-anchor="middle" fill="var(--accent-hover)" font-size="26" font-family="var(--f-display)" font-weight="600">[ ]</text>
            <text x="570" y="180" text-anchor="middle" fill="var(--text-2)" font-size="13" font-family="var(--f-display)">порядок слов</text>
            <text x="570" y="214" text-anchor="middle" fill="var(--text)" font-size="14" font-family="ui-monospace, Menlo, monospace">[билет москва]</text>
            <text x="570" y="248" text-anchor="middle" fill="var(--text-3)" font-size="11" font-family="var(--f-display)">«билет москва» ≠</text>
            <text x="570" y="264" text-anchor="middle" fill="var(--text-3)" font-size="11" font-family="var(--f-display)">«москва билет»</text>
          </g>
        </svg>
        <p class="scheme__caption">
          Можно комбинировать — все 7 вариантов инструмент собирает автоматически. Например,
          <code>"[!билет !москва]"</code> — фиксирует и число слов, и порядок, и словоформу одновременно
          (самый узкий таргетинг для Директа).
        </p>
      </div>
    </div>
  </section>

  <section class="tool-body">
    <div class="wrap">
      <form class="mt" novalidate data-form>
        <fieldset class="modeset">
          <legend>Операторы — отметьте нужные</legend>
          {
            modes.map((m, i) => (
              <label>
                <input type="checkbox" name="mode" value={m.id} checked={i === 1} />
                <span class="modeset__lbl">{m.label}</span>
                <code>{m.example}</code>
              </label>
            ))
          }
        </fieldset>

        <div class="io">
          <div class="field">
            <label for="d-input">Ключи — по одному на строку</label>
            <textarea id="d-input" data-input rows="12"
              placeholder="купить ламинат&#10;ламинат с доставкой&#10;ламинат в ташкенте"></textarea>
          </div>
          <div class="field">
            <label>Результат <span data-count class="field__count"></span></label>
            <textarea data-output rows="12" readonly placeholder="Результат появится здесь."></textarea>
          </div>
        </div>

        <div class="actions">
          <button type="button" class="btn btn--primary" data-copy>Скопировать</button>
          <button type="button" class="btn btn--ghost" data-clear>Очистить</button>
        </div>
        <p class="actions__hint" aria-live="polite" data-status></p>
      </form>
    </div>
  </section>

  <section class="tool-about">
    <div class="wrap tool-about__in">
      <h2>Подробная инструкция</h2>

      <details open class="guide">
        <summary><h3>Как им пользоваться</h3></summary>
        <ol>
          <li><b>Соберите список ключей</b> в Wordstat или другом инструменте. По одной фразе на строку.</li>
          <li><b>Вставьте в левое поле</b>.</li>
          <li><b>Отметьте нужные варианты</b> операторов — любое число. На каждый отмеченный вариант список продублируется с нужными операторами.</li>
          <li><b>Скопируйте результат</b> и вставьте в Директ — при создании или редактировании группы объявлений в разделе «Ключевые фразы».</li>
        </ol>
        <p>
          Если выбрать несколько вариантов, например «Кавычки» и «Все три оператора», каждый исходный ключ
          появится в результате дважды — в двух разных вариантах фиксации.
        </p>
      </details>

      <details class="guide">
        <summary><h3>Операторы Директа — для новичков</h3></summary>
        <p>
          У Яндекс.Директа — три оператора, которые <b>сужают</b> показ объявлений под более узкие запросы.
          Без операторов Директ показывает по ключу <b>очень широко</b>: синонимы, перефразировки, вложенные
          темы. Это даёт много показов, но и много мусора. Операторы фиксируют ключ и отсекают лишнее.
        </p>
        <dl class="defs">
          <dt>Без операторов</dt>
          <dd>Директ показывает по ключу, его словоформам, синонимам и вложенным запросам. Самый широкий охват. <b>Когда:</b> тестовые запуски, автостратегии, где алгоритм сам фильтрует.</dd>
          <dt>«Кавычки»</dt>
          <dd>Фиксируют число слов. Показы только по запросам из того же количества слов, что и ключ (словоформы ещё допускаются). <b>Когда:</b> когда расширенные запросы ловят ненужный мусор. Например <code>"ламинат"</code> не покажет по «ламинат в ванной с подогревом».</dd>
          <dt>!Восклицательный знак</dt>
          <dd>Фиксирует словоформу — только та форма, которая стоит после «!». <b>Когда:</b> для стоп-слов, предлогов, названий (<code>билет !в москву</code> не покажет по «билет из москвы»).</dd>
          <dt>[Квадратные скобки]</dt>
          <dd>Фиксируют порядок слов. <b>Когда:</b> для фраз, в которых перестановка меняет смысл. Классика — <code>[билет Ташкент Москва]</code> ≠ <code>[билет Москва Ташкент]</code>.</dd>
        </dl>
      </details>

      <details class="guide">
        <summary><h3>Какой вариант когда выбирать</h3></summary>
        <ul>
          <li><b>«Без операторов»</b> — тестовые запуски, широкий сбор данных на новом рынке.</li>
          <li><b>«Кавычки»</b> — большинство кампаний на средних и крупных ядрах. Хороший компромисс между охватом и релевантностью.</li>
          <li><b>«Словоформа» (!)</b> — когда важна конкретная грамматическая форма. Чаще используется вместе с другими операторами.</li>
          <li><b>«Порядок» ([ ])</b> — для направлений, маршрутов, пар городов, спортивных встреч.</li>
          <li><b>Все три оператора вместе</b> — самое узкое соответствие. Для горячих коммерческих запросов, где важна максимальная релевантность.</li>
        </ul>
      </details>

      <details class="guide">
        <summary><h3>Чем это отличается от Google Ads</h3></summary>
        <p>
          В Google Ads есть всего три типа соответствия (широкое, фразовое, точное), и выбирается
          один тип на ключ. В Директе же операторы — это <b>модификаторы</b>, их можно комбинировать
          внутри одного ключа. Поэтому вариантов не три, а семь.
        </p>
        <p>
          Операторы Директа аналогов в Google не имеют. Там для похожего эффекта используют
          минус-слова, точное соответствие и аудиторные ограничения.
        </p>
      </details>
    </div>
  </section>
</Page>

<style>
  .tool-head { padding-block: clamp(40px, 7vh, 80px) clamp(28px, 5vh, 48px); }
  .crumbs { display: flex; gap: 10px; align-items: center; color: var(--text-3); font-size: 14px; margin-bottom: 20px; }
  .crumbs a { color: var(--text-2); transition: color 0.2s; }
  .crumbs a:hover { color: var(--text); }
  .tool-head h1 { font: 700 clamp(32px, 4.4vw, 56px)/1.05 var(--f-display); letter-spacing: -0.03em; text-wrap: balance; max-width: 20ch; }
  .tool-head__lead { max-width: 60ch; margin-top: 20px; color: var(--text-2); font-size: clamp(16px, 1.3vw, 19px); }

  /* ── блок «Как пользоваться» — TL;DR + статичная SVG-схема ── */
  .how { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 72px); background: linear-gradient(180deg, rgba(101,91,250,0.04) 0%, transparent 100%); }
  .how > .wrap > * { max-width: 960px; margin-inline: auto; }
  .how h2 { font: 600 clamp(22px, 2.4vw, 32px)/1.15 var(--f-display); letter-spacing: -0.02em; margin-bottom: 14px; }
  .how__tldr { padding: 16px 20px; background: var(--bg-raised); border: 1px solid var(--line-strong); border-radius: 12px; color: var(--text-2); font-size: 15px; line-height: 1.6; margin-bottom: 24px; }
  .how__tldr b { color: var(--text); }
  .how__tldr code { background: var(--bg-app); padding: 2px 6px; border-radius: 4px; font-size: 13px; color: var(--accent-hover); }

  .scheme { display: grid; gap: 14px; }
  .scheme__svg { width: 100%; height: auto; border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
  .scheme__caption { color: var(--text-2); font-size: 15px; line-height: 1.55; max-width: 68ch; }
  .scheme__caption code { background: var(--bg-raised); padding: 2px 6px; border-radius: 4px; font-size: 13px; color: var(--accent-hover); }

  /* ── подробная инструкция в <details> ── */
  .guide { border: 1px solid var(--line); border-radius: 12px; margin-bottom: 10px; transition: border-color 0.2s; }
  .guide[open] { border-color: var(--line-strong); }
  .guide > summary { list-style: none; cursor: pointer; padding: 16px 20px; display: flex; align-items: center; gap: 14px; }
  .guide > summary::-webkit-details-marker { display: none; }
  .guide > summary::after { content: ''; flex: none; margin-left: auto; width: 10px; height: 10px; border-right: 1.5px solid var(--text-2); border-bottom: 1.5px solid var(--text-2); transform: translateY(-2px) rotate(45deg); transition: transform 0.2s; }
  .guide[open] > summary::after { transform: translateY(2px) rotate(-135deg); }
  .guide > summary h3 { font: 600 17px/1.3 var(--f-display); margin: 0; letter-spacing: -0.01em; }
  .guide > p, .guide > ul, .guide > ol, .guide > dl { padding: 0 20px 16px; color: var(--text-2); line-height: 1.6; margin: 0; }
  .guide > p + p, .guide > p + ul, .guide > p + ol { padding-top: 10px; }
  .guide a { color: var(--accent-hover); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .guide code { background: var(--bg-raised); padding: 2px 6px; border-radius: 4px; font-size: 13px; color: var(--text); }
  .guide ul, .guide ol { padding-left: 40px; }
  .guide li { margin-bottom: 6px; }
  .guide b { color: var(--text); }

  .tool-body { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 72px); }
  .tool-body > .wrap > * { max-width: 960px; margin-inline: auto; }

  .mt { display: grid; gap: 24px; }

  .modeset { display: grid; gap: 10px; border: 0; padding: 0; margin: 0; }
  .modeset legend { padding: 0; font: 500 15px/1.3 var(--f-display); color: var(--text); margin-bottom: 2px; }
  .modeset label {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr) auto;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 10px;
    color: var(--text);
    font-size: 15px;
    cursor: pointer;
    transition: border-color 0.2s, background-color 0.2s;
  }
  .modeset label:hover { border-color: var(--line-strong); }
  .modeset label:has(input:checked) { border-color: var(--accent); background: rgb(101 91 250 / 0.08); }
  .modeset input[type=checkbox] { width: 18px; height: 18px; margin: 0; accent-color: var(--accent); }
  .modeset__lbl { line-height: 1.3; }
  .modeset code { background: var(--bg-raised); padding: 4px 10px; border-radius: 6px; font-size: 13px; color: var(--text-2); font-family: ui-monospace, Menlo, monospace; white-space: nowrap; }

  .io { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
  @media (max-width: 860px) { .io { grid-template-columns: minmax(0, 1fr); } }

  .field { display: grid; gap: 8px; min-width: 0; }
  .field label { font: 500 15px/1.3 var(--f-display); color: var(--text); display: flex; justify-content: space-between; align-items: baseline; }
  .field__count { color: var(--text-3); font-size: 13px; font-weight: 400; font-family: var(--f-text); }
  .field textarea {
    width: 100%; padding: 12px 14px;
    background: var(--bg-raised); border: 1px solid var(--line-strong); border-radius: 10px;
    color: var(--text); font-family: ui-monospace, Menlo, monospace; font-size: 14px; line-height: 1.5;
    min-height: 260px; resize: vertical;
  }
  .field textarea:focus { outline: none; border-color: var(--accent); }
  .field textarea[readonly] { color: var(--text); background: var(--bg-app); }

  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .actions__hint { color: var(--green); font-size: 14px; min-height: 1em; }
  .actions__hint.is-error { color: var(--coral); }

  .tool-about { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 80px); }
  .tool-about__in { max-width: 72ch; display: grid; gap: 20px; }
  .tool-about h2 { font: 600 clamp(22px, 2.4vw, 32px)/1.15 var(--f-display); letter-spacing: -0.02em; }
  .tool-about p { color: var(--text-2); line-height: 1.6; }
  .defs { display: grid; grid-template-columns: 180px 1fr; gap: 10px 20px; color: var(--text-2); }
  .defs dt { color: var(--text); }
  .defs dd { line-height: 1.5; }
  @media (max-width: 640px) { .defs { grid-template-columns: 1fr; gap: 2px 0; } .defs dt { margin-top: 10px; } }
</style>

<script>
  type Mode = 'raw' | 'quotes' | 'form' | 'quotes-form' | 'order' | 'quotes-order' | 'all';

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const input = document.querySelector<HTMLTextAreaElement>('[data-input]')!;
  const output = document.querySelector<HTMLTextAreaElement>('[data-output]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const countEl = document.querySelector<HTMLElement>('[data-count]')!;

  // Операторы ! применяются к каждому слову, порядок операторов снаружи: " [ ... ] "
  const bang = (k: string) => k.split(/\s+/).map((w) => `!${w}`).join(' ');

  const transform = (k: string, mode: Mode): string => {
    switch (mode) {
      case 'raw': return k;
      case 'quotes': return `"${k}"`;
      case 'form': return bang(k);
      case 'quotes-form': return `"${bang(k)}"`;
      case 'order': return `[${k}]`;
      case 'quotes-order': return `"[${k}]"`;
      case 'all': return `"[${bang(k)}]"`;
    }
  };

  const render = () => {
    const keys = input.value.split('\n').map((l) => l.trim()).filter(Boolean);
    const modes = [...form.querySelectorAll<HTMLInputElement>('input[name=mode]:checked')].map((i) => i.value as Mode);
    const lines: string[] = [];
    for (const mode of modes) {
      for (const k of keys) lines.push(transform(k, mode));
    }
    output.value = lines.join('\n');
    countEl.textContent = lines.length ? `${lines.length} шт.` : '';
  };

  form.addEventListener('input', render);

  document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async () => {
    if (!output.value) { status.textContent = 'Введите ключи и выберите хотя бы один оператор.'; status.classList.add('is-error'); return; }
    try {
      await navigator.clipboard.writeText(output.value);
      status.textContent = 'Скопировано.'; status.classList.remove('is-error');
    } catch {
      status.textContent = 'Браузер не дал доступа к буферу — скопируйте вручную.'; status.classList.add('is-error');
    }
  });

  document.querySelector<HTMLButtonElement>('[data-clear]')?.addEventListener('click', () => {
    input.value = ''; output.value = ''; countEl.textContent = '';
    status.textContent = ''; status.classList.remove('is-error');
    input.focus();
  });

  render();
</script>
