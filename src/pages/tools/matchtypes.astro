---
import Page from '../../layouts/Page.astro';
import { toolBySlug, toolUrl } from '../../data/tools';
import { breadcrumbs, webPage, webApplication } from '../../lib/schema';
import { typo } from '../../lib/typo';

const tool = toolBySlug('matchtypes')!;
const url = toolUrl(tool.slug);

const schema = [
  webPage({ title: tool.name, description: tool.description, url }),
  breadcrumbs([
    { name: 'Главная', url: '/' },
    { name: 'Инструменты', url: '/tools/' },
    { name: tool.short, url },
  ]),
  webApplication({
    name: tool.name,
    description: tool.description,
    url,
    applicationCategory: 'BusinessApplication',
    featureList: [
      'Широкое соответствие (broad)',
      'Фразовое соответствие ("keyword")',
      'Точное соответствие ([keyword])',
      'Несколько типов одновременно',
    ],
  }),
];
---

<Page title={tool.name} description={tool.description} schema={schema}>
  <section class="tool-head">
    <div class="wrap">
      <nav class="crumbs" aria-label="Хлебные крошки">
        <a href="/tools/">Инструменты</a>
        <span aria-hidden="true">·</span>
        <span>{tool.short}</span>
      </nav>
      <h1>{typo(tool.name)}</h1>
      <p class="tool-head__lead">{typo(tool.lead)}</p>
    </div>
  </section>

  <section class="how" aria-labelledby="how-title">
    <div class="wrap">
      <h2 id="how-title">Что это и когда использовать</h2>
      <p class="how__tldr">
        <b>Коротко:</b> вставили список ключей → отметили один или несколько типов соответствия →
        получили готовые ключи для вставки в кабинет или Google Ads Editor. Нужно, когда у вас уже
        собрано ядро запросов — не ломать пальцы, расставляя кавычки и скобки руками.
      </p>

      <div class="scheme">
        <div class="scheme__wrap">
        <svg viewBox="0 0 700 320" preserveAspectRatio="xMidYMid meet" aria-hidden="true" class="scheme__svg">
          <rect x="0" y="0" width="700" height="320" rx="14" fill="var(--bg-app)" />
          <!-- Исходный ключ -->
          <text x="350" y="40" text-anchor="middle" fill="var(--text-3)" font-size="12" font-family="var(--f-display)">исходный ключ</text>
          <rect x="240" y="54" width="220" height="42" rx="8" fill="var(--bg-raised)" stroke="var(--line-strong)" />
          <text x="350" y="82" text-anchor="middle" fill="var(--text)" font-size="16" font-family="ui-monospace, Menlo, monospace">купить ламинат</text>

          <!-- Три стрелки вниз, центры совпадают с центрами боксов (130, 350, 570) -->
          <g stroke="var(--line-strong)" stroke-width="1">
            <line x1="130" y1="130" x2="130" y2="170" />
            <path d="M125 165 l5 10 l5 -10" fill="none" />
            <line x1="350" y1="130" x2="350" y2="170" />
            <path d="M345 165 l5 10 l5 -10" fill="none" />
            <line x1="570" y1="130" x2="570" y2="170" />
            <path d="M565 165 l5 10 l5 -10" fill="none" />
          </g>

          <!-- Три бокса результата: 200px шириной, с gap 20px, без наезда -->
          <g>
            <!-- Широкое: 30..230, центр 130 -->
            <rect x="30" y="180" width="200" height="110" rx="10" fill="var(--bg-raised)" stroke="var(--line)" />
            <text x="130" y="206" text-anchor="middle" fill="var(--text-2)" font-size="13" font-family="var(--f-display)">Широкое</text>
            <text x="130" y="240" text-anchor="middle" fill="var(--text)" font-size="15" font-family="ui-monospace, Menlo, monospace">купить ламинат</text>
            <text x="130" y="270" text-anchor="middle" fill="var(--text-3)" font-size="11" font-family="var(--f-display)">синонимы, перефразировки</text>

            <!-- Фразовое: 250..450, центр 350 -->
            <rect x="250" y="180" width="200" height="110" rx="10" fill="var(--accent)" fill-opacity="0.08" stroke="var(--accent)" stroke-opacity="0.4" />
            <text x="350" y="206" text-anchor="middle" fill="var(--text-2)" font-size="13" font-family="var(--f-display)">Фразовое</text>
            <text x="350" y="240" text-anchor="middle" fill="var(--text)" font-size="15" font-family="ui-monospace, Menlo, monospace">
              <tspan fill="var(--accent-hover)">"</tspan>купить ламинат<tspan fill="var(--accent-hover)">"</tspan>
            </text>
            <text x="350" y="270" text-anchor="middle" fill="var(--text-3)" font-size="11" font-family="var(--f-display)">содержит смысл ключа</text>

            <!-- Точное: 470..670, центр 570 -->
            <rect x="470" y="180" width="200" height="110" rx="10" fill="var(--accent)" fill-opacity="0.08" stroke="var(--accent)" stroke-opacity="0.4" />
            <text x="570" y="206" text-anchor="middle" fill="var(--text-2)" font-size="13" font-family="var(--f-display)">Точное</text>
            <text x="570" y="240" text-anchor="middle" fill="var(--text)" font-size="15" font-family="ui-monospace, Menlo, monospace">
              <tspan fill="var(--accent-hover)">[</tspan>купить ламинат<tspan fill="var(--accent-hover)">]</tspan>
            </text>
            <text x="570" y="270" text-anchor="middle" fill="var(--text-3)" font-size="11" font-family="var(--f-display)">только тот же смысл</text>
          </g>
        </svg>
        </div>
        <p class="scheme__caption">
          Отмеченные типы будут продублированы в результате: если выбраны фразовое и точное,
          «купить ламинат» превратится в <code>"купить ламинат"</code> и <code>[купить ламинат]</code>.
          Скопировали → вставили в Google Ads Editor или в сам кабинет.
        </p>
      </div>
    </div>
  </section>

  <section class="tool-body">
    <div class="wrap">
      <form class="mt" novalidate data-form>
        <fieldset class="matchset">
          <legend>Типы соответствия</legend>
          <label><input type="checkbox" name="match" value="broad" /> Широкое <code>keyword</code></label>
          <label><input type="checkbox" name="match" value="phrase" checked /> Фразовое <code>"keyword"</code></label>
          <label><input type="checkbox" name="match" value="exact" /> Точное <code>[keyword]</code></label>
        </fieldset>

        <div class="io">
          <div class="field">
            <label for="mt-input">Ключи — по одному на строку</label>
            <textarea id="mt-input" data-input rows="12" placeholder="купить ламинат&#10;ламинат с доставкой&#10;ламинат в ташкенте"></textarea>
          </div>
          <div class="field">
            <label>Результат <span data-count class="field__count"></span></label>
            <textarea data-output rows="12" readonly placeholder="Результат появится здесь, когда введёте ключи."></textarea>
          </div>
        </div>

        <div class="actions">
          <button type="button" class="btn btn--primary" data-copy>Скопировать</button>
          <button type="button" class="btn btn--ghost" data-clear>Очистить</button>
        </div>
        <p class="actions__hint" aria-live="polite" data-status></p>
      </form>
    </div>
  </section>

  <section class="tool-about">
    <div class="wrap tool-about__in">
      <h2>Подробная инструкция</h2>

      <details open class="guide">
        <summary><h3>Как им пользоваться</h3></summary>
        <ol>
          <li><b>Соберите ядро запросов</b> в любом инструменте — Планировщик ключевых слов Google, Wordstat, Keyword Tool или просто руками. Не важно, в каком регистре и с какими символами — главное, по одному ключу на строку.</li>
          <li><b>Вставьте в левое поле</b>. Инструмент покажет сверху «Результат» справа.</li>
          <li><b>Отметьте нужные типы соответствия</b>: широкое / фразовое / точное. Можно выбрать несколько — тогда каждый ключ задублируется в каждом выбранном типе.</li>
          <li><b>Скопируйте результат</b> и вставьте в веб-интерфейс Google Ads (при создании группы объявлений) или в Google Ads Editor (вкладка «Ключевые слова» → «Добавить несколько»).</li>
        </ol>
      </details>

      <details class="guide">
        <summary><h3>Какой тип соответствия когда выбирать</h3></summary>
        <dl class="defs">
          <dt>Широкое</dt>
          <dd>Пишется как есть: <code>купить ламинат</code>. Показы по ключу, его синонимам, перефразировкам и близким по смыслу запросам. Самый широкий охват, но и больше нерелевантных показов. <b>Когда использовать:</b> с автоматическими стратегиями (Max Conversions, tCPA, Max Conversion Value), где алгоритм сам отфильтрует мусор; для сбора данных на новом рынке.</dd>
          <dt>Фразовое</dt>
          <dd>В кавычках: <code>"купить ламинат"</code>. Запрос должен содержать смысл ключа. С февраля 2021 года объединено со старым модификатором широкого (<code>+купить +ламинат</code>). <b>Когда использовать:</b> когда нужен баланс между охватом и контролем. Хорошо работает на поиске с ручными ставками.</dd>
          <dt>Точное</dt>
          <dd>В квадратных скобках: <code>[купить ламинат]</code>. Показы только по запросам с таким же смыслом (включая перестановку слов и близкие формы). <b>Когда использовать:</b> для горячих коммерческих запросов, где максимум релевантности важнее охвата. Для фирменных запросов, бренд-защиты, точечных промо.</dd>
        </dl>
      </details>

      <details class="guide">
        <summary><h3>Можно ли выбирать несколько типов сразу</h3></summary>
        <p>
          Да, и это распространённая практика. Чаще всего отмечают <b>фразовое + точное</b> — получается
          двойной список для одной группы объявлений. Google сам покажет объявление по тому типу, который
          лучше подходит под текущий запрос, а в отчётах вы увидите, какие типы работают лучше.
        </p>
        <p>
          Для крупных кампаний опытные контекстологи иногда делают три отдельные группы объявлений под
          один ключ — по одной на каждый тип соответствия. Это даёт полный контроль над ставками для каждого
          типа, но утяжеляет управление.
        </p>
      </details>
    </div>
  </section>
</Page>

<style>
  .tool-head { padding-block: clamp(40px, 7vh, 80px) clamp(28px, 5vh, 48px); }
  .crumbs { display: flex; gap: 10px; align-items: center; color: var(--text-3); font-size: 14px; margin-bottom: 20px; }
  .crumbs a { color: var(--text-2); transition: color 0.2s; }
  .crumbs a:hover { color: var(--text); }
  .tool-head h1 { font: 700 clamp(32px, 4.4vw, 56px)/1.05 var(--f-display); letter-spacing: -0.03em; text-wrap: balance; max-width: 20ch; }
  .tool-head__lead { max-width: 60ch; margin-top: 20px; color: var(--text-2); font-size: clamp(16px, 1.3vw, 19px); }

  /* ── блок «Как пользоваться» — TL;DR + статичная SVG-схема ── */
  .how { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 72px); background: linear-gradient(180deg, rgba(101,91,250,0.04) 0%, transparent 100%); }
  .how > .wrap > * { max-width: 960px; margin-inline: auto; }
  .how h2 { font: 600 clamp(22px, 2.4vw, 32px)/1.15 var(--f-display); letter-spacing: -0.02em; margin-bottom: 14px; }
  .how__tldr { padding: 16px 20px; background: var(--bg-raised); border: 1px solid var(--line-strong); border-radius: 12px; color: var(--text-2); font-size: 15px; line-height: 1.6; margin-bottom: 24px; }
  .how__tldr b { color: var(--text); }
  .how__tldr code { background: var(--bg-app); padding: 2px 6px; border-radius: 4px; font-size: 13px; color: var(--accent-hover); }

  .scheme { display: grid; gap: 14px; }
  .scheme__wrap {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    border: 1px solid var(--line);
    border-radius: 14px;
    /* тонкий намёк, что можно прокрутить, когда схема не влезает */
    scrollbar-width: thin;
    scrollbar-color: var(--line-strong) transparent;
  }
  .scheme__svg { width: 100%; height: auto; display: block; }
  @media (max-width: 720px) {
    /* не даём SVG сжаться ниже читаемого — пользователь листает горизонтально */
    .scheme__svg { min-width: 560px; }
  }
  .scheme__caption { color: var(--text-2); font-size: 15px; line-height: 1.55; max-width: 68ch; }
  .scheme__caption code { background: var(--bg-raised); padding: 2px 6px; border-radius: 4px; font-size: 13px; color: var(--accent-hover); }

  /* ── подробная инструкция в <details> ── */
  .guide { border: 1px solid var(--line); border-radius: 12px; margin-bottom: 10px; transition: border-color 0.2s; }
  .guide[open] { border-color: var(--line-strong); }
  .guide > summary { list-style: none; cursor: pointer; padding: 16px 20px; display: flex; align-items: center; gap: 14px; }
  .guide > summary::-webkit-details-marker { display: none; }
  .guide > summary::after { content: ''; flex: none; margin-left: auto; width: 10px; height: 10px; border-right: 1.5px solid var(--text-2); border-bottom: 1.5px solid var(--text-2); transform: translateY(-2px) rotate(45deg); transition: transform 0.2s; }
  .guide[open] > summary::after { transform: translateY(2px) rotate(-135deg); }
  .guide > summary h3 { font: 600 17px/1.3 var(--f-display); margin: 0; letter-spacing: -0.01em; }
  .guide > p, .guide > ul, .guide > ol, .guide > dl { padding: 0 20px 16px; color: var(--text-2); line-height: 1.6; margin: 0; }
  .guide > p + p, .guide > p + ul, .guide > p + ol { padding-top: 10px; }
  .guide a { color: var(--accent-hover); text-decoration: underline; text-decoration-color: var(--line-strong); text-underline-offset: 3px; }
  .guide code { background: var(--bg-raised); padding: 2px 6px; border-radius: 4px; font-size: 13px; color: var(--text); }
  .guide ul, .guide ol { padding-left: 40px; }
  .guide li { margin-bottom: 6px; }
  .guide b { color: var(--text); }

  .tool-body { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 72px); }
  .tool-body > .wrap > * { max-width: 960px; margin-inline: auto; }

  .mt { display: grid; gap: 20px; }
  .matchset { display: flex; flex-wrap: wrap; gap: 20px; border: 0; padding: 0; margin: 0; }
  .matchset legend { padding: 0; font: 500 15px/1.3 var(--f-display); color: var(--text); width: 100%; margin-bottom: 2px; }
  .matchset label { display: inline-flex; gap: 10px; align-items: center; color: var(--text); font-size: 15px; }
  .matchset label code { background: var(--bg-raised); padding: 2px 6px; border-radius: 4px; font-size: 12.5px; color: var(--text-2); }
  .matchset input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--accent); }

  .io { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px; }
  @media (max-width: 860px) { .io { grid-template-columns: minmax(0, 1fr); } }

  .field { display: grid; gap: 8px; min-width: 0; }
  .field label { font: 500 15px/1.3 var(--f-display); color: var(--text); display: flex; justify-content: space-between; align-items: baseline; }
  .field__count { color: var(--text-3); font-size: 13px; font-weight: 400; font-family: var(--f-text); }
  .field textarea {
    width: 100%; padding: 12px 14px;
    background: var(--bg-raised); border: 1px solid var(--line-strong); border-radius: 10px;
    color: var(--text); font-family: ui-monospace, Menlo, monospace; font-size: 14px; line-height: 1.5;
    min-height: 260px; resize: vertical;
  }
  .field textarea:focus { outline: none; border-color: var(--accent); }
  .field textarea[readonly] { color: var(--text); background: var(--bg-app); }

  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .actions__hint { color: var(--green); font-size: 14px; min-height: 1em; }
  .actions__hint.is-error { color: var(--coral); }

  .tool-about { border-top: 1px solid var(--line); padding-block: clamp(40px, 7vh, 80px); }
  .tool-about__in { max-width: 960px; margin-inline: auto; display: grid; gap: 20px; }
  .tool-about h2 { font: 600 clamp(22px, 2.4vw, 32px)/1.15 var(--f-display); letter-spacing: -0.02em; }
  .tool-about p { color: var(--text-2); line-height: 1.6; }
  .tool-about code { background: var(--bg-raised); padding: 1px 6px; border-radius: 4px; font-size: 13px; color: var(--text); }
  .defs { display: grid; grid-template-columns: 110px 1fr; gap: 10px 20px; color: var(--text-2); }
  .defs dt { color: var(--text); }
  .defs dd { line-height: 1.5; }
  @media (max-width: 640px) { .defs { grid-template-columns: 1fr; gap: 2px 0; } .defs dt { margin-top: 10px; } }
</style>

<script>
  type MatchType = 'broad' | 'phrase' | 'exact';
  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const input = document.querySelector<HTMLTextAreaElement>('[data-input]')!;
  const output = document.querySelector<HTMLTextAreaElement>('[data-output]')!;
  const status = document.querySelector<HTMLElement>('[data-status]')!;
  const countEl = document.querySelector<HTMLElement>('[data-count]')!;

  const render = () => {
    const keys = input.value.split('\n').map((l) => l.trim()).filter(Boolean);
    const types = [...form.querySelectorAll<HTMLInputElement>('input[name=match]:checked')].map((i) => i.value as MatchType);
    const lines: string[] = [];
    for (const type of types) {
      for (const k of keys) {
        if (type === 'phrase') lines.push(`"${k}"`);
        else if (type === 'exact') lines.push(`[${k}]`);
        else lines.push(k);
      }
    }
    output.value = lines.join('\n');
    countEl.textContent = lines.length ? `${lines.length} шт.` : '';
  };

  form.addEventListener('input', render);

  document.querySelector<HTMLButtonElement>('[data-copy]')?.addEventListener('click', async () => {
    if (!output.value) { status.textContent = 'Введите ключи и выберите хотя бы один тип.'; status.classList.add('is-error'); return; }
    try {
      await navigator.clipboard.writeText(output.value);
      status.textContent = 'Скопировано.'; status.classList.remove('is-error');
    } catch {
      status.textContent = 'Браузер не дал доступа к буферу — скопируйте вручную.'; status.classList.add('is-error');
    }
  });

  document.querySelector<HTMLButtonElement>('[data-clear]')?.addEventListener('click', () => {
    input.value = ''; output.value = ''; countEl.textContent = '';
    status.textContent = ''; status.classList.remove('is-error');
    input.focus();
  });

  render();
</script>
