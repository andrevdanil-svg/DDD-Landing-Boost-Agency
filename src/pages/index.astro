---
import Page from '../layouts/Page.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Services from '../components/Services.astro';
import PlatformWall from '../components/PlatformWall.astro';
import Platform from '../components/Platform.astro';
import Results from '../components/Results.astro';
import Contact from '../components/Contact.astro';
import { localBusiness, webPage } from '../lib/schema';

const title = 'Рекламное агентство в Ташкенте — Boost! Agency, реклама в Узбекистане';
const description =
  'Boost! Agency — рекламное агентство в Ташкенте. Запускаем рекламу в интернете, на ТВ, радио и наружно по Узбекистану, разрабатываем сайты и пополняем рекламные кабинеты. Медиаплан за 48 часов.';

const schema = [
  localBusiness(),
  webPage({ title, description, url: '/' }),
];
---

<Page title={title} description={description} schema={schema}>
  <Hero />
  <Manifesto />
  <Services />
  <PlatformWall />
  <Platform />
  <Results />
  <Contact />
</Page>
