---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Platform from '../components/Platform.astro';
import Results from '../components/Results.astro';
import Contact from '../components/Contact.astro';
import MobileBar from '../components/MobileBar.astro';
import ProtoBadge from '../components/ProtoBadge.astro';
---

<Base
  title="Boost! Agency — programmatic-реклама с прозрачным кабинетом"
  description="Programmatic-агентство в Ташкенте: display, video, native, CTV и mobile на десятках бирж. Каждый показ и каждая ставка — в кабинете клиента."
>
  <Header />
  <main>
    <Hero />
    <Manifesto />
    <Platform />
    <Results />
    <Contact />
  </main>
  <MobileBar />
  <ProtoBadge />
</Base>
