---
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import Sections from '../../components/Sections.astro';
import CtaBand from '../../components/CtaBand.astro';
import { platforms, categories, nameIn, tagline } from '../../data/platforms';
import type { Section } from '../../data/pages';
import { breadcrumbs, service, webPage } from '../../lib/schema';
// кадры форматов из медиакитов: { slug, fmt — индекс формата, src, w, h, bg }
import shots from '../../data/format-shots.json';

export function getStaticPaths() {
  return platforms.map((p) => ({ params: { slug: p.slug }, props: { p } }));
}

const { p } = Astro.props;
const cat = categories[p.category];
const siblings = platforms.filter((x) => x.category === p.category && x.slug !== p.slug);

const sections: Section[] = [];
if (p.stats.length) sections.push({ type: 'stats', title: 'Аудитория в цифрах', items: p.stats });
sections.push({
  type: 'duo',
  columns: [
    { title: 'О площадке', text: p.about },
    ...(p.audience.length ? [{ title: 'Кто аудитория', items: p.audience }] : []),
  ],
});
const own = new Map(shots.filter((s) => s.slug === p.slug).map((s) => [s.fmt, s]));
if (p.formats.length) {
  sections.push(
    own.size
      ? {
          type: 'formats',
          title: 'Рекламные форматы',
          intro: 'Как форматы выглядят у площадки — примеры из её медиакита.',
          items: p.formats.map((f, i) => ({ ...f, shot: own.get(i) })),
        }
      : { type: 'grid', title: 'Рекламные форматы', items: p.formats },
  );
}
if (p.targeting.length || p.useCases.length) {
  sections.push({
    type: 'duo',
    columns: [
      ...(p.targeting.length ? [{ title: 'Таргетинги', items: p.targeting }] : []),
      ...(p.useCases.length ? [{ title: 'Для каких задач', items: p.useCases }] : []),
    ],
  });
}
if (siblings.length) {
  sections.push({
    type: 'list',
    // строчная первая буква, но аббревиатуры («SMS», «DSP») не трогаем
    title: `Ещё: ${/^.\p{Ll}/u.test(cat.title) ? cat.title[0].toLowerCase() + cat.title.slice(1) : cat.title}`,
    items: siblings.map((s) => ({ title: s.name, text: tagline(s), href: `/platforms/${s.slug}/` })),
  });
}

const url = `/platforms/${p.slug}/`;
const title = `Реклама в ${nameIn(p)} — форматы и аудитория | Boost! Agency`;
const description = `${p.lead} Размещение через Boost! Agency: медиаплан, запуск и отчёты.`;
const schema = [
  webPage({ title, description, url }),
  breadcrumbs([
    { name: 'Главная', url: '/' },
    { name: 'Рекламные площадки', url: '/platforms/' },
    { name: p.name, url },
  ]),
  service({
    name: `Реклама в ${nameIn(p)}`,
    description: p.lead,
    url,
    serviceType: `Advertising on ${p.name}`,
  }),
];
---

<Page
  title={title}
  description={description}
  schema={schema}
>
  <PageHero
    hero={{
      back: { href: '/platforms/', label: 'Все площадки' },
      title: p.name,
      lead: p.lead,
      meta: `${cat.title} · ${p.geo}`,
      cta: true,
      ctaLabel: 'Запросить медиакит',
    }}
  />
  <Sections sections={sections} />
  <CtaBand
    title={`Запустим рекламу в ${nameIn(p)}?`}
    text="Стоимость, минимальный бюджет и доступность форматов зависят от задачи и сезона. Пришлём медиакит и расчёт под ваш бриф."
    primary="Запросить медиакит и условия"
    secondary={{ href: '/contact/', label: 'Оставить заявку' }}
  />
</Page>
