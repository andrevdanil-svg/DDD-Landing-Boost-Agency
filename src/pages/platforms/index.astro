---
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import Sections from '../../components/Sections.astro';
import CtaBand from '../../components/CtaBand.astro';
import { platforms, categories, categoryOrder, tagline } from '../../data/platforms';
import type { Section } from '../../data/pages';
import { breadcrumbs, webPage } from '../../lib/schema';

// 21 площадка, 23 площадки, 25 площадок
const plural = (n: number, [one, few, many]: [string, string, string]) =>
  n % 10 === 1 && n % 100 !== 11 ? one : n % 10 >= 2 && n % 10 <= 4 && (n % 100 < 12 || n % 100 > 14) ? few : many;

const sections: Section[] = categoryOrder
  .map((c) => ({ c, items: platforms.filter((p) => p.category === c) }))
  .filter((g) => g.items.length)
  .map((g) => ({
    type: 'list' as const,
    id: g.c,
    title: categories[g.c].title,
    intro: categories[g.c].text,
    items: g.items.map((p) => ({ title: p.name, text: tagline(p), href: `/platforms/${p.slug}/` })),
  }));

const title = 'Рекламные площадки Узбекистана — 21 площадка через Boost! Agency';
const description =
  'Рекламные площадки Узбекистана: Uzum, Korzinka Go, Yandex Lavka, Yandex Go, Uzum Bank, iTV, Megogo, Spotify, Eskimi, Emaktab, Oxymed, SMS Promo и другие. Маркетплейсы, приложения, стриминг, DSP и отраслевые аудитории — медиапланы и запуск через Boost! Agency.';
const schema = [
  webPage({ title, description, url: '/platforms/' }),
  breadcrumbs([
    { name: 'Главная', url: '/' },
    { name: 'Рекламные площадки', url: '/platforms/' },
  ]),
  {
    '@type': 'ItemList',
    name: 'Рекламные площадки Boost! Agency',
    numberOfItems: platforms.length,
    itemListElement: platforms.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: new URL(`/platforms/${p.slug}/`, 'https://boostagency.uz').href,
      name: p.name,
    })),
  },
];
---

<Page
  title={title}
  description={description}
  schema={schema}
>
  <PageHero
    hero={{
      title: 'Рекламные площадки Узбекистана',
      lead: `${platforms.length} ${plural(platforms.length, ['площадка', 'площадки', 'площадок'])} в Узбекистане: маркетплейсы (Uzum, Korzinka Go, Yandex Lavka), приложения и сервисы, онлайн-кинотеатры и музыка, рекламные сети и DSP, отраслевые аудитории и SMS. Соберём медиаплан из нескольких площадок и запустим кампанию по одному договору.`,
    }}
  />
  <Sections sections={sections} />
  <CtaBand
    title="Не знаете, какая площадка подойдёт? Подберём под вашу аудиторию"
    secondary={{ href: '/contact/', label: 'Оставить заявку' }}
  />
</Page>
