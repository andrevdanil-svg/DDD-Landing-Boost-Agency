---
import Page from '../../layouts/Page.astro';
import PageHero from '../../components/PageHero.astro';
import Sections from '../../components/Sections.astro';
import CtaBand from '../../components/CtaBand.astro';
import { platforms, categories, categoryOrder } from '../../data/platforms';
import type { Section } from '../../data/pages';

const sections: Section[] = categoryOrder
  .map((c) => ({ c, items: platforms.filter((p) => p.category === c) }))
  .filter((g) => g.items.length)
  .map((g) => ({
    type: 'list' as const,
    id: g.c,
    title: categories[g.c].title,
    intro: categories[g.c].text,
    items: g.items.map((p) => ({ title: p.name, text: p.lead, href: `/platforms/${p.slug}/` })),
  }));
---

<Page
  title="Рекламные площадки — Boost! Agency"
  description="Реклама в крупных сервисах и медиа: маркетплейсы и доставка, приложения, онлайн-кинотеатры и стриминг, рекламные сети, отраслевые аудитории и SMS. Медиапланы и запуск через Boost! Agency."
>
  <PageHero
    hero={{
      title: 'Рекламные площадки',
      lead: `${platforms.length} площадок: маркетплейсы и доставка, приложения, онлайн-кинотеатры и музыка, рекламные сети, отраслевые аудитории и SMS. Соберём медиаплан из нескольких площадок и запустим кампанию по одному договору.`,
    }}
  />
  <Sections sections={sections} />
  <CtaBand
    title="Не знаете, какая площадка подойдёт? Подберём под вашу аудиторию"
    secondary={{ href: '/contact/', label: 'Оставить заявку' }}
  />
</Page>
