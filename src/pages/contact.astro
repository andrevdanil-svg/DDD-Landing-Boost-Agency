---
import Page from '../layouts/Page.astro';
import Contact from '../components/Contact.astro';
import { breadcrumbs, localBusiness, webPage } from '../lib/schema';

const title = 'Контакты Boost! Agency — рекламное агентство в Ташкенте';
const description =
  'Контакты рекламного агентства Boost! в Ташкенте. Расскажите о задаче — вернём медиаплан за 48 часов. Telegram или короткая заявка: имя, телефон или Telegram, бюджет.';

// На странице контактов — LocalBusiness во всех деталях.
const schema = [
  webPage({ title, description, url: '/contact/' }),
  breadcrumbs([
    { name: 'Главная', url: '/' },
    { name: 'Контакты', url: '/contact/' },
  ]),
  localBusiness(),
];
---

<Page title={title} description={description} schema={schema}>
  <Contact heading="h1" />
</Page>
