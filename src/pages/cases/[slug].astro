---
import Page from '../../layouts/Page.astro';
import CtaBand from '../../components/CtaBand.astro';
import Arrow from '../../components/Arrow.astro';
import { cases } from '../../data/cases';
import { typo } from '../../lib/typo';

export function getStaticPaths() {
  return cases.map((c, i) => ({
    params: { slug: c.slug },
    props: { c, next: cases[(i + 1) % cases.length] },
  }));
}

const { c, next } = Astro.props;
---

<Page title={c.seoTitle} description={c.seoDescription}>
  <section class="ch">
    <div class="wrap">
      <a class="back" href="/cases/"><Arrow /> Все кейсы</a>
      <h1 class="ch__title">{typo(c.title)}</h1>
      <p class="ch__lead">{typo(c.lead)}</p>
      <p class="ch__meta">{c.meta} · {c.client}</p>
    </div>
  </section>

  <section class="cs" aria-label="Результат">
    <ul class="wrap cs__grid">
      {
        c.stats.map((s) => (
          <li>
            <b>{s.value}</b>
            <span class="cs__label">{s.label}</span>
            <span class="cs__sub">{typo(s.sub)}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="cb">
    <div class="wrap cb__grid">
      <div class="cb__task">
        <h2>{typo(c.headline)}</h2>
        <p>{typo(c.description)}</p>
      </div>
      <div class="cb__steps">
        <h2>{typo(c.stepsTitle)}</h2>
        <ol>
          {
            c.steps.map((s, i) => (
              <li>
                <span class="cb__n" aria-hidden="true">
                  {i + 1}
                </span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{typo(s.text)}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <CtaBand title={c.ctaTitle} primary={c.ctaButton} secondary={{ href: '/contact/', label: 'Медиаплан за 48 часов' }} />

  <a class="next" href={`/cases/${next.slug}/`}>
    <span class="wrap next__in">
      <span class="next__k">Следующий кейс</span>
      <span class="next__title">{typo(next.title)}</span>
      <span class="next__go" aria-hidden="true"><Arrow /></span>
    </span>
  </a>
</Page>

<style>
  /* шапка кейса */
  .ch { padding-block: clamp(40px, 8vh, 96px) clamp(48px, 9vh, 104px); }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text-2);
    transition: color 0.2s;
  }
  .back :global(svg) { width: 16px; height: 16px; transform: rotate(180deg); }
  .back:hover { color: var(--text); }
  .ch__title {
    max-width: 15em;
    margin-top: clamp(28px, 5vh, 56px);
    font: 700 clamp(40px, 6.4vw, 96px)/0.98 var(--f-display);
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .ch__lead { max-width: 44ch; margin-top: 28px; color: var(--text-2); font-size: clamp(17px, 1.4vw, 20px); }
  .ch__meta { margin-top: 20px; color: var(--text-3); }

  /* цифры результата — на фиолетовом, как блок кейсов на главной */
  .cs { background: var(--accent); color: #fff; }
  .cs__grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .cs__grid li { display: grid; align-content: start; gap: 6px; padding: clamp(28px, 6vh, 64px) clamp(16px, 2.2vw, 32px); }
  .cs__grid li:first-child { padding-left: 0; }
  .cs__grid li + li { border-left: 1px solid rgb(255 255 255 / 0.3); }
  .cs__grid b { font: 800 clamp(48px, 7vw, 112px)/1 var(--f-display); letter-spacing: -0.05em; font-variant-numeric: tabular-nums; }
  .cs__label { margin-top: 8px; font: 600 clamp(16px, 1.3vw, 19px)/1.3 var(--f-display); }
  .cs__sub { color: rgb(255 255 255 / 0.85); }

  /* задача и шаги */
  .cb { padding-block: clamp(80px, 14vh, 160px); }
  .cb__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(40px, 6vw, 96px); }
  .cb h2 { font: 700 clamp(28px, 3vw, 44px)/1.05 var(--f-display); letter-spacing: -0.03em; text-wrap: balance; }
  .cb__task p { margin-top: 24px; color: var(--text-2); font-size: 18px; max-width: 46ch; }
  .cb__steps ol { list-style: none; padding: 0; margin-top: 32px; border-bottom: 1px solid var(--line); }
  .cb__steps li { display: grid; grid-template-columns: 56px minmax(0, 1fr); padding-block: 24px; border-top: 1px solid var(--line); }
  .cb__n { font: 700 24px/1.2 var(--f-display); color: var(--text-3); font-variant-numeric: tabular-nums; }
  .cb__steps h3 { font: 600 21px/1.25 var(--f-display); letter-spacing: -0.015em; }
  .cb__steps p { margin-top: 8px; color: var(--text-2); }

  /* следующий кейс */
  .next { display: block; border-top: 1px solid var(--line); transition: background-color 0.3s var(--ease); }
  .next:hover { background: rgb(255 255 255 / 0.03); }
  .next__in {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 8px 24px;
    align-items: center;
    padding-block: clamp(40px, 8vh, 80px);
  }
  .next__k { grid-column: 1; color: var(--text-2); }
  .next__title { grid-column: 1; font: 600 clamp(26px, 3.4vw, 52px)/1.1 var(--f-display); letter-spacing: -0.03em; transition: transform 0.5s var(--ease); }
  .next__go {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    transition: background-color 0.3s var(--ease), border-color 0.3s var(--ease);
  }
  .next__go :global(svg) { width: 20px; height: 20px; }
  .next:hover .next__title { transform: translateX(10px); }
  .next:hover .next__go { background: var(--accent); border-color: var(--accent); }

  @media (max-width: 900px) {
    .cb__grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 640px) {
    .cs__grid { grid-template-columns: minmax(0, 1fr); }
    .cs__grid li, .cs__grid li:first-child { padding: 24px 0; }
    .cs__grid li + li { border-left: 0; border-top: 1px solid rgb(255 255 255 / 0.3); }
    .cb__steps li { grid-template-columns: 40px minmax(0, 1fr); }
    .next__go { width: 44px; height: 44px; }
  }
</style>
